          "type": "select",
          "source": "suppliers.json",
          "required": true
        },
        {
          "field": "Currency",
          "label": "Currency",
          "type": "select",
          "source": "currencies.json",
          "required": true
        },
        {
          "field": "ExRate",
          "label": "Ex Rate",
          "type": "number",
          "step": "0.000001",
          "min": "0",
          "required": true
        },
        {
          "field": "AttentionPerson",
          "label": "Attention Person",
          "type": "select",
          "source": "attention-persons.json",
          "required": false
        },
        {
          "field": "PaymentTerms",
          "label": "Payment Terms",
          "type": "select",
          "source": "payment-terms.json",
          "required": false
        },
        {
          "field": "Comments",
          "label": "Comments",
          "type": "textarea",
          "maxlength": 200,
          "required": false
        }
      ]
    }
  ],
  "grids": [
    {
      "id": "attendance",
      "title": "Attendance",
      "subtitle": "Employee Attendance and Billing Details",
      "property": "Attendance",
      "allowAdd": true,
      "allowDelete": true,
      "allowMultiDelete": true,
      "selection": {
        "enabled": true,
        "type": "checkbox",
        "selectAll": true
      },
      "columns": [
        {
          "field": "StartDate",
          "label": "Start Date",
          "type": "date",
          "required": true
        },
        {
          "field": "EndDate",
          "label": "End Date",
          "type": "date",
          "required": true
        },
        {
          "field": "EmpCode",
          "label": "EmpCode",
          "type": "select",
          "source": "employees.json",
          "required": true
        },
        {
          "field": "EmpName",
          "label": "EmpName",
          "type": "text",
          "readonly": true
        },
        {
          "field": "MainFrameAgreement",
          "label": "Main Frame Agreement",
          "type": "select",
          "source": "main-frame-agreements.json",
          "required": true
        },
        {
          "field": "CallOff",
          "label": "Call Off",
          "type": "select",
          "source": "call-offs.json",
          "required": true,
          "filterBy": "MainFrameAgreement"
        },
        {
          "field": "ContractType",
          "label": "Contract Type",
          "type": "select",
          "source": "contract-types.json",
          "required": true
        },
        {
          "field": "BillingHeads",
          "label": "Billing Heads",
          "type": "select",
          "source": "billing-heads.json",
          "required": true
        },
        {
          "field": "DenominationType",
          "label": "Denomination Type",
          "type": "select",
          "source": "denomination-types.json",
          "required": true
        },
        {
          "field": "Qty",
          "label": "Qty",
          "type": "number",
          "step": "0.001",
          "required": true
        },
        {
          "field": "Rate",
          "label": "Rate",
          "type": "number",
          "step": "0.001",
          "required": true
        },
        {
          "field": "Amount",
          "label": "Amount",
          "type": "number",
          "step": "0.001",
          "readonly": true,
          "calculation": "Qty * Rate"
        },
        {
          "field": "TaxPercent",
          "label": "Tax %",
          "type": "number",
          "step": "0.01",
          "required": false
        },
        {
          "field": "TaxAmount",
          "label": "Tax Amount",
          "type": "number",
          "step": "0.001",
          "readonly": true,
          "calculation": "Amount * TaxPercent / 100"
        },
        {
          "field": "NetAmount",
          "label": "Net Amount",
          "type": "number",
          "step": "0.001",
          "readonly": true,
          "calculation": "Amount + TaxAmount"
        },
        {
          "field": "PONumber",
          "label": "PO Number",
          "type": "text",
          "required": false
        },
        {
          "field": "PODate",
          "label": "PO Date",
          "type": "date",
          "required": false
        },
        {
          "field": "Remarks",
          "label": "Remarks",
          "type": "text",
          "maxlength": 250,
          "required": false
        }
      ],
      "defaultRows": []
    }
  ],
  "calculations": [
    {
      "target": "Amount",
      "expression": "Qty * Rate",
      "triggerFields": [
        "Qty",
        "Rate"
      ]
    },
    {
      "target": "TaxAmount",
      "expression": "Amount * TaxPercent / 100",
      "triggerFields": [
        "Amount",
        "TaxPercent"
      ]
    },
    {
      "target": "NetAmount",
      "expression": "Amount + TaxAmount",
      "triggerFields": [
        "Amount",
        "TaxAmount"
      ]
    }
  ],
