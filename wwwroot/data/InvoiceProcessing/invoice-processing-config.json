  "headerFields": [
    {
      "id": "batchNo",
      "label": "Batch No",
      "type": "text",
      "dataType": "nvarchar",
      "maxLength": 60,
      "required": true
    },
    {
      "id": "date",
      "label": "Date",
      "type": "date",
      "required": true
    },
    {
      "id": "postDate",
      "label": "Post Date",
      "type": "datetime-local",
      "required": true,
      "readonly": true,
      "defaultValue": "currentDateTime"
    },
    {
      "id": "clientId",
      "label": "Client",
      "type": "select",
      "source": "clients.json",
      "valueField": "id",
      "textField": "name",
      "required": true
    },
    {
      "id": "mainFrameAgreementId",
      "label": "Main Frame Agreement",
      "type": "select",
      "source": "main-frame-agreements.json",
      "valueField": "id",
      "textField": "name",
      "dependsOn": "clientId",
      "required": true
    },
    {
      "id": "payMonth",
      "label": "PayMonth",
      "type": "select",
      "options": [
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December"
      ],
      "required": true
    },
    {
      "id": "invoiceType",
      "label": "Invoice Type",
      "type": "select",
      "options": [
        "Single Emp Invoice",
        "Multiple Emp Invoice"
      ],
      "required": true
    },
    {
      "id": "timeSheetType",
      "label": "TimeSheet Type",
      "type": "select",
      "options": [
        "Attendance & OT",
        "OT Only"
      ],
      "required": true
    },
    {
      "id": "departmentIds",
      "label": "Department",
      "type": "multiselect",
      "source": "departments.json",
      "valueField": "id",
      "textField": "name",
      "purpose": "filter"
    },
    {
      "id": "comments",
      "label": "Comments",
      "type": "textarea",
      "dataType": "nvarchar",
      "maxLength": 200
    }
  ],
  "grid": {
    "id": "attendanceGrid",
    "title": "Attendance",
    "dataSource": "attendanceRows",
    "selection": {
      "enabled": true,
      "checkbox": true,
      "selectAll": true,
      "allowMultiple": true
    },
    "toolbar": [
      {
        "id": "btnRemoveSelected",
        "text": "Remove Selected",
        "icon": "fa-trash",
        "style": "danger",
        "action": "removeSelected"
      }
    ],
    "columns": [
      {
        "field": "payMonth",
