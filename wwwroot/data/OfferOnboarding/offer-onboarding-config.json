  "sections": [
    {
      "id": "documentInformation",
      "title": "Document Information",
      "fields": [
        {
          "field": "DocNo",
          "label": "Doc No",
          "type": "text",
          "maxlength": 60,
          "readonly": true,
          "required": false
        },
        {
          "field": "Date",
          "label": "Date",
          "type": "date",
          "required": true
        },
        {
          "field": "PostDate",
          "label": "PostDate",
          "type": "datetime-local",
          "required": false
        },
        {
          "field": "MainFrameAgreement",
          "label": "Main Frame Agreement",
          "type": "select",
          "source": "main-frame-agreements.json",
          "required": true
        },
        {
          "field": "Client",
          "label": "Client",
          "type": "select",
          "source": "clients.json",
          "readonly": true,
          "autoFill": {
            "trigger": "MainFrameAgreement",
            "endpoint": "ClientByAgreement"
          }
        },
        {
          "field": "CallOff",
          "label": "Call Off",
          "type": "select",
          "source": "call-offs.json",
          "required": true,
          "filterBy": "MainFrameAgreement"
        },
        {
          "field": "OfferNo",
          "label": "Offer No",
          "type": "select",
          "source": "offers.json",
          "required": true,
          "filterBy": "CallOff"
        },
        {
          "field": "CallOffType",
          "label": "Call Off Type",
          "type": "select",
          "source": "call-off-types.json",
          "readonly": true,
          "autoFill": {
            "trigger": "OfferNo",
            "endpoint": "OfferDetails"
          }
        },
        {
          "field": "Candidate",
          "label": "Candidate",
          "type": "select",
          "source": "candidates.json",
          "readonly": true,
          "autoFill": {
            "trigger": "OfferNo",
            "endpoint": "OfferDetails"
          }
        },
        {
          "field": "Employee",
          "label": "Employee",
          "type": "select",
          "source": "employees.json",
          "readonly": true,
          "autoFill": {
            "trigger": "OfferNo",
            "endpoint": "OfferDetails"
          }
        },
        {
          "field": "RevisedOn",
          "label": "Revised On",
          "type": "date",
          "required": false
        },
        {
          "field": "ApplicableFrom",
          "label": "Applicable From",
          "type": "date",
          "required": false
        }
      ]
    }
  ],
  "grids": [
    {
      "id": "candidateEmployeeComparison",
      "title": "Candidate / Employee Details",
      "subtitle": "Candidate and Employee Information",
      "property": "Comparison",
      "columns": [
        {
          "field": "CandidateField",
          "label": "Candidate Field",
          "type": "text",
          "readonly": true
        },
        {
          "field": "CandidateValue",
          "label": "Value",
          "type": "text",
          "readonly": true
        },
        {
          "field": "EmployeeField",
          "label": "Employee Field",
          "type": "text",
          "readonly": true
        },
        {
          "field": "EmployeeValue",
          "label": "Value",
          "type": "text",
          "readonly": true
        }
      ],
      "defaultRows": [
        {
          "candidateField": "Name",
          "candidateValue": "",
          "employeeField": "Name",
          "employeeValue": ""
        },
        {
          "candidateField": "DOB",
          "candidateValue": "",
          "employeeField": "DOB",
          "employeeValue": ""
        }
      ]
    }
  ]
}
