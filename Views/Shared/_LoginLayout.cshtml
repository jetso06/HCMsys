@model HCMSys.Models.vmSer_Users

@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>VSMS | Log in</title>
    <!-- Tell the browser to be responsive to screen width -->
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <!-- Bootstrap 3.3.7 -->
    <link rel="stylesheet" href="~/bower_components/bootstrap/dist/css/bootstrap.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/bower_components/font-awesome/css/font-awesome.min.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="~/bower_components/Ionicons/css/ionicons.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/dist/css/FocusHCM.min.css">
    <!-- iCheck -->
    <link rel="stylesheet" href="~/plugins/iCheck/square/blue.css">
    <link rel="stylesheet" href="~/dist/css/GA.css">
    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
    <!-- Google Font -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700,300italic,400italic,600italic">
    <style>
        body {
            background-image: url('@Url.Content("~/dist/img/bg.jpg")');
            background-color: darkgray;
            height: 100%; /* Center and scale the image nicely */
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-size: 100% 100%;
        }
        div.b {
            position: absolute;
            left: -10px;
            width: 100px;
            height: 120px;
        }
        div.a {
            position: relative;
            width: 400px;
            height: 200px;
            top: 200px;
        }
    </style>
    <script src="~/bower_components/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap 3.3.7 -->
    <script src="~/bower_components/bootstrap/dist/js/bootstrap.min.js"></script>
    <!-- iCheck -->
    <script src="~/plugins/iCheck/icheck.min.js"></script>

</head>
<body    >
    @using (Html.BeginForm("Index", "Home", FormMethod.Post ))
    {
        <div class="a">
            <div>
                <div class="login-box">
                    <div class="login-logo">
                        <b></b>
                    </div>
                    <!--/.login-logo-->
                    <div class="login-box-body">
                        <div class="login-logo">
                            <img src="~/dist/img/icon1.png" alt="Focus Icon">
                        </div>
                        <p class="login-box-msg" style="font-family:Copperplate Gothic;font-size:18px;"><strong>FOCUS</strong> SERVICE MANAGEMENT SYSTEM</p>
                        <div class="form-group has-feedback">
                            @Html.TextBoxFor(m => m.sLoginName, new Dictionary<string, object>() { { "style", "width:275px;" } })
                            <span class="glyphicon glyphicon-user form-control-feedback"></span>
                            @Html.ValidationMessageFor(m => m.sLoginName, "", new { @class = "error" })
                        </div>
                        <div class="form-group has-feedback">
                            @Html.PasswordFor(m => m.sPassword, new Dictionary<string, object>() { { "style", "width:275px;" } })
                            <span class="glyphicon glyphicon-lock form-control-feedback"></span>
                            @Html.ValidationMessageFor(m => m.sPassword, "", new { @class = "error" })
                        </div>
                        <div class="row" >
                            <div class="col-xs-8">
           
                            </div>
                            <div class="col-xs-4">
                                <button type="submit" class="btn btn-primary btn-block btn-flat" id="btnSignIn" style="align-items :center  ">Sign In</button>
                            </div>
                        </div>
                        <div class="row">
                            @*<ul >
                                <li class="disabled ">

                                </li>
                                </ul>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    </body>
</html>
