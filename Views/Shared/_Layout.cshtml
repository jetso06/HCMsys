    <script>
        var display = setInterval(function () { Time() }, 0);
        $('[data-widget="pushmenu"]').on('click', function () {
            $('[data-widget="pushmenu"]').PushMenu("toggle");
        });
        $(document).ready(function () {
            // Show scroll-to-top button after scrolling down 100px
            $(window).scroll(function () {
                if ($(this).scrollTop() > 100) {
                    $('.scroll-to-top').fadeIn();
                } else {
                    $('.scroll-to-top').fadeOut();
                }
            });

            // Smooth scroll to top on click
            $('.scroll-to-top').click(function () {
                $('html, body').animate({ scrollTop: 0 }, 600);
                return false;
            });
        });

        function Time() {
            var _date = new Date();
            var _time = _date.toLocaleDateString("es-CL") + ' ' + _date.toLocaleTimeString().toUpperCase();
 
            document.getElementById("eg").innerHTML = _time;
            // $('#eg').val(_time);
        }
        document.addEventListener("DOMContentLoaded", function () {
 

            function getTime() {
                return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            }

 
 
        });
    </script>
 
    <style>
        #eg {
            font-family: Segoe UI;
            font-size: 24px;
            color: white;
        }

        ;
        #hd {
            font-family: Segoe UI;
            font-size: 24px;
            color: white;
        };
        html {
    font-size: 14px; /* Default is usually 16px */
}
