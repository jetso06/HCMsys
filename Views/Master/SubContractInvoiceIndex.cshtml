@using System.Text.Json.Nodes
@using System.Globalization

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var config = ViewData["Config"] as JsonObject ?? new JsonObject();
    var page = config["page"] as JsonObject ?? new JsonObject();
    var index = config["index"] as JsonObject ?? new JsonObject();

    var buttons = config["buttons"]?["form"] as JsonArray ?? new JsonArray();
    var columns = index["columns"] as JsonArray ?? new JsonArray();
    var rows = ViewData["Rows"] as JsonArray ?? new JsonArray();

    var heading = index["heading"]?.ToString() ?? "Sub Contract Invoice List";
    var title = page["title"]?.ToString() ?? "Sub Contract Invoice";
    var pageIcon = page["icon"]?.ToString() ?? "fa-file-invoice-dollar";

    ViewData["Title"] = title;

    string GetValue(JsonObject? obj, string field)
    {
        if (obj == null) return "";

        foreach (var property in obj)
        {
            if (string.Equals(property.Key, field,
                StringComparison.OrdinalIgnoreCase))
            {
                return property.Value?.ToString() ?? "";
            }
        }

        return "";
    }

    string FormatValue(string field, string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";

        if (field.Contains("DateTime", StringComparison.OrdinalIgnoreCase)
            && DateTime.TryParse(value, out var dateTime))
            return dateTime.ToString("dd-MM-yyyy HH:mm");

        if (field.Contains("Date", StringComparison.OrdinalIgnoreCase)
            && DateTime.TryParse(value, out var date))
            return date.ToString("dd-MM-yyyy");

        return value;
    }
}

<div class="container-fluid candidate-index">

    <!-- MASTER TOOLBAR -->
    <div class="card ci-card ci-toolbar-card">
        <div class="card-header ci-toolbar">
            <h6 class="ci-title">
                <i class="fas @pageIcon"></i>
                @title
                <span class="ci-module-badge">SUB CONTRACT INVOICE</span>
            </h6>

            <div class="ci-buttons">
                @foreach (var button in buttons.OfType<JsonObject>())
                {
                    if (button["visible"]?.GetValue<bool>() != true)
                        continue;

                    var action = button["action"]?.ToString()?.ToLowerInvariant() ?? "";
                    var label = button["label"]?.ToString() ?? "";
                    var icon = button["icon"]?.ToString() ?? "";
                    var style = button["style"]?.ToString() ?? "secondary";

                    var enabled = action == "new" || action == "print" || action == "close";

                    <button type="button"
                            class="btn btn-@style btn-sm shadow-sm"
                            data-action="@action"
                            disabled="@(!enabled)">
                        <i class="fas @icon"></i> @label
                    </button>
                }
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["Error"]</div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row ci-summary">

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-primary">
                <div class="card-body">
                    <div class="ci-summary-label">Total Records</div>
                    <div class="ci-summary-value">@rows.Count</div>
                    <i class="fas fa-layer-group ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-info">
                <div class="card-body">
                    <div class="ci-summary-label">Displayed Records</div>
                    <div class="ci-summary-value" id="ciDisplayed">@rows.Count</div>
                    <i class="fas fa-list ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-success">
                <div class="card-body">
                    <div class="ci-summary-label">Selected Record</div>
                    <div class="ci-summary-value" id="ciSelected">None</div>
                    <i class="fas fa-file-alt ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-warning">
                <div class="card-body">
                    <div class="ci-summary-label">Module</div>
                    <div class="ci-summary-module">Sub Contract Invoice</div>
                    <i class="fas fa-file-invoice-dollar ci-summary-icon"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- RECORDS CARD -->
    <div class="card ci-card ci-records-card">

        <div class="card-header ci-records-header">
            <h6>
                <i class="fas fa-table"></i>
                @heading
            </h6>

            <span class="badge badge-primary" id="ciRecordCount">
                @rows.Count Records
            </span>
        </div>

        <div class="card-body">

            <!-- TABLE TOOLS -->
            <div class="ci-table-tools">
                <div class="ci-page-size">
                    <span>Show</span>
                    <select id="ciPageSize" class="form-control form-control-sm">
                        <option value="20">20</option>
                        <option value="35">35</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>entries</span>
                </div>

                <input type="text"
                       id="ciSearch"
                       class="form-control form-control-sm ci-search"
                       placeholder="Search Sub Contract Invoice records..." />
            </div>

            <!-- RECORD TABLE -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover"
                       id="ciTable">

                    <thead>
                        <tr>
                            <th class="ci-control-column">
                                <div class="ci-select-header">
                                    <span>Select</span>
                                    <input type="checkbox" id="ciSelectAll" />
                                </div>
                            </th>

                            <th class="ci-action-column">Action</th>

                            @foreach (var column in columns.OfType<JsonObject>())
                            {
                                if (column["visible"]?.GetValue<bool>() == false)
                                    continue;

                                <th>
                                    @column["label"]

                                    @if (!string.IsNullOrWhiteSpace(column["tooltip"]?.ToString()))
                                    {
                                        <i class="fas fa-info-circle ml-1"
                                           title="@column["tooltip"]"></i>
                                    }
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody id="ciTableBody">
                        @if (rows.Count > 0)
                        {
                            foreach (var row in rows.OfType<JsonObject>())
                            {
                                var id = GetValue(row, "Id");

                                <tr data-id="@id">

                                    <td class="text-center ci-control-column">
                                        <input type="checkbox"
                                               class="ci-checkbox"
                                               value="@id" />
                                    </td>

                                    <td class="text-center ci-action-column">
                                        <button type="button"
                                                class="ci-row-edit"
                                                title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="ci-row-delete"
                                                title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>

                                    @foreach (var column in columns.OfType<JsonObject>())
                                    {
                                        if (column["visible"]?.GetValue<bool>() == false)
                                            continue;

                                        var field = column["field"]?.ToString() ?? "";
                                        var value = FormatValue(field, GetValue(row, field));

                                        if (field.Equals("Ave", StringComparison.OrdinalIgnoreCase))
                                        {
                                            value = value switch
                                            {
                                                "Approved" => "Y",
                                                "Rejected" => "N",
                                                "Pending" => "P",
                                                _ => value
                                            };
                                        }

                                        if (field.Equals("AppSt", StringComparison.OrdinalIgnoreCase))
                                        {
                                            value = value switch
                                            {
                                                "Pending" => "P",
                                                "Approved" => "A",
                                                "Rejected" => "R",
                                                "Posted" => "P",
                                                "Under Review" => "U",
                                                _ => value
                                            };
                                        }

                                        <td title="@GetValue(row, field)">
                                            @if (field.Equals("Status", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="ci-status">@value</span>
                                            }
                                            else
                                            {
                                                @value
                                            }
                                        </td>
                                    }

                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="ci-no-data">
                                <td colspan="@(columns.Count + 2)" class="ci-empty">
                                    No Sub Contract Invoice records found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <!-- PAGINATION -->
            <div class="ci-table-footer">
                <span id="ciShowing">Showing 0 records</span>

                <div class="ci-pagination">
                    <button class="btn btn-light btn-sm"
                            id="ciPrevious" type="button">
                        Previous
                    </button>

                    <span id="ciPageInfo">0 / 0</span>

                    <button class="btn btn-light btn-sm"
                            id="ciNext" type="button">
                        Next
                    </button>
                </div>
            </div>

        </div>
    </div>
</div>

<form id="ciAntiForgery" hidden>
    @Html.AntiForgeryToken()
</form>

