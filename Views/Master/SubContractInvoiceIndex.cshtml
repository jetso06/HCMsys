<script>
    (() => {
        const body = document.getElementById("ciTableBody");
        const searchInput = document.getElementById("ciSearch");
        const pageSizeInput = document.getElementById("ciPageSize");
        const selectAllCheckbox = document.getElementById("ciSelectAll");

        const rows = Array.from(body.querySelectorAll("tr[data-id]"));

        let selectedId = null;
        let filteredRows = rows.slice();
        let currentPage = 1;

        function updateSelection() {
            const selected = body.querySelectorAll(".ci-checkbox:checked");

            const selectedInFiltered = filteredRows.filter(row =>
                row.querySelector(".ci-checkbox")?.checked
            ).length;

            selectAllCheckbox.checked =
                filteredRows.length > 0 &&
                selectedInFiltered === filteredRows.length;

            selectAllCheckbox.indeterminate =
                selectedInFiltered > 0 &&
                selectedInFiltered < filteredRows.length;

            selectedId = selected.length === 1 ? selected[0].value : null;

            const names = Array.from(selected).map(checkbox => {
                const row = checkbox.closest("tr");
                return row.cells[2]?.textContent.trim() || checkbox.value;
            });

            rows.forEach(row => {
                row.classList.toggle(
                    "selected",
                    row.querySelector(".ci-checkbox")?.checked === true
                );
            });

            document.getElementById("ciSelected").textContent =
                names.length ? names.join(", ") : "None";

            document.querySelector('[data-action="edit"]')
                ?.toggleAttribute("disabled", !selectedId);

            document.querySelector('[data-action="clone"]')
                ?.toggleAttribute("disabled", !selectedId);

            document.querySelector('[data-action="saveas"]')
                ?.toggleAttribute("disabled", !selectedId);

            document.querySelector('[data-action="revisions"]')
                ?.toggleAttribute("disabled", !selectedId);

            document.querySelector('[data-action="delete"]')
                ?.toggleAttribute("disabled", selected.length === 0);
        }

        function renderRows() {
            const pageSize = Number(pageSizeInput.value);
            const totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));

            currentPage = Math.min(currentPage, totalPages);

            rows.forEach(row => row.hidden = true);

            const start = (currentPage - 1) * pageSize;
            const visibleRows = filteredRows.slice(start, start + pageSize);

            visibleRows.forEach(row => row.hidden = false);

            document.getElementById("ciDisplayed").textContent = filteredRows.length;
            document.getElementById("ciRecordCount").textContent =
                `${filteredRows.length} Records`;

            document.getElementById("ciShowing").textContent =
                filteredRows.length
                    ? `Showing ${start + 1} to ${start + visibleRows.length} of ${filteredRows.length} records`
                    : "Showing 0 records";

            document.getElementById("ciPageInfo").textContent =
                filteredRows.length ? `${currentPage} / ${totalPages}` : "0 / 0";

            document.getElementById("ciPrevious").disabled = currentPage <= 1;
            document.getElementById("ciNext").disabled = currentPage >= totalPages;

            updateSelection();
        }

        function filterRows() {
            const query = searchInput.value.trim().toLowerCase();

            filteredRows = rows.filter(row =>
                row.innerText.toLowerCase().includes(query)
            );

            currentPage = 1;
            renderRows();
        }

        function editRecord(id) {
            if (!id) {
                alert("Please select an invoice.");
                return;
            }

            window.location.href =
                "/Master/SubContractInvoice/Form?id=" + encodeURIComponent(id);
        }

        function deleteRecord(id) {
            if (!id) {
                alert("Please select an invoice.");
                return;
            }

            if (!confirm("Are you sure you want to delete this invoice?"))
                return;

            const form = document.createElement("form");
            form.method = "POST";
            form.action =
                "/Master/SubContractInvoice/Delete/" + encodeURIComponent(id);

            const token = document.querySelector(
                '#ciAntiForgery input[name="__RequestVerificationToken"]'
            );

            if (token) {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "__RequestVerificationToken";
                input.value = token.value;
                form.appendChild(input);
            }

            document.body.appendChild(form);
            form.submit();
        }

        selectAllCheckbox.addEventListener("change", function () {
            filteredRows.forEach(row => {
                const checkbox = row.querySelector(".ci-checkbox");
                if (checkbox) checkbox.checked = this.checked;
            });

            updateSelection();
        });

        rows.forEach(row => {
            row.querySelector(".ci-checkbox")
                ?.addEventListener("change", updateSelection);

            row.addEventListener("click", event => {
                if (event.target.closest(
                    ".ci-row-edit, .ci-row-delete, .ci-checkbox"
                )) return;

                const checkbox = row.querySelector(".ci-checkbox");
                checkbox.checked = !checkbox.checked;
                updateSelection();
            });
        });

        body.addEventListener("click", event => {
            const edit = event.target.closest(".ci-row-edit");
            const del = event.target.closest(".ci-row-delete");

            if (!edit && !del) return;

            const row = event.target.closest("tr[data-id]");
            if (!row) return;

            if (edit) editRecord(row.dataset.id);
            if (del) deleteRecord(row.dataset.id);
        });

        document.querySelector(".ci-buttons").addEventListener("click", event => {
            const button = event.target.closest("[data-action]");
            if (!button || button.disabled) return;

            const action = button.dataset.action;
            const ids = Array.from(body.querySelectorAll(".ci-checkbox:checked"))
                .map(x => x.value);

            switch (action) {
                case "new":
                    window.location.href = "/Master/SubContractInvoice";
                    break;

                case "edit":
                    if (ids.length === 1) editRecord(ids[0]);
                    else alert("Please select one invoice.");
                    break;

                case "clone":
                    if (ids.length === 1) {
                        window.location.href =
                            "/Master/SubContractInvoice/Form?id=" +
                            encodeURIComponent(ids[0]) + "&clone=true";
                    } else {
                        alert("Please select one invoice.");
                    }
                    break;

                case "delete":
                    if (ids.length === 1) {
                        deleteRecord(ids[0]);
                    } else if (ids.length > 1) {
                        alert("Multiple selection requires a DeleteSelected action.");
                    } else {
                        alert("Please select an invoice.");
                    }
                    break;

                case "saveas":
                    if (ids.length === 1) {
                        const form = document.createElement("form");
                        form.method = "POST";
                        form.action =
                            "/Master/SubContractInvoice/SaveAs/" +
                            encodeURIComponent(ids[0]);

                        const token = document.querySelector(
                            '#ciAntiForgery input[name="__RequestVerificationToken"]'
                        );

                        if (token) {
                            const input = document.createElement("input");
                            input.type = "hidden";
                            input.name = "__RequestVerificationToken";
                            input.value = token.value;
                            form.appendChild(input);
                        }

                        document.body.appendChild(form);
                        form.submit();
                    } else {
                        alert("Please select one invoice.");
                    }
                    break;

                case "revisions":
                    if (ids.length === 1) {
                        window.location.href =
                            "/Master/SubContractInvoice/Revisions/" +
                            encodeURIComponent(ids[0]);
                    } else {
                        alert("Please select one invoice.");
                    }
                    break;

                case "print":
                    window.print();
                    break;

                case "close":
                    window.location.href = "/Home/Index";
                    break;

                default:
                    alert("This action is available from the invoice form.");
                    break;
            }
        });

        searchInput.addEventListener("input", filterRows);

        pageSizeInput.addEventListener("change", () => {
            currentPage = 1;
            renderRows();
        });

        document.getElementById("ciPrevious").addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage--;
                renderRows();
            }
        });

        document.getElementById("ciNext").addEventListener("click", () => {
            const totalPages = Math.max(
                1,
                Math.ceil(filteredRows.length / Number(pageSizeInput.value))
            );

            if (currentPage < totalPages) {
                currentPage++;
                renderRows();
            }
        });

        updateSelection();
        renderRows();
    })();
</script>
