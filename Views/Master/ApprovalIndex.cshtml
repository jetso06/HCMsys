<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Approval Master</title>

    <!-- Bootstrap 4 -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"/>

    <style>
        html { font-size: 14px; }

        /* ── Loading Overlay ── */
        #loading {
            display: none;
            position: fixed;
            left: 0; top: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.08);
            z-index: 9999;
        }
        #loadingcontent {
            display: table;
            position: fixed;
            left: 0; top: 0;
            width: 100%; height: 100%;
        }
        #loadingspinner {
            display: table-cell;
            vertical-align: middle;
            text-align: center;
            font-size: 1.1rem;
        }
        #loadingspinner::after {
            content: '';
            display: inline-block;
            width: 48px; height: 48px;
            border: 5px solid #e3e6f0;
            border-top-color: #4e73df;
            border-radius: 50%;
            animation: spin 0.75s linear infinite;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* ── Page Title Bar ── */
        .page-title-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }
        .page-title-bar .page-title-text {
            font-size: 0.85rem;
            font-weight: 800;
            color: #5a5c69;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .page-title-bar .page-title-text i { color: #4e73df; }
        .page-title-bar .btn-group-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        /* ── Table Enhancements ── */
        #tblApproval thead th {
            background-color: #4e73df;
            color: #fff;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-color: #3d5cbe;
            vertical-align: middle;
        }
        #tblApproval tbody tr:hover { background-color: #f0f3ff; }
        #tblApproval td {
            font-size: 0.82rem;
            color: #5a5c69;
            vertical-align: middle;
        }
        .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
        .action-btns a:hover { opacity: 0.7; }
        .action-btns .fa-edit      { color: #4e73df; }
        .action-btns .fa-trash-alt { color: #e74a3b; }

        /* ── Modal Header ── */
        .modal-header-primary {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            border-bottom: none;
            padding: 14px 20px;
        }
        .modal-header-primary .modal-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .modal-header-primary .close-modal-btn {
            color: rgba(255,255,255,0.8);
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            line-height: 1;
            transition: color 0.15s;
        }
        .modal-header-primary .close-modal-btn:hover { color: #fff; }
        .modal-footer-primary {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            padding: 8px 20px;
            border-top: none;
        }

        /* ── Form Labels ── */
        .form-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: #5a5c69;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 4px;
        }
        .form-control {
            font-size: 0.85rem;
            border-color: #d1d3e2;
            color: #6e707e;
            border-radius: 0.35rem;
        }
        .form-control:focus {
            border-color: #bac8f3;
            box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2);
        }

        /* ── Stat Cards ── */
        .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
        .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
        .border-left-info    { border-left: 0.25rem solid #36b9cc !important; }
        .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }

        /* ── Badge fix ── */
        .badge-primary { background-color: #4e73df; }
        .text-gray-800 { color: #5a5c69 !important; }
        .text-gray-300 { color: #dddfeb !important; }
    </style>
</head>
<body style="background:#f8f9fc;">
<div class="container-fluid py-3">

    <!-- ════════════════════════════
         PAGE HEADER CARD
    ════════════════════════════ -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-project-diagram fa-sm"></i>
                    Approval Master
                </div>
                <div class="btn-group-actions">

    <button type="button"
        class="btn btn-danger btn-sm shadow-sm"
        id="btnReject">
    <i class="fas fa-times fa-sm text-white-50 mr-1"></i>
    Reject
</button>

<button type="button"
        class="btn btn-info btn-sm shadow-sm"
        id="btnAuthTracker">
    <i class="fas fa-history fa-sm text-white-50 mr-1"></i>
    Auth Tracker
</button>

<button type="button"
        class="btn btn-success btn-sm shadow-sm"
        id="btnApprove">
    <i class="fas fa-check fa-sm text-white-50 mr-1"></i>
    Approve
</button>

    <button type="button"
            class="btn btn-primary btn-sm shadow-sm"
            id="btnHome">
        <i class="fas fa-home fa-sm text-white-50 mr-1"></i>
        Home
    </button>

    <button type="button"
        class="btn btn-success btn-sm shadow-sm"
        id="btnNew"
        onclick="window.location.href='/Master/Approval';">
    <i class="fas fa-plus fa-sm text-white-50 mr-1"></i>
    New
</button>

    <button type="button"
            class="btn btn-primary btn-sm shadow-sm"
            id="btnSave">
        <i class="fas fa-save fa-sm text-white-50 mr-1"></i>
        Save
    </button>

    <button type="button"
            class="btn btn-info btn-sm shadow-sm"
            id="btnClone">
        <i class="fas fa-copy fa-sm text-white-50 mr-1"></i>
        Clone
    </button>

    <button type="button"
            class="btn btn-danger btn-sm shadow-sm"
            id="btnDelete">
        <i class="fas fa-trash fa-sm text-white-50 mr-1"></i>
        Delete
    </button>

</div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════
         STAT CARDS
    ════════════════════════════ -->
    <div class="row mb-3">
        <!-- Total -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Approvals</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-total">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-layer-group fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Active -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Active Records</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="stat-active">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Last Modified -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Last Modified</div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800" id="stat-modified">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Module -->
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Module</div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800">Approval</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-sitemap fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════
         DATA TABLE CARD
    ════════════════════════════ -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>Approval Records
            </h6>
            <span class="badge badge-primary" id="record-count-badge">0 Records</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="tblApproval"
                       class="table table-bordered table-striped table-hover"
                       style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:90px;text-align:center;">Action</th>
                            <th style="width:60px;">Id</th>
                            <th style="width:110px;">Code</th>
                            <th>Name</th>
                            <th style="width:130px;">Approval Status</th>
                            <th style="width:130px;">Created By</th>
                            <th style="width:145px;">Created Date</th>
                            <th style="width:130px;">Modified By</th>
                            <th style="width:145px;">Modified Date</th>
                            
                        </tr>
                    </thead>
                    <tbody>
                        
                    </tbody>
                </table>
            </div>
        </div>
    </div>



</div><!-- /container-fluid -->

<!-- ════════════════════════════
     SCRIPTS
════════════════════════════ -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>

    <script>
        $('#btnNew').on('click', function () {

    window.location.href =
        '@Url.Action("Approval", "Master")';

});

});
function getApprovalStatusBadge(status) {

    const value = String(status || 'Pending').toLowerCase();

    if (value === 'approved') {
        return '<span class="badge badge-success">Approved</span>';
    }

    if (value === 'rejected') {
        return '<span class="badge badge-danger">Rejected</span>';
    }

    return '<span class="badge badge-warning">Pending</span>';
}
    $(document).ready(function () {

        fetch('/data/Approvals/approval-index.json', {
    cache: 'no-store'
})
            .then(response => {
                if (!response.ok) {
                    throw new Error('Unable to load approvals.json');
                }

                return response.json();
            })
            .then(data => {

    const approvals = data.records || [];

                var table = $('#tblApproval').DataTable({
                    data: approvals.map(function (approval) {

    return [

    '<div class="action-btns" style="text-align:center;">' +
        '<a href="#" class="edit-item-btn" title="Edit">' +
            '<i class="fas fa-edit fa-sm fa-fw"></i>' +
        '</a>' +
        '<a href="#" class="remove-item-btn" title="Delete">' +
            '<i class="fas fa-trash-alt fa-sm fa-fw"></i>' +
        '</a>' +
    '</div>',

    approval.id,
    approval.code,
    approval.name,
    getApprovalStatusBadge(approval.approvalStatus),
    approval.createdBy,
    approval.createdDate,
    approval.modifiedBy,
    approval.modifiedDate

];

}),

                    order: [[1, 'desc']],
                    pageLength: 15,

                    language: {
                        search: "",
                        searchPlaceholder: "Search approvals...",
                        lengthMenu: "Show _MENU_ entries",
                        info: "Showing _START_ to _END_ of _TOTAL_ approvals",
                        emptyTable: "No approval records found"
                    },

                    columnDefs: [
                        {
                            orderable: false,
                            targets: 0
                        }
                    ]
                });


                // ==============================
                // UPDATE STAT CARDS
                // ==============================

                var totalApprovals = approvals.length;

var pendingApprovals = approvals.filter(function (approval) {
    return String(approval.approvalStatus || '').toLowerCase() === 'pending';
}).length;

$('#stat-total').text(totalApprovals);

$('#stat-active').text(pendingApprovals);

$('#record-count-badge').text(
    totalApprovals + ' Records'
);


                // ==============================
                // LAST MODIFIED
                // ==============================

                if (approvals.length > 0) {

    var latestApproval = approvals.reduce(function (latest, approval) {

        return new Date(approval.modifiedDate) >
               new Date(latest.modifiedDate)
            ? approval
            : latest;

    });

    $('#stat-modified').text(
        latestApproval.modifiedDate
    );

} else {

    $('#stat-modified').text('N/A');

}
            .catch(error => {

                console.error('Error loading approvals:', error);

                $('#stat-total').text('0');
                $('#stat-active').text('0');
                $('#stat-modified').text('N/A');
                $('#record-count-badge').text('0 Records');

            });

    });

</script>
</body>
</html>