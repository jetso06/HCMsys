@using System.Text.Json.Nodes
@model List<JsonNode>

@{
    ViewData["Title"] = "Candidate List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var candidates = Model ?? new List<JsonNode>();
    var total = candidates.Count;
}

<div class="container-fluid candidate-index">

    <!-- MASTER TOOLBAR -->
    <div class="card ci-card ci-toolbar-card">
        <div class="card-header ci-toolbar">
            <h6 class="ci-title">
                <i class="fas fa-user-tie"></i>
                Candidate List
                <span class="ci-module-badge">CANDIDATE</span>
            </h6>

            <div class="ci-buttons">

    <!-- New -->
    <a href="@Url.Action("Index", "Candidate")"
       class="btn btn-success btn-sm shadow-sm">
        <i class="fas fa-plus"></i> New
    </a>

    <!-- Edit -->
    <button type="button" id="ciEdit"
            class="btn btn-primary btn-sm shadow-sm">
        <i class="fas fa-edit"></i> Edit
    </button>

    <!-- Save -->
    <button type="button" id="ciSave"
            class="btn btn-primary btn-sm shadow-sm" disabled>
        <i class="fas fa-save"></i> Save
    </button>

    <!-- Clone -->
    <button type="button" id="ciClone"
            class="btn btn-info btn-sm shadow-sm" disabled>
        <i class="fas fa-copy"></i> Clone
    </button>

    <!-- UnPost -->
    <button type="button" id="ciUnPost"
            class="btn btn-secondary btn-sm shadow-sm" disabled>
        <i class="fas fa-undo"></i> UnPost
    </button>

    <!-- Print -->
    <button type="button" id="ciPrint"
            class="btn btn-light btn-sm shadow-sm">
        <i class="fas fa-print"></i> Print
    </button>

    <!-- Delete -->
    <button type="button" id="ciDelete"
            class="btn btn-danger btn-sm shadow-sm">
        <i class="fas fa-trash"></i> Delete
    </button>

    <!-- Approve -->
    <button type="button" id="ciApprove"
            class="btn btn-success btn-sm shadow-sm" disabled>
        <i class="fas fa-check"></i> Approve
    </button>

    <!-- Reject -->
    <button type="button" id="ciReject"
            class="btn btn-danger btn-sm shadow-sm" disabled>
        <i class="fas fa-times"></i> Reject
    </button>

    <!-- Auth Tracker -->
    <button type="button" id="ciAuthTracker"
            class="btn btn-info btn-sm shadow-sm" disabled>
        <i class="fas fa-history"></i> Auth Tracker
    </button>

    <!-- Close -->
    <button type="button" id="ciClose"
            class="btn btn-light btn-sm shadow-sm">
        <i class="fas fa-times-circle"></i> Close
    </button>

</div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row ci-summary">
        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-primary">
                <div class="card-body">
                    <div class="ci-summary-label">Total Candidates</div>
                    <div class="ci-summary-value" id="ciTotal">@total</div>
                    <i class="fas fa-users ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-info">
                <div class="card-body">
                    <div class="ci-summary-label">Displayed Records</div>
                    <div class="ci-summary-value" id="ciDisplayed">@total</div>
                    <i class="fas fa-list ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-success">
                <div class="card-body">
                    <div class="ci-summary-label">Selected Candidate</div>
                    <div class="ci-summary-value" id="ciSelected">None</div>
                    <i class="fas fa-user-check ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-warning">
                <div class="card-body">
                    <div class="ci-summary-label">Module</div>
                    <div class="ci-summary-module">Candidate Master</div>
                    <i class="fas fa-sitemap ci-summary-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- RECORDS CARD -->
    <div class="card ci-card ci-records-card">
        <div class="card-header ci-records-header">
            <h6><i class="fas fa-table"></i> Candidate Records</h6>
            <span class="badge badge-primary" id="ciRecordCount">@total Records</span>
        </div>

        <div class="card-body">
            <div class="ci-table-tools">
                <div class="ci-page-size">
                    <span>Show</span>
                    <select id="ciPageSize" class="form-control form-control-sm">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>entries</span>
                </div>

                <input type="text"
                       id="ciSearch"
                       class="form-control form-control-sm ci-search"
                       placeholder="Search candidates..." />
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover" id="ciTable">
                    <thead>
    <tr>
        <th class="ci-control-column">Select</th>
        <th class="ci-action-column">Action</th>
        <th>Name</th>
        <th>Code</th>
        <th>Group Name</th>
        <th>Type</th>
        <th>iStatus</th>
        <th>Approval Status</th>
        <th>iMID (ID)</th>
        <th>Created By</th>
        <th>Created DateTime</th>
        <th>Modified By</th>
        <th>Modified DateTime</th>
    </tr>
</thead>
                    </thead>
                    <tbody id="ciTableBody">
    @if (candidates.Count > 0)
    {
        foreach (var item in candidates)
        {
            var id = item["id"]?.ToString() ?? "";
            var name = item["name"]?.ToString() ?? "";
            var code = item["code"]?.ToString() ?? "";
            var groupName = item["groupName"]?.ToString() ?? "";
            var type = item["type"]?.ToString() ?? "";

            var statusValue = item["iStatus"]?.ToString();

            var isActive = statusValue == "1" ||
                statusValue?.Equals(
                    "true",
                    StringComparison.OrdinalIgnoreCase
                ) == true;

            var approvalValue =
                item["approvalStatus"]?.ToString();

            var approvalLabel = approvalValue switch
            {
                "1" => "Approved",
                "2" => "Reject",
                _ => "Pending"
            };

            var masterId =
                item["iMID"]?.ToString() ?? id;

            var createdBy =
                item["createdBy"]?.ToString() ?? "";

            var createdDateTime =
                item["createdDateTime"]?.ToString() ?? "";

            var modifiedBy =
                item["modifiedBy"]?.ToString() ?? "";

            var modifiedDateTime =
                item["modifiedDateTime"]?.ToString() ?? "";

            <tr data-id="@id"
                data-search="@($"{name} {code} {groupName} {type} {statusValue} {approvalLabel} {masterId} {createdBy} {createdDateTime} {modifiedBy} {modifiedDateTime}")">

                <td class="text-center ci-control-column">
    <input type="checkbox"
           class="ci-checkbox"
           value="@id" />
</td>

<td class="text-center ci-action-column">
    <button type="button"
            class="ci-row-edit"
            title="Edit">
        <i class="fas fa-edit"></i>
    </button>

    <button type="button"
            class="ci-row-delete"
            title="Delete">
        <i class="fas fa-trash-alt"></i>
    </button>
</td>

                <td>@name</td>
                <td>@code</td>
                <td>@groupName</td>
                <td>@type</td>

                <td>
                    @if (isActive)
                    {
                        <span class="badge badge-success">YES</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">NO</span>
                    }
                </td>

                <td>
                    @if (approvalLabel == "Approved")
                    {
                        <span class="badge badge-success">
                            Approved
                        </span>
                    }
                    else if (approvalLabel == "Reject")
                    {
                        <span class="badge badge-danger">
                            Reject
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-warning">
                            Pending
                        </span>
                    }
                </td>

                <td>@masterId</td>
                <td>@createdBy</td>
                <td>@createdDateTime</td>
                <td>@modifiedBy</td>
                <td>@modifiedDateTime</td>
            </tr>
        }
    }
    else
    {
        <tr class="ci-no-data">
            <td colspan="13" class="ci-empty">
                No candidate records found.
            </td>
        </tr>
    }
</tbody>
                </table>
            </div>

            <div class="ci-empty ci-filter-empty" id="ciFilterEmpty" hidden>
                No matching candidate records found.
            </div>

            <div class="ci-table-footer">
                <span id="ciShowing">Showing 0 records</span>
                <div class="ci-pagination">
                    <button class="btn btn-light btn-sm" id="ciPrevious" type="button">Previous</button>
                    <span id="ciPageInfo">0 / 0</span>
                    <button class="btn btn-light btn-sm" id="ciNext" type="button">Next</button>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="ciDeleteForm"
      method="post"
      action="@Url.Action("Delete", "Candidate")"
      hidden>
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="ciDeleteId" />
</form>

<style>
