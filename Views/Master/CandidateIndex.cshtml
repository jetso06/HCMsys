        width: 100%;
        padding: 18px 0 25px;
        color: #5a5c69;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 13px;
    }

    .candidate-index .ci-card {
        border: 1px solid #e1e6ed;
        border-radius: 6px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(58,59,69,.14) !important;
        overflow: hidden;
    }

    .ci-toolbar-card { margin-bottom: 20px; }

    .ci-toolbar, .ci-records-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        padding: 14px 18px;
        background: #eef0f3;
        border: 0;
        border-bottom: 1px solid #e1e6ed;
    }

    .ci-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: #5a5c69;
        font-size: .85rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .ci-title i, .ci-records-header i { color: #4e73df; }

    .ci-module-badge {
        padding: 3px 7px;
        border: 1px solid #ccd3db;
        border-radius: 4px;
        background: #e5e9ee;
        color: #4b5563;
        font-size: .68rem;
        letter-spacing: normal;
    }

    .ci-buttons {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    .ci-buttons .btn {
        padding: 5px 9px;
        border-radius: 4px;
        font-size: .8rem;
        font-weight: 700;
        box-shadow: 0 .1rem .3rem rgba(0,0,0,.08);
    }

    .ci-buttons .btn i { margin-right: 4px; }

    .ci-summary { margin-bottom: 8px; }
    .ci-summary > div { margin-bottom: 16px; }
    .ci-summary-card { min-height: 78px; }

    .ci-summary-card .card-body {
        position: relative;
        padding: 15px 16px;
    }

    .ci-summary-label {
        margin-bottom: 4px;
        color: #4e73df;
        font-size: .7rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .ci-summary-value, .ci-summary-module {
        color: #5a5c69;
        font-size: 1.05rem;
        font-weight: 800;
    }

    #ciSelected { font-size: .9rem; }

    .ci-summary-icon {
        position: absolute;
        top: 22px;
        right: 16px;
        color: #dddfeb;
        font-size: 1.5rem;
    }

    .ci-border-primary { border-left: 4px solid #4e73df !important; }
    .ci-border-warning { border-left: 4px solid #f6c23e !important; }
    .ci-border-success { border-left: 4px solid #1cc88a !important; }
    .ci-border-info { border-left: 4px solid #36b9cc !important; }

    .ci-summary .ci-border-primary .ci-summary-label { color: #4e73df !important; }
    .ci-summary .ci-border-warning .ci-summary-label { color: #f6c23e !important; }
    .ci-summary .ci-border-success .ci-summary-label { color: #1cc88a !important; }
    .ci-summary .ci-border-info .ci-summary-label { color: #36b9cc !important; }

    .ci-records-card { margin-bottom: 20px; }

    .ci-records-header h6 {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: #4e73df;
        font-size: .9rem;
        font-weight: 800;
    }

    .ci-records-header .badge {
        padding: 5px 8px;
        font-size: .7rem;
    }

    .ci-records-card .card-body { padding: 16px; }

    .ci-table-tools {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }

    .ci-page-size {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-page-size select { width: 60px; }

    .ci-search { width: 320px; max-width: 100%; }

    .candidate-index .form-control {
        min-height: 32px;
        border: 1px solid #d2d0cb;
        border-radius: 5px;
        color: #5a5c69;
        font-family: inherit;
        font-size: .83rem;
        box-shadow: none;
    }

    .candidate-index .form-control:focus {
        border-color: #7d9fe5;
        box-shadow: 0 0 0 .18rem rgba(78,115,223,.14);
    }

    #ciTable {
        width: 100%;
        margin-bottom: 0;
        white-space: nowrap;
    }

    #ciTable thead th {
