        color: #5a5c69;
        font-size: .8rem;
        vertical-align: middle;
    }

    #ciTable tbody tr:hover {
    background-color: #f3f6ff;
}

.ci-row-edit,
.ci-row-delete {
    border: none;
    background: transparent;
    padding: 4px 7px;
    cursor: pointer;
    font-size: 0.9rem;
}

.ci-row-edit {
    color: #4e73df;
}

.ci-row-delete {
    color: #e74a3b;
}

.ci-row-edit:hover,
.ci-row-delete:hover {
    opacity: 0.7;
}

.ci-checkbox {
    width: 16px;
    height: 16px;
    cursor: pointer;
}

.ci-action-column {
    text-align: center;
    min-width: 85px;
}
    #ciTable tbody tr.selected { background-color: #eaecf4; }
    .ci-radio { cursor: pointer; }

    .ci-empty {
        padding: 24px !important;
        color: #858796;
        text-align: center !important;
    }

    .ci-table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 14px;
        color: #858796;
        font-size: .8rem;
    }

    .ci-pagination {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-pagination .btn {
