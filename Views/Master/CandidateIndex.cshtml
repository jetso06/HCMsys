}

@@media print {
    .ci-buttons,
    .ci-table-tools,
    .ci-table-footer,
    .ci-control-column,
    .ci-action-column {
        display: none !important;
    }

    .candidate-index .ci-card {
        box-shadow: none !important;
    }
}
    }
</style>

<script>
    (() => {
        const body = document.getElementById("ciTableBody");
        const table = document.getElementById("ciTable");
        const searchInput = document.getElementById("ciSearch");
        const pageSizeInput = document.getElementById("ciPageSize");
        const rows = Array.from(body.querySelectorAll("tr[data-id]"));

        let selectedCandidateId = null;
        let filteredRows = rows.slice();
        let currentPage = 1;

        function selectCandidate(row) {
    body.querySelectorAll("tr").forEach(tr => {
        tr.classList.remove("selected");

        const checkbox = tr.querySelector(".ci-checkbox");
        if (checkbox) checkbox.checked = false;
    });

    row.classList.add("selected");

    selectedCandidateId = row.dataset.id;

    const checkbox = row.querySelector(".ci-checkbox");
    if (checkbox) checkbox.checked = true;

    document.getElementById("ciSelected").textContent =
        row.cells[2]?.textContent.trim() || "Selected";
}

        function renderRows() {
            const pageSize = Number(pageSizeInput.value);
            const totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));
            currentPage = Math.min(currentPage, totalPages);

            rows.forEach(row => row.hidden = true);

            const start = (currentPage - 1) * pageSize;
            const visibleRows = filteredRows.slice(start, start + pageSize);

            visibleRows.forEach((row, index) => {
                row.hidden = false;
                const serial = row.querySelector(".ci-serial");
                if (serial) serial.textContent = start + index + 1;
            });

            document.getElementById("ciDisplayed").textContent = filteredRows.length;
            document.getElementById("ciRecordCount").textContent =
                `${filteredRows.length} ${filteredRows.length === 1 ? "Record" : "Records"}`;

            document.getElementById("ciShowing").textContent =
                filteredRows.length
                    ? `Showing ${start + 1} to ${start + visibleRows.length} of ${filteredRows.length} candidates`
                    : "Showing 0 candidates";

            document.getElementById("ciPageInfo").textContent =
                filteredRows.length ? `${currentPage} / ${totalPages}` : "0 / 0";

            document.getElementById("ciFilterEmpty").hidden = filteredRows.length !== 0;
            document.getElementById("ciPrevious").disabled = currentPage <= 1;
            document.getElementById("ciNext").disabled = currentPage >= totalPages;
        }

        function filterRows() {
            const query = searchInput.value.trim().toLowerCase();

            filteredRows = rows.filter(row =>
                (row.dataset.search || row.innerText).toLowerCase().includes(query)
            );

            if (selectedCandidateId &&
                !filteredRows.some(row => row.dataset.id === selectedCandidateId)) {
                selectedCandidateId = null;
                document.getElementById("ciSelected").textContent = "None";
                body.querySelectorAll("tr").forEach(tr => tr.classList.remove("selected"));
                body.querySelectorAll(".ci-checkbox").forEach(
    checkbox => checkbox.checked = false
);
            }

            currentPage = 1;
            renderRows();
        }

        // Row selection
rows.forEach(row => {
    row.addEventListener("click", event => {
        if (event.target.closest(
            ".ci-row-edit, .ci-row-delete, .ci-checkbox"
        )) {
            return;
        }

        selectCandidate(row);
    });

    const checkbox = row.querySelector(".ci-checkbox");

    checkbox?.addEventListener("change", () => {
        if (checkbox.checked) {
            selectCandidate(row);
        } else {
            row.classList.remove("selected");
            selectedCandidateId = null;
            document.getElementById("ciSelected").textContent = "None";
        }
    });
});

// Edit selected candidate
function editCandidate(id) {
    if (!id) {
        alert("Please select a candidate.");
        return;
    }

    window.location.href =
        '@Url.Action("Index", "Candidate")' +
        "?id=" + encodeURIComponent(id);
}

// Delete candidate
function deleteCandidate(id) {
    if (!id) {
        alert("Please select a candidate.");
        return;
    }

    if (!confirm("Are you sure you want to delete this candidate?")) {
        return;
    }

    document.getElementById("ciDeleteId").value = id;
    document.getElementById("ciDeleteForm").requestSubmit();
}

// Toolbar Edit
document.getElementById("ciEdit").addEventListener("click", () => {
    editCandidate(selectedCandidateId);
});

// Toolbar Delete
document.getElementById("ciDelete").addEventListener("click", () => {
    deleteCandidate(selectedCandidateId);
});

// Individual row Edit and Delete icons
body.addEventListener("click", event => {
    const editButton = event.target.closest(".ci-row-edit");
    const deleteButton = event.target.closest(".ci-row-delete");

    if (editButton || deleteButton) {
        const row = event.target.closest("tr");
        if (!row) return;

        if (editButton) {
            editCandidate(row.dataset.id);
        }

        if (deleteButton) {
            deleteCandidate(row.dataset.id);
        }
    }
});

        searchInput.addEventListener("input", filterRows);
        pageSizeInput.addEventListener("change", () => {
            currentPage = 1;
            renderRows();
        });

        document.getElementById("ciPrevious").addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage--;
                renderRows();
            }
        });

        document.getElementById("ciNext").addEventListener("click", () => {
            const totalPages = Math.max(1, Math.ceil(filteredRows.length / Number(pageSizeInput.value)));
            if (currentPage < totalPages) {
                currentPage++;
                renderRows();
            }
        });

        renderRows();
    })();
    // Print
document.getElementById("ciPrint").addEventListener("click", () => {
    window.print();
});

// Close
document.getElementById("ciClose").addEventListener("click", () => {
    window.location.href = '@Url.Action("Index", "Candidate")';
});
</script>
