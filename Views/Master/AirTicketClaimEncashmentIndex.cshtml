<script>
(() => {
    const body = document.getElementById("atTableBody");
    const searchInput = document.getElementById("atSearch");
    const pageSizeInput = document.getElementById("atPageSize");
    const selectAll = document.getElementById("atSelectAll");

    if (!body || !searchInput || !pageSizeInput || !selectAll)
        return;

    const rows = Array.from(body.querySelectorAll("tr[data-id]"));

    let filteredRows = rows.slice();
    let currentPage = 1;

    function getSelected() {
        return Array.from(body.querySelectorAll(".at-checkbox:checked"));
    }

    function updateSelection() {
        const selected = getSelected();

        const selectedVisible = filteredRows.filter(row =>
            row.querySelector(".at-checkbox")?.checked
        ).length;

        selectAll.checked =
            filteredRows.length > 0 &&
            selectedVisible === filteredRows.length;

        selectAll.indeterminate =
            selectedVisible > 0 &&
            selectedVisible < filteredRows.length;

        rows.forEach(row => {
            row.classList.toggle(
                "selected",
                row.querySelector(".at-checkbox")?.checked === true
            );
        });

        const selectedNames = selected.map(checkbox => {
            const row = checkbox.closest("tr");
            return row.cells[2]?.textContent.trim() || checkbox.value;
        });

        document.getElementById("atSelected").textContent =
            selectedNames.length ? selectedNames.join(", ") : "None";

        const edit = document.querySelector('[data-action="edit"]');
        const clone = document.querySelector('[data-action="clone"]');
        const del = document.querySelector('[data-action="delete"]');

        if (edit) edit.disabled = selected.length !== 1;
        if (clone) clone.disabled = selected.length !== 1;
        if (del) del.disabled = selected.length !== 1;
    }

    function renderRows() {
        const pageSize = Number(pageSizeInput.value);
        const totalPages = Math.max(
            1,
            Math.ceil(filteredRows.length / pageSize)
        );

        currentPage = Math.min(currentPage, totalPages);

        rows.forEach(row => row.hidden = true);

        const start = (currentPage - 1) * pageSize;
        const visibleRows = filteredRows.slice(start, start + pageSize);

        visibleRows.forEach(row => row.hidden = false);

        document.getElementById("atDisplayed").textContent =
            filteredRows.length;

        document.getElementById("atRecordCount").textContent =
            `${filteredRows.length} Records`;

        document.getElementById("atShowing").textContent =
            filteredRows.length
                ? `Showing ${start + 1} to ${start + visibleRows.length} of ${filteredRows.length} records`
                : "Showing 0 records";

        document.getElementById("atPageInfo").textContent =
            filteredRows.length
                ? `${currentPage} / ${totalPages}`
                : "0 / 0";

        document.getElementById("atPrevious").disabled =
            currentPage <= 1;

        document.getElementById("atNext").disabled =
            currentPage >= totalPages;

        updateSelection();
    }

    function filterRows() {
        const query = searchInput.value.trim().toLowerCase();

        filteredRows = rows.filter(row =>
            row.innerText.toLowerCase().includes(query)
        );

        currentPage = 1;
        renderRows();
    }

    function editRecord(id) {
        if (!id) return;

        window.location.href =
            "/Master/AirTicketClaimEncashment?id=" +
            encodeURIComponent(id);
    }

    function cloneRecord(id) {
        if (!id) return;

        window.location.href =
            "/Master/AirTicketClaimEncashment?id=" +
            encodeURIComponent(id) + "&clone=true";
    }

    function deleteRecord(id) {
        if (!id) return;

        if (!confirm("Are you sure you want to delete this record?"))
            return;

        const form = document.createElement("form");
        form.method = "POST";
        form.action =
            "/Master/AirTicketClaimEncashment/Delete/" +
            encodeURIComponent(id);

        const token = document.querySelector(
            '#atAntiForgery input[name="__RequestVerificationToken"]'
        );

        if (token) {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "__RequestVerificationToken";
            input.value = token.value;
            form.appendChild(input);
        }

        document.body.appendChild(form);
        form.submit();
    }

    selectAll.addEventListener("change", function () {
        filteredRows.forEach(row => {
            const checkbox = row.querySelector(".at-checkbox");
            if (checkbox) checkbox.checked = this.checked;
        });

        updateSelection();
    });

    rows.forEach(row => {
        row.querySelector(".at-checkbox")
            ?.addEventListener("change", updateSelection);

        row.addEventListener("click", event => {
            if (event.target.closest(
                ".at-row-edit, .at-row-delete, .at-checkbox"
            )) return;

            const checkbox = row.querySelector(".at-checkbox");
            checkbox.checked = !checkbox.checked;
            updateSelection();
        });
    });

    body.addEventListener("click", event => {
        const edit = event.target.closest(".at-row-edit");
        const del = event.target.closest(".at-row-delete");

        if (!edit && !del) return;

        const row = event.target.closest("tr[data-id]");
        if (!row) return;

        if (edit) editRecord(row.dataset.id);
        if (del) deleteRecord(row.dataset.id);
    });

    document.querySelector(".at-buttons")
        ?.addEventListener("click", event => {

            const button = event.target.closest("[data-action]");
            if (!button || button.disabled) return;

            const action = button.dataset.action;
            const selectedIds = getSelected().map(x => x.value);

            switch (action) {
                case "edit":
                    if (selectedIds.length === 1)
                        editRecord(selectedIds[0]);
                    break;

                case "clone":
                    if (selectedIds.length === 1)
                        cloneRecord(selectedIds[0]);
                    break;

                case "delete":
                    if (selectedIds.length === 1)
                        deleteRecord(selectedIds[0]);
                    break;

                case "print":
                    window.print();
                    break;

                case "new":
                    window.location.href =
                        "/Master/AirTicketClaimEncashment";
                    break;

                default:
                    alert("The " + action + " action needs a backend workflow implementation.");
                    break;
            }
        });

    searchInput.addEventListener("input", filterRows);

    pageSizeInput.addEventListener("change", () => {
        currentPage = 1;
        renderRows();
    });

    document.getElementById("atPrevious").addEventListener("click", () => {
        if (currentPage > 1) {
            currentPage--;
            renderRows();
        }
    });

    document.getElementById("atNext").addEventListener("click", () => {
        const totalPages = Math.max(
            1,
            Math.ceil(filteredRows.length / Number(pageSizeInput.value))
        );

        if (currentPage < totalPages) {
            currentPage++;
            renderRows();
        }
    });

    renderRows();
})();
</script>
