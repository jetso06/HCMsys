
@model HCMSys.Controllers.AirTicketIndexVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Config.Page.Title + " List";

    var cfg = Model.Config;
    var records = Model.Records;
    var columns = cfg.Index.Columns;
    var totalRecords = records.Count;

    string GetValue(HCMSys.Controllers.AirTicketRecord record, string field)
    {
        var property = record.GetType().GetProperty(
            char.ToUpperInvariant(field[0]) + field.Substring(1));

        return property?.GetValue(record)?.ToString() ?? "";
    }

    string FormatValue(string field, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";

        if (field.Contains("DateTime", StringComparison.OrdinalIgnoreCase)
            && DateTime.TryParse(value, out var dateTime))
            return dateTime.ToString("dd-MM-yyyy HH:mm");

        if (field.Contains("Date", StringComparison.OrdinalIgnoreCase)
            && DateTime.TryParse(value, out var date))
            return date.ToString("dd-MM-yyyy");

        return value;
    }

    // Compact widths for the control and short-code columns.
    int ColumnWidth(string field)
    {
        return field.ToLowerInvariant() switch
        {
            "ave" => 48,
            "appst" => 55,
            "id" => 50,
            "code" => 85,
            "refno" => 85,
            "documentno" => 105,
            "date" => 100,
            "createdby" => 100,
            "modifiedby" => 100,
            "createddatetime" => 145,
            "modifieddatetime" => 145,
            "employee" => 160,
            "designation" => 130,
            "department" => 130,
            _ => 120
        };
    }
}

<div class="container-fluid at-index">

    <!-- MAIN TOOLBAR -->
    <div class="card at-card at-toolbar-card">
        <div class="card-header at-toolbar">

            <h6 class="at-title">
                <i class="fas @cfg.Page.Icon"></i>
                @cfg.Page.Title
                <span class="at-module-badge">
                    AIR TICKET CLAIM / ENCASHMENT
                </span>
            </h6>

            <div class="at-buttons">
                @foreach (var b in cfg.Buttons.Index.Where(x => x.Visible))
                {
                    var action = b.Action.ToLowerInvariant();

                    if (action == "new")
                    {
                        <a class="btn btn-@b.Style btn-sm"
                           href="/Master/AirTicketClaimEncashment">
                            <i class="fas @b.Icon"></i> @b.Text
                        </a>
                    }
                    else if (action == "home")
                    {
                        <a class="btn btn-@b.Style btn-sm"
                           href="/Home/Index">
                            <i class="fas @b.Icon"></i> @b.Text
                        </a>
                    }
                    else if (action == "close")
                    {
                        <a class="btn btn-@b.Style btn-sm"
                           href="/Home/Index">
                            <i class="fas @b.Icon"></i> @b.Text
                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-@b.Style btn-sm"
                                data-action="@action">
                            <i class="fas @b.Icon"></i> @b.Text
                        </button>
                    }
                }
            </div>

        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["Error"]
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row at-summary">

        <div class="col-xl-3 col-md-6">
            <div class="card at-card at-summary-card at-border-primary">
                <div class="card-body">
                    <div class="at-summary-label">Total Records</div>
                    <div class="at-summary-value">@totalRecords</div>
                    <i class="fas fa-layer-group at-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card at-card at-summary-card at-border-info">
                <div class="card-body">
                    <div class="at-summary-label">Displayed Records</div>
                    <div class="at-summary-value" id="atDisplayed">@totalRecords</div>
                    <i class="fas fa-list at-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card at-card at-summary-card at-border-success">
                <div class="card-body">
                    <div class="at-summary-label">Selected Record</div>
                    <div class="at-summary-value" id="atSelected">None</div>
                    <i class="fas fa-file-alt at-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card at-card at-summary-card at-border-warning">
                <div class="card-body">
                    <div class="at-summary-label">Module</div>
                    <div class="at-summary-module">Air Ticket Claim</div>
                    <i class="fas fa-plane at-summary-icon"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- INDEX TABLE CARD -->
    <div class="card at-card at-records-card">

        <div class="card-header at-records-header">
            <h6>
                <i class="fas fa-table"></i>
                @cfg.Index.Heading
            </h6>

            <span class="badge badge-primary" id="atRecordCount">
                @totalRecords Records
            </span>
        </div>

        <div class="card-body">

            <!-- SEARCH AND PAGE SIZE -->
            <div class="at-table-tools">

                <div class="at-page-size">
                    <span>Show</span>

                    <select id="atPageSize"
                            class="form-control form-control-sm">
                        <option value="20">20</option>
                        <option value="35">35</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>

                    <span>entries</span>
                </div>

                <input type="search"
                       id="atSearch"
                       class="form-control form-control-sm at-search"
                       placeholder="Search Air Ticket Claim records..." />

            </div>

            <!-- TABLE -->
            <div class="at-wrap">

                <table class="table table-bordered table-striped table-hover"
                       id="atTable">

                    <colgroup>
                        <col style="width:55px" />
                        <col style="width:65px" />

                        @foreach (var c in columns)
                        {
                            var width = ColumnWidth(c.Field);
                            <col style="width:@(width)px" />
                        }
                    </colgroup>

                    <thead>
                        <tr>
                            <th class="at-control-column">
                                <div class="at-select-header">
                                    <span>Select</span>
                                    <input type="checkbox" id="atSelectAll" />
                                </div>
                            </th>

                            <th class="at-action-column">Action</th>

                            @foreach (var c in columns)
                            {
                                <th title="@c.Tooltip"
                                    class="@(new[] { "Ave", "AppSt", "Id" }.Contains(c.Field, StringComparer.OrdinalIgnoreCase) ? "at-small-column" : "")">

                                    @c.Label

                                    @if (!string.IsNullOrWhiteSpace(c.Tooltip))
                                    {
                                        <i class="fas fa-info-circle at-tooltip"
                                           title="@c.Tooltip"></i>
                                    }
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody id="atTableBody">

                        @if (records.Any())
                        {
                            foreach (var r in records)
                            {
                                <tr data-id="@r.Id">

                                    <td class="text-center at-control-column">
                                        <input type="checkbox"
                                               class="at-checkbox"
                                               value="@r.Id" />
                                    </td>

                                    <td class="text-center at-action-column">

                                        <button type="button"
                                                class="at-row-edit"
                                                title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="at-row-delete"
                                                title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>

                                    </td>

                                    @foreach (var c in columns)
                                    {
                                        var rawValue = GetValue(r, c.Field);
                                        var value = FormatValue(c.Field, rawValue);

                                        if (c.Field.Equals("Ave", StringComparison.OrdinalIgnoreCase))
                                        {
                                            value = value switch
                                            {
                                                "Approved" => "Y",
                                                "Rejected" => "N",
                                                "Pending" => "P",
                                                _ => value
                                            };
                                        }

                                        if (c.Field.Equals("AppSt", StringComparison.OrdinalIgnoreCase))
                                        {
                                            value = value switch
                                            {
                                                "Pending" => "P",
                                                "Approved" => "A",
                                                "Rejected" => "R",
                                                _ => value
                                            };
                                        }

                                        <td title="@rawValue"
                                            class="@(new[] { "Ave", "AppSt", "Id" }.Contains(c.Field, StringComparer.OrdinalIgnoreCase) ? "at-small-column" : "")">
                                            @value
                                        </td>
                                    }

                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="at-no-data">
                                <td colspan="@(columns.Count + 2)" class="at-empty">
                                    No Air Ticket Claim / Encashment records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- PAGINATION -->
            <div class="at-table-footer">

                <span id="atShowing">Showing 0 records</span>

                <div class="at-pagination">
                    <button type="button"
                            class="btn btn-light btn-sm"
                            id="atPrevious">
                        Previous
                    </button>

                    <span id="atPageInfo">0 / 0</span>

                    <button type="button"
                            class="btn btn-light btn-sm"
                            id="atNext">
                        Next
                    </button>
                </div>

            </div>

        </div>
    </div>

</div>

<!-- ANTI-FORGERY TOKEN -->
<form id="atAntiForgery" hidden>
    @Html.AntiForgeryToken()
</form>

