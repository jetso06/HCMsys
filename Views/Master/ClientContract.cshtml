@{
    ViewData["Title"] = "Client Contract";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid cc-page">

    <!-- Page Header -->
    <div class="card shadow mb-3">
        <div class="card-header py-3 cc-header">
            <h6 class="m-0 font-weight-bold text-uppercase cc-title">
                <i class="fas fa-file-contract mr-2"></i>
                Client Contract
            </h6>

            
<div class="btn-group-actions">

    <button type="button" class="btn btn-success btn-sm shadow-sm"
            id="btnNew" onclick="newContract()">
        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> New
    </button>

    <button type="button" class="btn btn-primary btn-sm shadow-sm"
            id="btnEdit">
        <i class="fas fa-edit fa-sm text-white-50 mr-1"></i> Edit
    </button>

    <button type="button" class="btn btn-primary btn-sm shadow-sm"
            id="btnSave" onclick="saveDemo()">
        <i class="fas fa-save fa-sm text-white-50 mr-1"></i> Save
    </button>

    <button type="button" class="btn btn-info btn-sm shadow-sm"
            id="btnClone">
        <i class="fas fa-copy fa-sm text-white-50 mr-1"></i> Clone
    </button>

    <button type="button" class="btn btn-warning btn-sm shadow-sm"
            id="btnUnPost">
        <i class="fas fa-undo fa-sm text-white-50 mr-1"></i> UnPost
    </button>

    <button type="button" class="btn btn-secondary btn-sm shadow-sm"
            id="btnPrint" onclick="window.print()">
        <i class="fas fa-print fa-sm text-white-50 mr-1"></i> Print
    </button>

    <button type="button" class="btn btn-danger btn-sm shadow-sm"
            id="btnDelete" onclick="deleteDemo()">
        <i class="fas fa-trash fa-sm text-white-50 mr-1"></i> Delete
    </button>

    <button type="button" class="btn btn-info btn-sm shadow-sm"
            id="btnNewGroup">
        <i class="fas fa-layer-group fa-sm text-white-50 mr-1"></i> New Group
    </button>

    <button type="button" class="btn btn-success btn-sm shadow-sm"
            id="btnApprove">
        <i class="fas fa-check fa-sm text-white-50 mr-1"></i> Approve
    </button>

    <button type="button" class="btn btn-danger btn-sm shadow-sm"
            id="btnReject">
        <i class="fas fa-times fa-sm text-white-50 mr-1"></i> Reject
    </button>

    <button type="button" class="btn btn-info btn-sm shadow-sm"
            id="btnAuthTracker">
        <i class="fas fa-route fa-sm text-white-50 mr-1"></i> Auth Tracker
    </button>

    <button type="button" class="btn btn-secondary btn-sm shadow-sm"
            id="btnClose" onclick="window.history.back()">
        <i class="fas fa-times-circle fa-sm text-white-50 mr-1"></i> Close
    </button>

</div>

        </div>
    </div>

    <div id="ccMessage" class="alert alert-success" style="display:none;"></div>

    <!-- Contract Details -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-file-alt mr-2"></i> Contract Details
            </h6>
            <span class="text-muted small" id="ccFormStatus">New Contract</span>
        </div>

        <div class="card-body">
            <form id="clientContractForm" onsubmit="return false;">
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="ccDocumentNo">Document No.</label>
                        <input id="ccDocumentNo" class="form-control" value="500" readonly>
                        <small class="form-text text-muted">Document number preview.</small>
                    </div>

                    <div class="form-group col-md-3">
                        <label for="ccDate">Date <span class="text-danger">*</span></label>
                        <input id="ccDate" type="date" class="form-control" required>
                    </div>

                    <div class="form-group col-md-3">
                        <label for="ccPostDate">PostDate <span class="text-danger">*</span></label>
                        <input id="ccPostDate" type="datetime-local" class="form-control" required>
                    </div>

                    <div class="form-group col-md-6">
                        <label for="ccClient">Client <span class="text-danger">*</span></label>
                        <select id="ccClient" class="form-control" required>
                            <option value="">-- Select Client --</option>
                            <option>ABC Trading LLC</option>
                            <option>Al Noor Services</option>
                            <option>Gulf Technologies</option>
                            <option>Muscat Engineering</option>
                            <option>Other Client</option>
                        </select>
                    </div>

                    <div class="form-group col-md-6">
                        <label for="ccReference">Contract Reference</label>
                        <input id="ccReference" maxlength="60" class="form-control"
                               placeholder="Enter contract reference">
                    </div>

                    <div class="form-group col-md-6">
                        <label for="ccStartDate">Start Date <span class="text-danger">*</span></label>
                        <input id="ccStartDate" type="date" class="form-control" required>
                    </div>

                    <div class="form-group col-md-6">
                        <label for="ccEndDate">End Date <span class="text-danger">*</span></label>
                        <input id="ccEndDate" type="date" class="form-control" required>
                    </div>

                    <div class="form-group col-md-4">
                        <label for="ccCurrency">Currency <span class="text-danger">*</span></label>
                        <select id="ccCurrency" class="form-control" required>
                            <option value="">-- Select Currency --</option>
                            <option value="OMR">OMR - Omani Rial</option>
                            <option value="USD">USD - US Dollar</option>
                            <option value="AED">AED - UAE Dirham</option>
                            <option value="INR">INR - Indian Rupee</option>
                            <option value="EUR">EUR - Euro</option>
                            <option value="GBP">GBP - British Pound</option>
                        </select>
                    </div>

                    <div class="form-group col-md-4">
                        <label for="ccValue">Contract Value <span class="text-danger">*</span></label>
                        <input id="ccValue" type="number" min="0" step="0.001"
                               class="form-control" placeholder="0.000" required>
                    </div>

                    <div class="form-group col-md-4">
                        <label for="ccPaymentTerms">Payment Terms</label>
                        <select id="ccPaymentTerms" class="form-control">
                            <option value="">-- Select Payment Terms --</option>
                            <option>Advance Payment</option>
                            <option>Net 15 Days</option>
                            <option>Net 30 Days</option>
                            <option>Net 45 Days</option>
                            <option>Net 60 Days</option>
                            <option>Monthly</option>
                            <option>Milestone Based</option>
                        </select>
                    </div>

                    <div class="form-group col-md-6">
                        <label for="ccContactPerson">Contact Person (Client Side)</label>
                        <input id="ccContactPerson" maxlength="100" class="form-control">
                    </div>

                    <div class="form-group col-md-6">
                        <label for="ccFinanceContact">Finance Contact (Client Side)</label>
                        <input id="ccFinanceContact" maxlength="100" class="form-control">
                    </div>

                    <div class="form-group col-md-4">
                        <label for="ccOwner">Contract Owner</label>
                        <select id="ccOwner" class="form-control">
                            <option value="">-- Select Employee --</option>
                            <option>Admin</option>
                            <option>Jerin Davis</option>
                            <option>Project Manager</option>
                            <option>Finance Manager</option>
                        </select>
                    </div>

                    <div class="form-group col-md-4">
                        <label for="ccBank">Payment Bank</label>
                        <select id="ccBank" class="form-control">
                            <option value="">-- Select Bank --</option>
                            <option>Bank Muscat</option>
                            <option>Sohar International</option>
                            <option>National Bank of Oman</option>
                            <option>Oman Arab Bank</option>
                        </select>
                    </div>

                    <div class="form-group col-md-4">
                        <label for="ccProject">Project No.</label>
                        <select id="ccProject" class="form-control">
                            <option value="">-- Select Project --</option>
                            <option>PRJ-001</option>
                            <option>PRJ-002</option>
                            <option>PRJ-003</option>
                            <option>PRJ-004</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Terms and Conditions -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-align-left mr-2"></i> Narration / Terms &amp; Conditions
            </h6>
        </div>
        <div class="card-body">
            <div class="cc-toolbar mb-2">
                <button type="button" class="btn btn-light btn-sm" onclick="formatTerms('bold')" title="Bold">
                    <i class="fas fa-bold"></i>
                </button>
                <button type="button" class="btn btn-light btn-sm" onclick="formatTerms('italic')" title="Italic">
                    <i class="fas fa-italic"></i>
                </button>
                <button type="button" class="btn btn-light btn-sm" onclick="formatTerms('underline')" title="Underline">
                    <i class="fas fa-underline"></i>
                </button>
                <button type="button" class="btn btn-light btn-sm" onclick="formatTerms('insertUnorderedList')" title="Bulleted list">
                    <i class="fas fa-list-ul"></i>
                </button>
                <button type="button" class="btn btn-light btn-sm" onclick="formatTerms('insertOrderedList')" title="Numbered list">
                    <i class="fas fa-list-ol"></i>
                </button>
            </div>

            <div id="ccTerms" contenteditable="true" class="cc-editor"
                 data-placeholder="Enter narration, terms and conditions..."></div>
        </div>
    </div>

    <!-- Attachments Grid -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center flex-wrap">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-paperclip mr-2"></i> Attachments
            </h6>
            <button type="button" class="btn btn-primary btn-sm" onclick="addAttachmentRow()">
                <i class="fas fa-plus mr-1"></i> Add Attachment
            </button>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover cc-attachment-table">
                    <thead>
                        <tr>
                            <th>Show</th>
                            <th>Attachment Type</th>
                            <th>Remarks</th>
                            <th>Attachment</th>
                            <th>TrackExpiry</th>
                            <th>Ref No</th>
                            <th>Issue Date</th>
                            <th>Expiry Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="ccAttachmentsBody"></tbody>
                </table>
            </div>

            <div class="text-muted small">
                Use Add Attachment to insert more rows. Issue and expiry dates are optional.
            </div>
        </div>
    </div>

</div>
<!-- SAVE SUCCESS MODAL -->
<div class="modal fade"
     id="accountSuccessModal"
     tabindex="-1"
     role="dialog"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content save-modal">

            <div class="modal-header save-modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-check-circle mr-2"></i>
                    Success
                </h5>

                <button type="button"
                        class="close text-white"
                        data-dismiss="modal"
                        aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body text-center py-4">
                <div class="save-success-icon">
                    <i class="fas fa-check"></i>
                </div>

                <h5 class="save-title">Saved Successfully!</h5>

                <p class="save-message">
                    Client contract saved successfully.
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button"
                        class="btn btn-success"
                        data-dismiss="modal">
                    <i class="fas fa-check mr-1"></i> OK
                </button>
            </div>

        </div>
    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade"
     id="accountDeleteModal"
     tabindex="-1"
     role="dialog"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content delete-modal">

            <div class="modal-header delete-modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    Confirm Delete
                </h5>

                <button type="button"
                        class="close text-white"
                        data-dismiss="modal"
                        aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body text-center py-4">
                <div class="delete-warning-icon">
                    <i class="fas fa-trash-alt"></i>
                </div>

                <h5 class="delete-title">Are you sure?</h5>

                <p class="delete-message">
                    Are you sure you want to delete this client contract?
                </p>

                <p class="delete-submessage">
                    This action cannot be undone.
                </p>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal">
                    <i class="fas fa-times mr-1"></i> No
                </button>

                <button type="button"
                        class="btn btn-danger"
                        id="btnConfirmDelete">
                    <i class="fas fa-trash-alt mr-1"></i> Yes
                </button>
            </div>

        </div>
    </div>
</div>
<style>
    html { font-size: 14px; }
    .cc-page {
        padding: 24px 20px;
        color: #5a5c69;
        font-family: 'Nunito', sans-serif;
        font-size: 14px;
    }

    .cc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        background: #f8f9fc;
        border-bottom: 1px solid #e3e6f0;
    }

    .cc-title {
        color: #5a5c69;
        letter-spacing: .08em;
        font-size: .85rem;
    }

    .cc-actions,
.cc-toolbar,
.btn-group-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
}

.btn-group-actions .btn {
    font-size: .75rem;
}

    .cc-page .card {
        border: 1px solid #e3e6f0;
        border-radius: .35rem;
        margin-bottom: 1rem;
    }

    .cc-page .card-header {
        background: #f8f9fc;
        border-bottom: 1px solid #e3e6f0;
    }

    .cc-page .form-control {
        border: 1px solid #d1d3e2;
        border-radius: .35rem;
        color: #6e707e;
        font-size: .85rem;
        min-height: 38px;
    }

    .cc-page label {
        font-weight: 700;
        font-size: .8rem;
        color: #5a5c69;
    }

    .cc-page .btn {
        font-size: .8rem;
        font-weight: 600;
    }

    .cc-attachment-table {
        min-width: 1250px;
        margin-bottom: 0;
    }

    .cc-attachment-table thead th {
        background: #4e73df;
        color: #fff;
        border-color: #3d5cbe;
        font-size: .72rem;
        text-transform: uppercase;
        white-space: nowrap;
        vertical-align: middle;
    }

    .cc-attachment-table tbody td {
        font-size: .8rem;
        vertical-align: middle;
    }

    .cc-attachment-table .form-control {
        min-width: 120px;
        font-size: .8rem;
    }

    .cc-attachment-table input[type="file"] {
        min-width: 190px;
        max-width: 220px;
        font-size: .75rem;
    }

    .cc-attachment-table input[type="checkbox"] {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .cc-date-cell {
        min-width: 180px;
    }

    .cc-date-control {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .cc-date-control input[type="date"] {
        min-width: 130px;
    }

    .cc-editor {
        min-height: 180px;
        padding: 12px;
        border: 1px solid #d1d3e2;
        border-radius: .35rem;
        background: #fff;
        color: #5a5c69;
        overflow-wrap: anywhere;
    }

    .cc-editor:focus {
        outline: none;
        border-color: #bac8f3;
        box-shadow: 0 0 0 .2rem rgba(78, 115, 223, .15);
    }

    .cc-editor:empty::before {
        content: attr(data-placeholder);
