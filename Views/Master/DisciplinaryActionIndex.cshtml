@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tbody = document.getElementById("daTableBody");
            const rows = Array.from(tbody.querySelectorAll("tr"));

            const searchInput = document.getElementById("daSearch");
            const pageSizeSelect = document.getElementById("daPageSize");
            const statusFilter = document.getElementById("daStatusFilter");
            const dateFrom = document.getElementById("daDateFrom");
            const dateTo = document.getElementById("daDateTo");
            const selectAll = document.getElementById("daSelectAll");

            const pageInfo = document.getElementById("daPageInfo");
            const showing = document.getElementById("daShowing");
            const recordCount = document.getElementById("daRecordCount");
            const emptyMessage = document.getElementById("daEmptyMessage");

            let currentPage = 1;
            let selectedRow = null;
            let filteredRows = [];

            function getSelectedRows() {
                return rows.filter(row =>
                    row.querySelector(".da-row-select").checked
                );
            }

            function updateSelection() {
                const checkedRows = getSelectedRows();

                rows.forEach(row => {
                    row.classList.toggle(
                        "da-selected",
                        row.querySelector(".da-row-select").checked
                    );
                });

                selectedRow = checkedRows.length === 1 ? checkedRows[0] : null;

                const pageSize = Number(pageSizeSelect.value);
                const visibleRows = filteredRows.slice(
                    (currentPage - 1) * pageSize,
                    currentPage * pageSize
                );

                selectAll.checked = visibleRows.length > 0 &&
                    visibleRows.every(row =>
                        row.querySelector(".da-row-select").checked
                    );

                selectAll.indeterminate = visibleRows.some(row =>
                    row.querySelector(".da-row-select").checked
                ) && !selectAll.checked;
            }

            function getFilteredRows() {
                const search = searchInput.value.trim().toLowerCase();
                const status = statusFilter.value.toLowerCase();
                const from = dateFrom.value;
                const to = dateTo.value;

                return rows.filter(row => {
                    const searchable = [
                        row.dataset.document,
                        row.dataset.employee,
                        row.dataset.code,
                        row.dataset.department,
                        row.dataset.actionType,
                        row.dataset.status,
                        row.dataset.warningType,
                        row.dataset.warningAction
                    ].join(" ").toLowerCase();

                    const date = row.dataset.date || "";

                    return (!search || searchable.includes(search)) &&
                        (!status || (row.dataset.status || "").toLowerCase() === status) &&
                        (!from || date >= from) &&
                        (!to || date <= to);
                });
            }

            function updateSummary() {
                document.getElementById("daTotal").textContent = rows.length;

                document.getElementById("daOpen").textContent =
                    rows.filter(row =>
                        (row.dataset.status || "").toLowerCase() === "open"
                    ).length;

                document.getElementById("daClosed").textContent =
                    rows.filter(row =>
                        (row.dataset.status || "").toLowerCase() === "closed"
                    ).length;

                recordCount.textContent =
                    rows.length + (rows.length === 1 ? " Record" : " Records");
            }

            function renderTable() {
                filteredRows = getFilteredRows();

                const pageSize = Number(pageSizeSelect.value);
                const totalPages = Math.max(
                    1, Math.ceil(filteredRows.length / pageSize)
                );

                currentPage = Math.min(currentPage, totalPages);

                rows.forEach(row => row.style.display = "none");

                const start = (currentPage - 1) * pageSize;
                const pageRows = filteredRows.slice(start, start + pageSize);

                pageRows.forEach((row, index) => {
                    row.style.display = "";
                    row.querySelector(".da-serial").textContent = start + index + 1;
                });

                if (filteredRows.length === 0) {
                    showing.textContent = "Showing 0 records";
                    pageInfo.textContent = "0 / 0";
                    emptyMessage.style.display = "block";
                } else {
                    showing.textContent =
                        "Showing " + (start + 1) + " to " +
                        (start + pageRows.length) + " of " +
                        filteredRows.length + " disciplinary actions";

                    pageInfo.textContent = currentPage + " / " + totalPages;
                    emptyMessage.style.display = "none";
                }

                document.getElementById("daPrevious").disabled = currentPage <= 1;
                document.getElementById("daNext").disabled =
                    currentPage >= totalPages;

                updateSelection();
            }

            function clearSelection() {
                rows.forEach(row => {
                    row.querySelector(".da-row-select").checked = false;
                    row.classList.remove("da-selected");
                });

                selectedRow = null;
                selectAll.checked = false;
                selectAll.indeterminate = false;
            }

            function requireOneSelected(actionName) {
                const checked = getSelectedRows();

                if (checked.length !== 1) {
                    alert("Please select one disciplinary action record to " +
                        actionName + ".");
                    return null;
                }

                return checked[0];
            }

            // Row selection.
            rows.forEach(row => {
                row.addEventListener("click", function (event) {
                    if (event.target.closest("input")) {
                        updateSelection();
                        return;
                    }

                    const checkbox = row.querySelector(".da-row-select");
                    checkbox.checked = !checkbox.checked;
                    updateSelection();
                });

                row.querySelector(".da-row-select").addEventListener(
                    "change", updateSelection
                );
            });

            // Select all visible rows on the current page.
            selectAll.addEventListener("change", function () {
                const pageSize = Number(pageSizeSelect.value);
                const start = (currentPage - 1) * pageSize;
                const visibleRows = filteredRows.slice(start, start + pageSize);

                visibleRows.forEach(row => {
                    row.querySelector(".da-row-select").checked = selectAll.checked;
                });

                updateSelection();
            });

            // Search and filters.
            [searchInput, statusFilter, dateFrom, dateTo].forEach(control => {
                control.addEventListener("input", function () {
                    currentPage = 1;
                    renderTable();
                });

                control.addEventListener("change", function () {
                    currentPage = 1;
                    renderTable();
                });
            });

            pageSizeSelect.addEventListener("change", function () {
                currentPage = 1;
                renderTable();
            });

            document.getElementById("daClearFilters").addEventListener("click", function () {
                searchInput.value = "";
                statusFilter.value = "";
                dateFrom.value = "";
                dateTo.value = "";
                currentPage = 1;
                clearSelection();
                renderTable();
            });

            document.getElementById("daPrevious").addEventListener("click", function () {
                if (currentPage > 1) {
                    currentPage--;
                    renderTable();
                }
            });

            document.getElementById("daNext").addEventListener("click", function () {
                if (currentPage * Number(pageSizeSelect.value) < filteredRows.length) {
                    currentPage++;
                    renderTable();
                }
            });

            // Toolbar actions.
            document.getElementById("daEdit").addEventListener("click", function () {
                const row = requireOneSelected("edit");
                if (!row) return;

                window.location.href =
                    '@Url.Content("~/Master/DisciplinaryAction")' +
                    '?documentNo=' + encodeURIComponent(row.dataset.document);
            });

            document.getElementById("daClone").addEventListener("click", function () {
                const row = requireOneSelected("clone");
                if (!row) return;

                alert("Clone is not implemented in the current controller yet.");
            });

            document.getElementById("daSave").addEventListener("click", function () {
                alert("To save a disciplinary action, open the New or Edit form first.");
            });

            document.getElementById("daDelete").addEventListener("click", function () {
                const row = requireOneSelected("delete");
                if (!row) return;

                selectedRow = row;

                if (window.jQuery && typeof window.jQuery.fn.modal === "function") {
                    window.jQuery("#daDeleteConfirmModal").modal("show");
                } else if (confirm("Are you sure you want to delete the selected disciplinary action?")) {
                    submitDelete(row);
                }
            });

            function submitDelete(row) {
                document.getElementById("daDeleteDocumentNo").value =
                    row.dataset.document;

                document.getElementById("daDeleteForm").submit();
            }

            document.getElementById("daConfirmDelete").addEventListener("click", function () {
                if (!selectedRow || !selectedRow.isConnected) return;

                submitDelete(selectedRow);
            });

            document.getElementById("daPrint").addEventListener("click", function () {
                window.print();
            });

            document.getElementById("daClose").addEventListener("click", function () {
                window.location.href = '@Url.Content("~/Master/DisciplinaryAction")';
            });

            document.getElementById("daUnPost").addEventListener("click", function () {
                if (!requireOneSelected("unpost")) return;
                alert("UnPost is not implemented in the current controller yet.");
            });

            document.getElementById("daApprove").addEventListener("click", function () {
                if (!requireOneSelected("approve")) return;
                alert("Approve is not implemented in the current controller yet.");
            });

            document.getElementById("daReject").addEventListener("click", function () {
                if (!requireOneSelected("reject")) return;
                alert("Reject is not implemented in the current controller yet.");
            });

            document.getElementById("daAuthTracker").addEventListener("click", function () {
                if (!requireOneSelected("view the authorization tracker")) return;
                alert("Auth Tracker is not implemented in the current controller yet.");
            });

            updateSummary();
            renderTable();
        });
    </script>
}
