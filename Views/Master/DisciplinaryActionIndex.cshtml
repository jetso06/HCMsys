
@model List<HCMSys.Controllers.DisciplinaryActionRecord>

@{
    ViewData["Title"] = "Disciplinary Action Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var records = Model ?? new List<HCMSys.Controllers.DisciplinaryActionRecord>();

    var totalRecords = records.Count;
    var closedRecords = records.Count(r =>
        string.Equals(r.HrStatus, "Closed", StringComparison.OrdinalIgnoreCase));
    var openRecords = records.Count(r =>
        string.Equals(r.HrStatus, "Open", StringComparison.OrdinalIgnoreCase));
}

<div class="container-fluid da-index">

    <!-- HEADER / TOOLBAR -->
    <div class="card shadow mb-3">
        <div class="card-header da-header">
            <h6 class="da-title">
                <i class="fas fa-file-alt mr-2"></i>
                DISCIPLINARY ACTION MASTER
                <span class="da-module-badge">502</span>
            </h6>

            <div class="da-actions">
                <a href="@Url.Content("~/Master/DisciplinaryAction")"
                   class="btn btn-success btn-sm">
                    <i class="fas fa-plus fa-sm mr-1"></i> New
                </a>

                <button type="button" class="btn btn-primary btn-sm" id="daEdit">
                    <i class="fas fa-edit fa-sm mr-1"></i> Edit
                </button>

                <button type="button" class="btn btn-primary btn-sm" id="daSave">
                    <i class="fas fa-save fa-sm mr-1"></i> Save
                </button>

                <button type="button" class="btn btn-info btn-sm" id="daClone">
                    <i class="fas fa-copy fa-sm mr-1"></i> Clone
                </button>

                <button type="button" class="btn btn-warning btn-sm" id="daUnPost">
                    <i class="fas fa-undo fa-sm mr-1"></i> UnPost
                </button>

                <button type="button" class="btn btn-secondary btn-sm" id="daPrint">
                    <i class="fas fa-print fa-sm mr-1"></i> Print
                </button>

                <button type="button" class="btn btn-danger btn-sm" id="daDelete">
                    <i class="fas fa-trash fa-sm mr-1"></i> Delete
                </button>

                <button type="button" class="btn btn-success btn-sm" id="daApprove">
                    <i class="fas fa-check fa-sm mr-1"></i> Approve
                </button>

                <button type="button" class="btn btn-danger btn-sm" id="daReject">
                    <i class="fas fa-times fa-sm mr-1"></i> Reject
                </button>

                <button type="button" class="btn btn-info btn-sm" id="daAuthTracker">
                    <i class="fas fa-route fa-sm mr-1"></i> Auth Tracker
                </button>

                <button type="button" class="btn btn-secondary btn-sm" id="daClose">
                    <i class="fas fa-times-circle fa-sm mr-1"></i> Close
                </button>
            </div>
        </div>
    </div>

    <!-- SUCCESS / ERROR MESSAGES -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @successMessage
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @errorMessage
            <button type="button" class="close" data-dismiss="alert">
                <span>&times;</span>
            </button>
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row mb-3 da-summary">

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Disciplinary Actions
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="daTotal">
                                @totalRecords
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-layer-group fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Closed Actions
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="daClosed">
                                @closedRecords
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Open Actions
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="daOpen">
                                @openRecords
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Module
                            </div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800">
                                Disciplinary Action
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-sitemap fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- RECORDS GRID -->
    <div class="card shadow mb-4 da-records-card">

        <div class="card-header da-records-header">
            <h6>
                <i class="fas fa-table mr-2"></i>
                Disciplinary Action Records
            </h6>

            <span class="badge badge-primary" id="daRecordCount">
                @totalRecords @(totalRecords == 1 ? "Record" : "Records")
            </span>
        </div>

        <div class="card-body">

            <!-- PAGE SIZE AND SEARCH -->
            <div class="da-table-tools">

                <div class="da-page-size">
                    <span>Show</span>

                    <select id="daPageSize" class="form-control form-control-sm">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>

                    <span>entries</span>
                </div>

                <div class="da-search">
                    <label for="daSearch">Search disciplinary actions</label>
                    <input type="search"
                           id="daSearch"
                           class="form-control form-control-sm"
                           placeholder="Search document, employee, department..." />
                </div>

            </div>

            <!-- FILTERS -->
            <div class="row da-filters">

                <div class="col-lg-4 col-md-6 form-group">
                    <label for="daStatusFilter">HR Status</label>
                    <select id="daStatusFilter" class="form-control form-control-sm">
                        <option value="">All Statuses</option>
                        @foreach (var status in records
                            .Select(r => r.HrStatus)
                            .Where(s => !string.IsNullOrWhiteSpace(s))
                            .Distinct(StringComparer.OrdinalIgnoreCase)
                            .OrderBy(s => s))
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="col-lg-3 col-md-6 form-group">
                    <label for="daDateFrom">From Date</label>
                    <input type="date" id="daDateFrom"
                           class="form-control form-control-sm" />
                </div>

                <div class="col-lg-3 col-md-6 form-group">
                    <label for="daDateTo">To Date</label>
                    <input type="date" id="daDateTo"
                           class="form-control form-control-sm" />
                </div>

                <div class="col-lg-2 col-md-6 form-group da-clear-filter">
                    <button type="button"
                            class="btn btn-light btn-sm border"
                            id="daClearFilters">
                        <i class="fas fa-eraser mr-1"></i> Clear
                    </button>
                </div>

            </div>

            <!-- TABLE -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover"
                       id="daTable">

                    <thead>
                        <tr>
                            <th class="da-select-column">
                                <input type="checkbox" id="daSelectAll"
                                       aria-label="Select all visible records" />
                            </th>
                            <th>#</th>
                            <th>Document No.</th>
                            <th>Date</th>
                            <th>Employee Code</th>
                            <th>Employee Name</th>
                            <th>Department</th>
                            <th>Disciplinary Action Type</th>
                            <th>HR Status</th>
                            <th>Approval Status</th>
                            <th>Warning Type</th>
                            <th>Warning Action</th>
                        </tr>
                    </thead>

                    <tbody id="daTableBody">
                        @for (int i = 0; i < records.Count; i++)
                        {
                            var record = records[i];
                            var status = record.HrStatus ?? "";

                            <tr data-document="@record.DocumentNo"
                                data-date="@record.Date.ToString("yyyy-MM-dd")"
                                data-employee="@record.EmployeeName"
                                data-code="@record.EmployeeCode"
                                data-department="@record.Department"
                                data-action-type="@record.DiscpActionType"
                                data-status="@status"
                                data-warning-type="@record.WarningType"
                                data-warning-action="@record.WarningAction">

                                <td class="text-center">
                                    <input type="checkbox"
                                           class="da-row-select"
                                           aria-label="Select @record.DocumentNo" />
                                </td>

                                <td class="da-serial">@(i + 1)</td>
                                <td>@record.DocumentNo</td>
                                <td>@record.Date.ToString("dd-MM-yyyy")</td>
                                <td>@record.EmployeeCode</td>
                                <td>@record.EmployeeName</td>
                                <td>@record.Department</td>
                                <td>@record.DiscpActionType</td>
                                <td>
    @{
        var approvalStatus = record.ApprovalStatus ?? "Pending";

        var approvalBadgeClass =
            approvalStatus.Equals("Approved", StringComparison.OrdinalIgnoreCase)
                ? "badge-success"
                : approvalStatus.Equals("Rejected", StringComparison.OrdinalIgnoreCase)
                    ? "badge-danger"
                    : "badge-warning";
    }

    <span class="badge @approvalBadgeClass da-status-badge">
        @approvalStatus
    </span>
</td>
                                <td>
                                    <span class="da-status-badge"
                                          data-status="@status">
                                        @status
                                    </span>
                                </td>

                                <td>@record.WarningType</td>
                                <td>@record.WarningAction</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div id="daEmptyMessage" class="da-empty" style="display:none">
                <i class="fas fa-inbox fa-2x mb-2"></i>
                <p>No disciplinary action records match your search or filters.</p>
            </div>

            <!-- TABLE FOOTER -->
            <div class="da-table-footer">
                <div id="daShowing">Showing 0 records</div>

                <div class="da-pagination">
                    <button type="button" class="btn btn-light btn-sm"
                            id="daPrevious">Previous</button>

                    <span id="daPageInfo">1 / 1</span>

                    <button type="button" class="btn btn-light btn-sm"
                            id="daNext">Next</button>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="daDeleteConfirmModal" tabindex="-1"
     role="dialog" aria-labelledby="daDeleteConfirmTitle" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="daDeleteConfirmTitle">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    Confirm Delete
                </h5>

                <button type="button" class="close text-white"
                        data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                Are you sure you want to delete the selected disciplinary action?
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm"
                        data-dismiss="modal">Cancel</button>

                <button type="button" class="btn btn-danger btn-sm"
                        id="daConfirmDelete">
                    <i class="fas fa-trash mr-1"></i> Delete
                </button>
            </div>

        </div>
    </div>
</div>

<!-- DELETE POST -->
<form id="daDeleteForm"
      action="@Url.Content("~/Master/DisciplinaryAction/Delete")"
      method="post"
      style="display:none">
    @Html.AntiForgeryToken()
    <input type="hidden" id="daDeleteDocumentNo" name="documentNo" />
</form>

