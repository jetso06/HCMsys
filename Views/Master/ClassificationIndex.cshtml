    }

    #ciTable thead th {
        padding: 10px 8px;
        background: #4e73df;
        color: #fff;
        border-color: #3d5cbe;
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .04em;
        vertical-align: middle;
    }

    #ciTable tbody td {
        padding: 8px;
        color: #5a5c69;
        font-size: .8rem;
        vertical-align: middle;
    }

    #ciTable tbody tr:hover {
        background-color: #f3f6ff;
    }

    .ci-row-edit,
    .ci-row-delete {
        border: none;
        background: transparent;
        padding: 4px 7px;
        cursor: pointer;
        font-size: .9rem;
    }

    .ci-row-edit { color: #4e73df; }
    .ci-row-delete { color: #e74a3b; }

    .ci-checkbox {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .ci-action-column {
        text-align: center;
        min-width: 85px;
    }

    #ciTable tbody tr.selected {
        background-color: #eaecf4;
    }

    .ci-empty {
        padding: 24px !important;
        color: #858796;
        text-align: center !important;
    }

    .ci-table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 14px;
        color: #858796;
        font-size: .8rem;
    }

    .ci-pagination {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-pagination .btn {
        border: 1px solid #e3e6f0;
        background: #fff;
        color: #5a5c69;
    }

    .ci-pagination .btn:disabled {
        opacity: .45;
        cursor: not-allowed;
    }

    @@media (max-width: 768px) {
        .ci-toolbar {
            align-items: flex-start;
        }

        .ci-buttons {
            width: 100%;
        }

        .ci-search {
            width: 100%;
        }
    }

    /* Classification table: fixed and compact column layout */
#ciTable {
    width: 100%;
    table-layout: fixed;
    margin-bottom: 0;
}

/* Center Select heading and checkboxes */
#ciTable th:first-child,
#ciTable td:first-child {
    width: 55px;
    min-width: 55px;
    text-align: center !important;
    vertical-align: middle;
}

/* Action column */
#ciTable th:nth-child(2),
#ciTable td:nth-child(2) {
    width: 90px;
    text-align: center;
}

/* Regular data columns */
#ciTable th:nth-child(3),
#ciTable td:nth-child(3) {
    width: 125px;
}

#ciTable th:nth-child(4),
#ciTable td:nth-child(4) {
    width: 85px;
}

#ciTable th:nth-child(5),
#ciTable td:nth-child(5) {
    width: 110px;
}

#ciTable th:nth-child(6),
#ciTable td:nth-child(6) {
    width: 135px;
}

/* Compact Group, Active and Approval columns */
#ciTable th:nth-child(7),
#ciTable td:nth-child(7),
#ciTable th:nth-child(8),
#ciTable td:nth-child(8) {
    width: 60px;
    text-align: center;
}

#ciTable th:nth-child(9),
#ciTable td:nth-child(9) {
    width: 70px;
    text-align: center;
}

/* Remaining columns */
#ciTable th:nth-child(10),
#ciTable td:nth-child(10) {
    width: 50px;
}

#ciTable th:nth-child(11),
#ciTable td:nth-child(11) {
    width: 95px;
}

#ciTable th:nth-child(12),
#ciTable td:nth-child(12) {
    width: 140px;
}

#ciTable th:nth-child(13),
#ciTable td:nth-child(13) {
    width: 95px;
}

#ciTable th:nth-child(14),
#ciTable td:nth-child(14) {
    width: 140px;
}

/* Keep cell contents tidy */
#ciTable th,
#ciTable td {
    box-sizing: border-box;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

    @@media print {
        .ci-buttons,
        .ci-table-tools,
        .ci-table-footer,
        .ci-control-column,
        .ci-action-column {
            display: none !important;
        }

        .candidate-index .ci-card {
            box-shadow: none !important;
        }
    }
</style>

<script>
    (() => {
        const body = document.getElementById("ciTableBody");
        const searchInput = document.getElementById("ciSearch");
        const pageSizeInput = document.getElementById("ciPageSize");
        const selectAllCheckbox = document.getElementById("ciSelectAll");

        const rows = Array.from(body.querySelectorAll("tr[data-id]"));

        let selectedId = null;
        let filteredRows = rows.slice();
        let currentPage = 1;

        function updateSelection() {
            const selected = body.querySelectorAll(".ci-checkbox:checked");

            const selectedInFiltered = filteredRows.filter(row =>
    row.querySelector(".ci-checkbox")?.checked
).length;

selectAllCheckbox.checked =
    filteredRows.length > 0 &&
    selectedInFiltered === filteredRows.length;

selectAllCheckbox.indeterminate =
    selectedInFiltered > 0 &&
    selectedInFiltered < filteredRows.length;

            selectedId = selected.length === 1 ? selected[0].value : null;

            const names = Array.from(selected).map(checkbox => {
                const row = checkbox.closest("tr");
                const firstDataCell = row.cells[2];
                return firstDataCell?.textContent.trim() || checkbox.value;
            });

            body.querySelectorAll("tr[data-id]").forEach(row => {
                row.classList.toggle(
                    "selected",
                    row.querySelector(".ci-checkbox")?.checked === true
                );
            });

            document.getElementById("ciSelected").textContent =
                names.length ? names.join(", ") : "None";

            document.querySelector('[data-action="edit"]')?.toggleAttribute(
                "disabled", !selectedId
            );

            document.querySelector('[data-action="clone"]')?.toggleAttribute(
                "disabled", !selectedId
            );

            document.querySelector('[data-action="delete"]')?.toggleAttribute(
                "disabled", selected.length === 0
            );

            document.querySelector('[data-action="save"]')?.toggleAttribute(
                "disabled", true
            );
        }

        function renderRows() {
            const pageSize = Number(pageSizeInput.value);
            const totalPages = Math.max(
                1,
                Math.ceil(filteredRows.length / pageSize)
            );

            currentPage = Math.min(currentPage, totalPages);

            rows.forEach(row => row.hidden = true);

            const start = (currentPage - 1) * pageSize;
            const visibleRows = filteredRows.slice(start, start + pageSize);

            visibleRows.forEach(row => row.hidden = false);

            document.getElementById("ciDisplayed").textContent =
                filteredRows.length;

            document.getElementById("ciRecordCount").textContent =
                `${filteredRows.length} Records`;

            document.getElementById("ciShowing").textContent =
                filteredRows.length
                    ? `Showing ${start + 1} to ${start + visibleRows.length} of ${filteredRows.length} classifications`
                    : "Showing 0 classifications";

            document.getElementById("ciPageInfo").textContent =
                filteredRows.length
                    ? `${currentPage} / ${totalPages}`
                    : "0 / 0";

            document.getElementById("ciPrevious").disabled =
                currentPage <= 1;

            document.getElementById("ciNext").disabled =
                currentPage >= totalPages;
        }

        function filterRows() {
            const query = searchInput.value.trim().toLowerCase();

            filteredRows = rows.filter(row =>
                row.innerText.toLowerCase().includes(query)
            );

            currentPage = 1;
            renderRows();
        }

        function editRecord(id) {
            if (!id) {
                alert("Please select a classification.");
                return;
            }

            window.location.href =
                "/Master/Classification?id=" + encodeURIComponent(id);
        }

        function deleteRecord(id) {
            if (!id) {
                alert("Please select a classification.");
                return;
            }

            if (!confirm("Are you sure you want to delete this classification?")) {
                return;
            }

            const form = document.createElement("form");
            form.method = "POST";
            form.action = "/Master/Classification/Delete/" + encodeURIComponent(id);

            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

            if (token) {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "__RequestVerificationToken";
                input.value = token.value;
                form.appendChild(input);
            }

            document.body.appendChild(form);
            form.submit();
        }
        selectAllCheckbox.addEventListener("change", function () {
    filteredRows.forEach(row => {
        const checkbox = row.querySelector(".ci-checkbox");

        if (checkbox) {
            checkbox.checked = this.checked;
        }
    });

    updateSelection();
});
        rows.forEach(row => {
            row.querySelector(".ci-checkbox")?.addEventListener(
                "change", updateSelection
            );

            row.addEventListener("click", event => {
                if (event.target.closest(
                    ".ci-row-edit, .ci-row-delete, .ci-checkbox"
                )) return;

                const checkbox = row.querySelector(".ci-checkbox");
                checkbox.checked = !checkbox.checked;
                updateSelection();
            });
        });

        body.addEventListener("click", event => {
            const edit = event.target.closest(".ci-row-edit");
            const del = event.target.closest(".ci-row-delete");

            if (!edit && !del) return;

            const row = event.target.closest("tr[data-id]");
            if (!row) return;

            if (edit) editRecord(row.dataset.id);
            if (del) deleteRecord(row.dataset.id);
        });

        document.querySelector(".ci-buttons").addEventListener(
            "click", event => {
                const button = event.target.closest("[data-action]");
                if (!button || button.disabled) return;

                const action = button.dataset.action;

                switch (action) {
                    case "new":
                        window.location.href = "/Master/Classification";
                        break;

                    case "edit":
                        editRecord(selectedId);
                        break;

                    case "clone":
                        if (selectedId) {
                            window.location.href =
                                "/Master/Classification?id=" +
                                encodeURIComponent(selectedId) + "&clone=true";
                        }
                        break;

                    case "delete": {
                        const selected = Array.from(
                            body.querySelectorAll(".ci-checkbox:checked")
                        );

                        if (selected.length === 1) {
                            deleteRecord(selected[0].value);
                        } else if (selected.length > 1) {
                            alert("Multiple selection requires the DeleteSelected action.");
                        } else {
                            alert("Please select a classification.");
                        }
                        break;
                    }

                    case "print":
                        window.print();
                        break;

                    case "close":
                        window.location.href = "/Home/Index";
                        break;

                    case "save":
                    case "unpost":
                    case "approve":
                    case "reject":
                    case "authtracker":
                        alert("This action is not connected to the backend yet.");
                        break;
                }
            }
        );

        searchInput.addEventListener("input", filterRows);

        pageSizeInput.addEventListener("change", () => {
            currentPage = 1;
            renderRows();
        });

        document.getElementById("ciPrevious").addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage--;
                renderRows();
            }
        });

        document.getElementById("ciNext").addEventListener("click", () => {
            const totalPages = Math.max(
                1,
                Math.ceil(filteredRows.length / Number(pageSizeInput.value))
            );

            if (currentPage < totalPages) {
                currentPage++;
                renderRows();
            }
        });

        updateSelection();
        renderRows();
    })();
</script>

<form id="classificationAntiForgery" hidden>
    @Html.AntiForgeryToken()
</form>