    }

    .ci-summary-label {
    margin-bottom: 4px;
    font-size: .7rem;
    font-weight: 800;
    text-transform: uppercase;
}

/* Match each card heading with its border color */
.ci-border-primary .ci-summary-label {
    color: #4e73df;
}

.ci-border-info .ci-summary-label {
    color: #36b9cc;
}

.ci-border-success .ci-summary-label {
    color: #1cc88a;
}

.ci-border-warning .ci-summary-label {
    color: #f6c23e;
}

    .ci-summary-value,
    .ci-summary-module {
        color: #5a5c69;
        font-size: 1.05rem;
        font-weight: 800;
    }

    #ciSelected {
        font-size: .9rem;
    }

    .ci-summary-icon {
        position: absolute;
        top: 22px;
        right: 16px;
        color: #dddfeb;
        font-size: 1.5rem;
    }

    .ci-border-primary { border-left: 4px solid #4e73df !important; }
    .ci-border-warning { border-left: 4px solid #f6c23e !important; }
    .ci-border-success { border-left: 4px solid #1cc88a !important; }
    .ci-border-info { border-left: 4px solid #36b9cc !important; }

    .ci-records-card {
        margin-bottom: 20px;
    }

    .ci-records-header h6 {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: #4e73df;
        font-size: .9rem;
        font-weight: 800;
    }

    .ci-records-header .badge {
        padding: 5px 8px;
        font-size: .7rem;
    }

    .ci-records-card .card-body {
        padding: 16px;
    }

    .ci-table-tools {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }

    .ci-page-size {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-page-size select {
        width: 60px;
    }

    .ci-search {
        width: 320px;
        max-width: 100%;
    }

    .candidate-index .form-control {
        min-height: 32px;
        border: 1px solid #d2d0cb;
        border-radius: 5px;
        color: #5a5c69;
