@model HCMSys.Controllers.SectorMasterIndexViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cfg=Model.Config;
    var cols=cfg.Index.Columns.Where(c=>c.Visible).ToList();
    string Val(HCMSys.Controllers.SectorMasterRecord r,string f)=>r.GetType().GetProperty(char.ToUpperInvariant(f[0])+f.Substring(1))?.GetValue(r)?.ToString()??"";
}
<style>
.si-page{padding:0 15px 24px;color:#5a5c69;font:13px -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
.si-card{background:#fff;border:1px solid #e3e6f0;border-radius:.35rem;box-shadow:0 .15rem 1rem rgba(58,59,69,.10);overflow:hidden}
.si-head{padding:13px 18px;background:#f8f9fc;border-bottom:1px solid #e3e6f0;font-weight:800;color:#4e73df}
.si-toolbar{display:flex;flex-wrap:wrap;gap:7px;justify-content:flex-end;padding:12px 0}
.si-table{width:100%;border-collapse:collapse}.si-table th{background:#4e73df;color:#fff;padding:11px 9px;text-align:left;font-size:11px;text-transform:uppercase;white-space:nowrap}.si-table td{padding:10px 9px;border:1px solid #e3e6f0}.si-table tr:nth-child(even){background:#f8f9fc}
.si-tools{display:flex;gap:5px}.si-tools a{display:inline-block;padding:5px 8px;border-radius:4px;background:#4e73df;color:white}
.si-controls{display:flex;justify-content:space-between;gap:12px;padding:12px 16px}.si-controls input{max-width:300px;border:1px solid #d1d3e2;border-radius:4px;padding:7px 10px}
</style>
<div class="si-page">
 <div class="si-toolbar">
 @foreach(var b in cfg.Buttons.Index.Where(x=>x.Visible)){
   if(b.Action=="new"){<a class="btn btn-@b.Style" href="/Master/SectorMaster"><i class="fas @b.Icon"></i> @b.Text</a>}
   else if(b.Action=="home"){<a class="btn btn-@b.Style" href="/Home/Index"><i class="fas @b.Icon"></i> @b.Text</a>}
   else if(b.Action=="close"){<a class="btn btn-@b.Style" href="/Home/Index"><i class="fas @b.Icon"></i> @b.Text</a>}
   else {<button type="button" class="btn btn-@b.Style" data-action="@b.Action"><i class="fas @b.Icon"></i> @b.Text</button>}
 }
 </div>
 <div class="si-card">
  <div class="si-head"><i class="fas fa-table"></i> @cfg.Index.Heading <span style="float:right">@Model.Records.Count Records</span></div>
  <div class="si-controls"><span>Sector Master records</span><input id="tableSearch" type="search" placeholder="Search sector master records..."/></div>
  <div style="overflow-x:auto">
   <table class="si-table" id="sectorTable">
    <thead><tr><th style="width:55px;text-align:center"><input type="checkbox" id="selectAll"/></th><th>Action</th>@foreach(var c in cols){<th>@c.Label</th>}</tr></thead>
    <tbody>
    @foreach(var r in Model.Records){
      <tr data-id="@r.Id"><td style="text-align:center"><input type="checkbox" class="record-select"/></td><td><div class="si-tools"><a title="Edit" href="/Master/SectorMaster?id=@r.Id"><i class="fas fa-edit"></i></a><a title="Clone" href="/Master/SectorMaster?id=@r.Id&clone=true"><i class="fas fa-copy"></i></a></div></td>
      @foreach(var c in cols){<td>@Val(r,c.Field)</td>}</tr>
    }
    @if(!Model.Records.Any()){<tr><td colspan="@(cols.Count+2)" style="text-align:center;padding:25px">No Sector Master records found.</td></tr>}
    </tbody>
   </table>
  </div>
 </div>
</div>
<script>
(()=>{
 const search=document.getElementById('tableSearch');
 search?.addEventListener('input',()=>{const q=search.value.toLowerCase();document.querySelectorAll('#sectorTable tbody tr[data-id]').forEach(r=>r.hidden=!r.innerText.toLowerCase().includes(q));});
 const all=document.getElementById('selectAll');
 all?.addEventListener('change',()=>document.querySelectorAll('.record-select').forEach(x=>x.checked=all.checked));
 document.querySelectorAll('.si-toolbar [data-action]').forEach(b=>b.addEventListener('click',()=>{
   const selected=[...document.querySelectorAll('.record-select:checked')].map(x=>x.closest('tr').dataset.id);
   const a=b.dataset.action;
   if(a==='edit'||a==='clone'){if(selected.length!==1){alert('Select one record.');return;}location.href='/Master/SectorMaster?id='+selected[0]+(a==='clone'?'&clone=true':'');}
   else if(a==='delete'){if(selected.length!==1){alert('Select one record.');return;}if(confirm('Delete selected record?')){const f=document.createElement('form');f.method='post';f.action='/Master/SectorMaster/Delete/'+selected[0];const token=document.querySelector('input[name="__RequestVerificationToken"]');if(token){const h=document.createElement('input');h.type='hidden';h.name=token.name;h.value=token.value;f.appendChild(h);}document.body.appendChild(f);f.submit();}}
   else if(a==='print')window.print();
   else if(['approve','reject','authtracker'].includes(a))alert(a+' is not connected to a workflow yet.');
 }));
})();
</script>
