@section Scripts {
    <script>
        let daAttachmentCounter = 0;
let daAttachmentConfig = null;

async function daLoadAttachments() {
    const head = document.getElementById("daAttachmentsHead");
    const body = document.getElementById("daAttachmentsBody");
    const hidden = document.getElementById("daAttachmentsJson");

    try {
        const configUrl =
            '@Url.Content("~/data/DisciplinaryAction/attachment-config.json")';

                const response = await fetch(configUrl, {
            cache: "no-store"
        });

        if (!response.ok) {
            throw new Error("Unable to load attachment configuration.");
        }

                daAttachmentConfig = await response.json();

        if (!Array.isArray(daAttachmentConfig.headers) ||
            daAttachmentConfig.headers.length === 0) {
            throw new Error(
                "attachment-config.json has no valid headers."
            );
        }

        const headers = daAttachmentConfig.headers;

        head.innerHTML = "";
        body.innerHTML = "";

        const headerRow = document.createElement("tr");

        headers.forEach(header => {
            const th = document.createElement("th");
            th.textContent = header.title;
            headerRow.appendChild(th);
        });
                const actionHeader = document.createElement("th");
        actionHeader.textContent = "Action";
        headerRow.appendChild(actionHeader);

        head.appendChild(headerRow);

        document.getElementById("daAttachmentsTitle").textContent =
            "Attachments";

        document.getElementById("daAddAttachmentLabel").textContent =
            "Add Attachment";

        document.getElementById("daAttachmentsHelp").textContent =
            "Add supporting documents and enter their details.";

        let records = [];

        try {
            records = JSON.parse(hidden.value || "[]");
        } catch {
            records = [];
        }

        daAttachmentCounter = 0;

        if (records.length > 0) {
            records.forEach(item => daAddAttachmentRow(item));
        } else {
            daAddAttachmentRow();
        }

    } catch (error) {
        console.error(error);

        head.innerHTML = "";
        body.innerHTML = "";

        const row = document.createElement("tr");
        const cell = document.createElement("td");

                cell.colSpan = Math.max(
            (daAttachmentConfig?.headers?.length || 0) + 1,
            1
        );
        cell.className = "text-center text-danger";
                cell.textContent =
            error.message || "Unable to load attachment configuration.";

        row.appendChild(cell);
                // ACTION column - delete button
        const actionCell = document.createElement("td");
        actionCell.className = "text-center align-middle";

        const removeButton = document.createElement("button");
        removeButton.type = "button";
        removeButton.className = "btn btn-danger btn-sm";
        removeButton.title = "Delete attachment";
        removeButton.innerHTML = '<i class="fas fa-trash"></i>';

        removeButton.addEventListener("click", function () {
            row.remove();
            daSyncAttachments();
        });

        actionCell.appendChild(removeButton);
        row.appendChild(actionCell);
        body.appendChild(row);
    }
}


function daAddAttachmentRow(item = {}) {
    if (!daAttachmentConfig) return;

    const body = document.getElementById("daAttachmentsBody");
    const row = document.createElement("tr");

    row.dataset.rowId = daAttachmentCounter++;

    (daAttachmentConfig.headers || []).forEach(header => {
        const cell = document.createElement("td");
        const field = header.field;
        const type = header.type;

                if (type === "show") {
            const showButton = document.createElement("button");

            showButton.type = "button";
            showButton.className = "btn btn-info btn-sm da-show";
            showButton.innerHTML = '<i class="fas fa-eye"></i> Show';
            showButton.dataset.shown = item[field] === true ? "true" : "false";

            showButton.addEventListener("click", function () {
                const isShown = this.dataset.shown === "true";
                this.dataset.shown = isShown ? "false" : "true";
            });

            cell.className = "text-center";
            cell.appendChild(showButton);
        } else if (type === "select") {
            const select = document.createElement("select");

            select.className = `form-control da-${field}`;

            const placeholder = document.createElement("option");
            placeholder.value = "";
            placeholder.textContent = "-- Select --";
            select.appendChild(placeholder);

            (header.options || []).forEach(optionValue => {
                const option = document.createElement("option");
                option.value = optionValue;
                option.textContent = optionValue;
                select.appendChild(option);
            });

            select.value = item[field] || "";
            cell.appendChild(select);

        } else if (type === "text") {
            const input = document.createElement("input");

            input.type = "text";
            input.className = `form-control da-${field}`;
            input.value = item[field] || "";

            cell.appendChild(input);

                } else if (type === "file") {
            const fileWrapper = document.createElement("div");
            fileWrapper.className = "da-file-wrapper";

            const input = document.createElement("input");
            input.type = "file";
            input.className = `da-${field}-input`;

            const fileName = document.createElement("span");
            fileName.className = "da-file-name small text-muted";
            fileName.textContent = item[field] || "";

            // First delete button: clear only the selected file.
            const clearFileButton = document.createElement("button");
            clearFileButton.type = "button";
            clearFileButton.className = "btn btn-danger btn-sm da-clear-file";
            clearFileButton.title = "Remove selected file";
            clearFileButton.innerHTML = '<i class="fas fa-trash"></i>';

            input.addEventListener("change", function () {
                fileName.textContent = this.files.length
                    ? this.files[0].name
                    : "";
            });

            clearFileButton.addEventListener("click", function () {
                input.value = "";
                fileName.textContent = "";
                daSyncAttachments();
            });

            fileWrapper.append(input, clearFileButton);
            cell.append(fileWrapper, fileName);
        }else if (type === "dateToggle") {
            const dateField = header.dateField;
            const wrapper = document.createElement("div");

            wrapper.className = "da-date-control";

            const checkbox = document.createElement("input");
            checkbox.type = "checkbox";
            checkbox.className = `da-${field}`;
            checkbox.checked = item[field] === true;

            const date = document.createElement("input");
            date.type = "date";
            date.className = `form-control da-${dateField}`;
            date.value = item[dateField] || "";
date.disabled = !checkbox.checked;

checkbox.addEventListener("change", () => {
                date.disabled = !checkbox.checked;

                if (!checkbox.checked) {
                    date.value = "";
                }
            });

            wrapper.append(checkbox, date);
            cell.className = "da-date-cell";
            cell.appendChild(wrapper);
        }

        row.appendChild(cell);
    });

                   // Second delete button: delete the entire attachment row.
        const actionCell = document.createElement("td");
        actionCell.className = "text-center align-middle";

        const deleteRowButton = document.createElement("button");
        deleteRowButton.type = "button";
        deleteRowButton.className = "btn btn-danger btn-sm da-delete-row";
        deleteRowButton.title = "Delete attachment row";
        deleteRowButton.innerHTML = '<i class="fas fa-trash"></i>';

        deleteRowButton.addEventListener("click", function () {
            row.remove();
            daSyncAttachments();
        });

        actionCell.appendChild(deleteRowButton);
        row.appendChild(actionCell);

        body.appendChild(row);

    body.appendChild(row);

    daUpdateExpiryControls(row);
}


function daUpdateExpiryControls(row) {
    const trackExpiry = row.querySelector(".da-trackExpiry");
    const enabled = row.querySelector(".da-expiryDateEnabled");
    const date = row.querySelector(".da-expiryDate");

    if (!trackExpiry || !enabled || !date) return;

    enabled.disabled = !trackExpiry.checked;

    if (!trackExpiry.checked) {
        enabled.checked = false;
        date.value = "";
    }

    date.disabled = !trackExpiry.checked || !enabled.checked;
}


// Copy the attachment grid values into the hidden form field.
        function daSyncAttachments() {
            const hidden = document.getElementById("daAttachmentsJson");

            if (!daAttachmentConfig || !hidden) {
                return;
            }

            const rows = document.querySelectorAll("#daAttachmentsBody tr");

    const attachments = [];

    rows.forEach(row => {
        const item = {};

        (daAttachmentConfig.headers || []).forEach(header => {
            const field = header.field;
            const type = header.type;

                    if (type === "show") {
            const button = row.querySelector(".da-show");
            item[field] = button?.dataset.shown === "true";

        } else if (type === "checkbox") {
            const checkbox = row.querySelector(`.da-${field}`);
            item[field] = checkbox ? checkbox.checked : false;

            } else if (type === "select" || type === "text") {
                const input = row.querySelector(`.da-${field}`);
                item[field] = input ? input.value : "";

            } else if (type === "file") {
                const fileInput = row.querySelector(`.da-${field}-input`);
                const fileName = row.querySelector(".da-file-name");

                item[field] = fileInput?.files?.length
                    ? fileInput.files[0].name
                    : (fileName?.textContent || "");

            } else if (type === "dateToggle") {
                const checkbox = row.querySelector(`.da-${field}`);
                const date = row.querySelector(`.da-${header.dateField}`);

                item[field] = checkbox ? checkbox.checked : false;
                item[header.dateField] = date ? date.value : "";
            }
        });

        attachments.push(item);
    });

    hidden.value = JSON.stringify(attachments);
}


        
        function daUpdateClosingComments() {
            const status = document.getElementById("daHrStatus");
            const group = document.getElementById("daClosingCommentsGroup");
            const comments = document.getElementById("daClosingComments");

            const isClosed =
                status.value.trim().toLowerCase() === "closed";

            group.hidden = !isClosed;
            comments.required = isClosed;

            if (!isClosed) {
                comments.value = "";
            }
        }

                async function daLoadFormLabels() {
            const response = await fetch(
                '@Url.Content("~/data/DisciplinaryAction/disciplinary-action-config.json")'
            );

            if (!response.ok) {
                throw new Error("Unable to load disciplinary action configuration.");
            }

            const config = await response.json();

            document.getElementById("daClosingCommentsLabel").textContent =
                config.labels.closingComments;
        }

        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("daForm");
            form.addEventListener("submit", function () {
    daSyncAttachments();
});
            const employeeSelect = document.getElementById("daEmployeeSelect");
            const departmentInput = document.getElementById("daDepartment");
            const formStatus = document.getElementById("daFormStatus");
            const hrStatus = document.getElementById("daHrStatus");

                hrStatus.addEventListener("change", daUpdateClosingComments);
                daUpdateClosingComments();

            daLoadAttachments();
            daLoadFormLabels().catch(console.error);

            document.getElementById("daAddAttachmentButton")
            .addEventListener("click", () => daAddAttachmentRow());

            function updateEmployeeDetails() {
                const selected = employeeSelect.options[employeeSelect.selectedIndex];
                departmentInput.value = selected?.dataset.department || "";
            }

                    function resetForm() {
            form.reset();

            // Clear the attachment grid.
            const attachmentBody =
                document.getElementById("daAttachmentsBody");

            attachmentBody.innerHTML = "";

            if (daAttachmentConfig) {
                daAddAttachmentRow();
                daSyncAttachments();
            }

            formStatus.textContent = "New Disciplinary Action";

            updateEmployeeDetails();
            daUpdateClosingComments();
        }

            employeeSelect.addEventListener("change", updateEmployeeDetails);

            document.getElementById("daNew").addEventListener("click", function () {
                if (confirm("Clear the current form and start a new disciplinary action?")) {
                    resetForm();
                }
            });

            document.getElementById("daEdit").addEventListener("click", function () {
                formStatus.textContent = "Editing Disciplinary Action";
                alert("Open a saved record from the Disciplinary Action Index to edit it.");
            });

            document.getElementById("daClone").addEventListener("click", function () {
                if (confirm("Create a new record using the current values?")) {
                    form.querySelector('[name="Form.DocumentNo"]').value = "";
                    formStatus.textContent = "New Disciplinary Action (Clone)";
                }
            });

            document.getElementById("daPrint").addEventListener("click", function () {
                window.print();
            });

            document.getElementById("daClose").addEventListener("click", function () {
                window.location.href = '@Url.Content("~/Master/DisciplinaryActionIndex")';
            });

            updateEmployeeDetails();
        });
    </script>
}
