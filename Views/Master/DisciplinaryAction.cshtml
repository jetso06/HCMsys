
@model HCMSys.Controllers.DisciplinaryActionViewModel

@{
    ViewData["Title"] = "Disciplinary Action";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid da-page">

    <!-- Header and toolbar -->
    <div class="card shadow mb-3">
        <div class="card-header da-header">
            <h6 class="da-title">
                <i class="fas fa-gavel mr-2"></i>
                DISCIPLINARY ACTION
                <span class="da-module-badge">502</span>
            </h6>

            <div class="da-actions">
                <button type="button" class="btn btn-success btn-sm" id="daNew">
                    <i class="fas fa-plus mr-1"></i> New
                </button>

                <button type="button" class="btn btn-primary btn-sm" id="daEdit">
                    <i class="fas fa-edit mr-1"></i> Edit
                </button>

                <button type="submit" form="daForm" class="btn btn-primary btn-sm">
                    <i class="fas fa-save mr-1"></i> Save
                </button>

                <button type="button" class="btn btn-info btn-sm" id="daClone">
                    <i class="fas fa-copy mr-1"></i> Clone
                </button>

                <button type="button" class="btn btn-warning btn-sm" id="daUnPost" disabled>
                    <i class="fas fa-undo mr-1"></i> UnPost
                </button>

                <button type="button" class="btn btn-secondary btn-sm" id="daPrint">
                    <i class="fas fa-print mr-1"></i> Print
                </button>

                <button type="button" class="btn btn-danger btn-sm" id="daDelete" disabled>
                    <i class="fas fa-trash mr-1"></i> Delete
                </button>

                <button type="button" class="btn btn-success btn-sm" id="daApprove" disabled>
                    <i class="fas fa-check mr-1"></i> Approve
                </button>

                <button type="button" class="btn btn-danger btn-sm" id="daReject" disabled>
                    <i class="fas fa-times mr-1"></i> Reject
                </button>

                <button type="button" class="btn btn-info btn-sm" id="daAuthTracker" disabled>
                    <i class="fas fa-route mr-1"></i> Auth Tracker
                </button>

                <button type="button" class="btn btn-secondary btn-sm" id="daClose">
                    <i class="fas fa-times-circle mr-1"></i> Close
                </button>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div asp-validation-summary="All"
         class="text-danger small mb-3"></div>

    <!-- Disciplinary Action details -->
    <div class="card shadow mb-3">
        <div class="card-header da-section-header">
            <h6><i class="fas fa-file-alt mr-2"></i> Disciplinary Action Details</h6>
            <span id="daFormStatus">New Disciplinary Action</span>
        </div>

        <div class="card-body">
            <form id="daForm"
                  action="@Url.Content("~/Master/DisciplinaryAction/Save")"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="form-row">

                    <!-- Row 1 -->
                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.DocumentNo">
                            Document No. <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Form.DocumentNo"
                               class="form-control"
                               maxlength="@Model.Config.Validation.DocumentNoMaxLength"
                               required />
                    </div>

                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.Date">
                            Date <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Form.Date" type="date"
                               class="form-control" required />
                    </div>

                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.PostDate">PostDate</label>
                        <input asp-for="Form.PostDate"
                               type="datetime-local"
                               class="form-control" />
                    </div>

                    <!-- Row 2 -->
                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.EmployeeId">
                            Employee <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Form.EmployeeId"
                                id="daEmployeeSelect"
                                class="form-control"
                                required>
                            <option value="">-- Select Employee --</option>
                            @foreach (var employee in Model.Employees)
                            {
                                <option value="@employee.Id"
                                        data-code="@employee.Code"
                                        data-department="@employee.Department">
                                    @employee.Name (@employee.Code)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.Designation">Designation</label>
                        <input asp-for="Form.Designation"
                               class="form-control"
                               maxlength="@Model.Config.Validation.DesignationMaxLength"
                               readonly />
                    </div>

                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.Department">Department</label>
                        <input asp-for="Form.Department"
                               id="daDepartment"
                               class="form-control"
                               maxlength="@Model.Config.Validation.DepartmentMaxLength"
                               readonly />
                    </div>

                    <!-- Row 3 -->
                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.ReportingManager">Reporting Manager</label>
                        <input asp-for="Form.ReportingManager"
                               class="form-control"
                               maxlength="@Model.Config.Validation.ReportingManagerMaxLength"
                               readonly />
                    </div>

                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.DiscpActionType">Discp. Action Type</label>
                        <input asp-for="Form.DiscpActionType"
                               class="form-control"
                               maxlength="@Model.Config.Validation.DisciplinaryActionTypeMaxLength" />
                    </div>

                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.IncidentDateTime">Incident Date &amp; Time</label>
                        <input asp-for="Form.IncidentDateTime"
                               type="datetime-local"
                               class="form-control" />
                    </div>

                    <!-- Row 4 -->
                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.IncidentLocation">Incident Location</label>
                        <input asp-for="Form.IncidentLocation"
                               class="form-control"
                               maxlength="@Model.Config.Validation.IncidentLocationMaxLength" />
                    </div>

                    <!-- Comments -->
                    <div class="form-group col-12" id="daCommentsGroup">
                        <label asp-for="Form.Comments">Comments</label>
                        <textarea asp-for="Form.Comments"
                                  class="form-control da-textarea"
                                  maxlength="@Model.Config.Validation.CommentsMaxLength"></textarea>
                    </div>

                    
                    <!-- HR Status -->
                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.HrStatus">
                            HR Status <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Form.HrStatus"
                                id="daHrStatus"
                                class="form-control"
                                required>
                            @foreach (var option in Model.Config.Options.HrStatus)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <!-- Closing Comments: visible and mandatory when Closed -->
                    <div class="form-group col-12" id="daClosingCommentsGroup" hidden>
                        <label asp-for="Form.ClosingComments">
                            <span id="daClosingCommentsLabel"></span>
                            <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Form.ClosingComments"
                                  id="daClosingComments"
                                  class="form-control da-textarea"
                                  maxlength="200"></textarea>
                    </div>

                    <!-- Warning Type -->
                    <div class="form-group col-xl-4 col-md-6">
                        <label asp-for="Form.WarningType">Warning Type</label>
                        <select asp-for="Form.WarningType" class="form-control">
                            <option value="">-- Select Warning Type --</option>
                            @foreach (var option in Model.Config.Options.WarningType)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                                     
                    <!-- Warning Action -->
                    <div class="form-group col-xl-6 col-md-12">
                        <label asp-for="Form.WarningAction">Warning Action</label>
                        <select asp-for="Form.WarningAction" class="form-control">
                            <option value="">-- Select Warning Action --</option>
                            @foreach (var option in Model.Config.Options.WarningAction)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>

                    <!-- Warning Comments -->
                    <div class="form-group col-12">
                        <label asp-for="Form.WarningComments">Warning Comments</label>
                        <textarea asp-for="Form.WarningComments"
                                  class="form-control da-textarea"
                                  maxlength="@Model.Config.Validation.WarningCommentsMaxLength"></textarea>
                    </div>


                </div>
                <input type="hidden"
                       id="daAttachmentsJson"
                       name="Form.AttachmentsJson"
                       value='@System.Text.Json.JsonSerializer.Serialize(
                           Model.Form.Attachments,
                           new System.Text.Json.JsonSerializerOptions(
                               System.Text.Json.JsonSerializerDefaults.Web))' />
            </form>
        </div>
    </div>

    
    <!-- Attachments -->
    <div class="card shadow mb-3">
        <div class="card-header da-section-header">
            <h6 id="daAttachmentsTitle"></h6>

            <button type="button"
                    class="btn btn-primary btn-sm"
                    id="daAddAttachmentButton">
                <i class="fas fa-plus mr-1"></i>
                <span id="daAddAttachmentLabel"></span>
            </button>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover da-attachment-table">
                    <thead id="daAttachmentsHead"></thead>
                    <tbody id="daAttachmentsBody"></tbody>
                </table>
            </div>

            <small class="text-muted" id="daAttachmentsHelp"></small>
        </div>
    </div>


</div>

