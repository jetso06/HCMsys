
@model HCMSys.Controllers.SectorMasterViewModel
@using System.Collections
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Sector Master";

    var cfg = Model.Config;
    var rec = Model.Record;
    var lookups = Model.Lookups;

    string P(string s) => char.ToUpperInvariant(s[0]) + s.Substring(1);
    string V(object obj, string name) =>
        obj.GetType().GetProperty(P(name))?.GetValue(obj)?.ToString() ?? "";
}

<div class="container-fluid sm-page">

    @Html.AntiForgeryToken()

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-header sm-header">
            <h6 class="sm-title">
    <i class="fas fa-layer-group mr-2"></i>
    @cfg.Page.Title
</h6>

            <div class="sm-toolbar">
                @foreach (var b in cfg.Buttons.Form.Where(x => x.Visible))
                {
                    if (b.Action == "save")
                    {
                        <button type="submit" form="sectorForm"
                                class="btn btn-@b.Style btn-sm">
                            <i class="fas @b.Icon mr-1"></i>@b.Text
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-@b.Style btn-sm"
                                data-action="@b.Action">
                            <i class="fas @b.Icon mr-1"></i>@b.Text
                        </button>
                    }
                }
            </div>
        </div>
    </div>

    <form id="sectorForm" method="post" action="/Master/SectorMaster/Save">

        @Html.AntiForgeryToken()

        <input type="hidden" name="Id" value="@rec.Id" />

        @foreach (var sec in cfg.Sections)
        {
            <div class="card shadow-sm mb-4 sm-card">

                <div class="card-header">
                    <h6 class="sm-section-title">
                        <i class="fas fa-folder-open mr-2"></i>@sec.Title
                    </h6>
                </div>

                <div class="card-body">
                    <div class="sm-fields">

                        @foreach (var f in sec.Fields)
                        {
                            var value = V(rec, f.Field);

                            <div class="sm-field">
                                <label for="@f.Field">
                                    @f.Label
                                    @if (f.Required)
                                    {
                                        <span class="sm-required">*</span>
                                    }
                                </label>

                                <input class="form-control"
                                       id="@f.Field"
                                       name="@P(f.Field)"
                                       type="text"
                                       value="@value"
                                       maxlength="@(f.MaxLength > 0 ? f.MaxLength : null)"
                                       required="@f.Required"
                                       readonly="@f.Readonly" />
                            </div>
                        }

                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm mb-4 sm-card">

            <div class="card-header">
                <h6 class="sm-section-title">
                    <i class="fas fa-table mr-2"></i>@cfg.Grid.Title
                </h6>
            </div>

            <div class="card-body">

    <div class="mb-3 d-flex flex-wrap justify-content-end" style="gap: 6px;">
        <button type="button" class="btn btn-primary btn-sm" id="btnAddRow">
            <i class="fas fa-plus mr-1"></i> Add Row
        </button>

        <button type="button" class="btn btn-info btn-sm" id="btnInsertRow">
            <i class="fas fa-level-up-alt mr-1"></i> Insert Row
        </button>

        <button type="button" class="btn btn-danger btn-sm" id="btnDeleteRow">
            <i class="fas fa-trash mr-1"></i> Delete Row
        </button>
    </div>

    <div class="table-responsive">

                    <table class="table table-bordered table-striped table-hover sm-grid"
                           id="grid-@cfg.Grid.Id">

                        <thead>
                            <tr>
                                <th class="sm-check-col">
                                    <input type="checkbox" id="selectAllRows" />
                                </th>

                                @foreach (var c in cfg.Grid.Columns)
                                {
                                    <th>@c.Label</th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Math.Max(5, rec.SectorDefinitions.Count); i++)
                            {
                                var row = i < rec.SectorDefinitions.Count
                                    ? rec.SectorDefinitions[i]
                                    : new HCMSys.Controllers.SectorDefinitionRow();

                                <tr>
                                    <td class="sm-check-col">
                                        <input type="checkbox" class="row-select" />
                                    </td>

                                    @foreach (var c in cfg.Grid.Columns)
                                    {
                                        var value = V(row, c.Field);
                                        var fieldName = $"SectorDefinitions[{i}].{P(c.Field)}";

                                        <td>
                                            @if (c.Type == "select")
                                            {
                                                <select class="form-control" name="@fieldName">
                                                    <option value="">Select @c.Label</option>

                                                    @if (lookups.TryGetValue(c.Source ?? "", out var opts))
                                                    {
                                                        foreach (var o in opts)
                                                        {
                                                            <option value="@o.Value"
                                                                    selected="@(value == o.Value)">
                                                                @o.Text
                                                            </option>
                                                        }
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <input class="form-control"
                                                       type="@c.Type"
                                                       name="@fieldName"
                                                       value="@value"
                                                       step="@c.Step"
                                                       maxlength="@(c.MaxLength > 0 ? c.MaxLength : null)" />
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>

    </form>
</div>

<style>
html {
    font-size: 14px;
}

.sm-page {
    padding: 20px;
    color: #5a5c69;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 13px;
}

.sm-page .card {
    border: 1px solid #e1e6ed;
    border-radius: 6px;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(58, 59, 69, 0.14) !important;
}

/* Spacing between page sections */
.sm-page > .card {
    margin-bottom: 24px !important;
}

.sm-page form > .sm-card {
    margin-bottom: 24px !important;
}

.sm-page .card-header {
    background: #eef0f3 !important;
    border-bottom: 1px solid #e1e6ed;
    padding: 12px 16px;
}

.sm-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 14px 18px !important;
    background: #eef0f3 !important;
    border: none !important;
    border-bottom: 1px solid #e3e6f0 !important;
}


.sm-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: #5a5c69;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.sm-title i {
    color: #4e73df;
}

.sm-toolbar {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
}

.sm-toolbar .btn {
    padding: 5px 9px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 0.1rem 0.3rem rgba(0, 0, 0, 0.08);
    transition: filter 0.15s ease, box-shadow 0.15s ease;
}

.sm-section-title {
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 800;
    color: #4e73df;
    letter-spacing: 0.035em;
    margin: 0;
}

.sm-fields {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px 20px;
}

.sm-field {
    min-width: 0;
}

.sm-field label {
    display: block;
    margin-bottom: 5px;
    color: #596579;
    font-family: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.055em;
}

.sm-field .form-control {
    width: 100%;
    height: 36px;
    padding: 6px 10px;
    box-sizing: border-box;
    border: 1px solid #d2d0cb;
    border-radius: 5px;
    background: #ffffff;
    color: #4d596b;
    font-family: inherit;
    font-size: 0.83rem;
    box-shadow: none;
}

.sm-required {
    color: #e74a3b;
}

.sm-grid {
    min-width: 900px;
    margin: 0;
}

.sm-grid thead th {
    background: #4e73df;
    color: #ffffff;
    border-color: #3d5cbe;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    white-space: nowrap;
    vertical-align: middle;
}
.sm-grid td {
    vertical-align: middle;
    font-size: .8rem;
}

.sm-grid .form-control {
    font-size: .8rem;
    min-width: 110px;
    height: 36px;
    border: 1px solid #d1d3e2;
    border-radius: .35rem;
}

.sm-grid input[type="checkbox"] {
    width: 16px;
    height: 16px;
    margin: 0;
    vertical-align: middle;
    cursor: pointer;
}

.sm-grid .sm-check-col {
    width: 62px;
    min-width: 62px;
    max-width: 62px;
    text-align: center;
    padding: 5px !important;
}

@@media(max-width:900px) {
    .sm-fields {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@@media(max-width:600px) {
    .sm-page {
        padding: 10px 5px;
    }

    .sm-fields {
        grid-template-columns: 1fr;
    }

    .sm-toolbar {
        width: 100%;
    }
}

@@media print {
    .sm-toolbar {
        display: none !important;
    }

    .sm-page .card {
        box-shadow: none !important;
    }
}
</style>

<script>
(() => {
    const form = document.getElementById('sectorForm');

    document.querySelectorAll('.sm-toolbar [data-action]').forEach(btn => {
        btn.addEventListener('click', () => {
            const action = btn.dataset.action;

            if (action === 'new') {
                window.location.href = '/Master/SectorMaster';
            }
            else if (action === 'home') {
                window.location.href = '/Home/Index';
            }
            else if (action === 'close') {
                window.location.href = '/Master/SectorMasterIndex';
            }
            else if (action === 'print') {
                window.print();
            }
            else if (action === 'edit') {
                alert('Open a record from Sector Master List first.');
            }
            else if (action === 'clone') {
                const id = document.querySelector('[name="Id"]').value;
                window.location.href = id
                    ? '/Master/SectorMaster?id=' + id + '&clone=true'
                    : '/Master/SectorMaster';
            }
            else if (action === 'delete') {
                const id = document.querySelector('[name="Id"]').value;

                if (id && confirm('Delete this Sector Master record?')) {
                    form.action = '/Master/SectorMaster/Delete/' + id;
                    form.submit();
                }
            }
            else if (['unpost', 'approve', 'reject', 'authtracker'].includes(action)) {
                alert(action + ' is not connected to a workflow yet.');
            }
        });
    });

    const all = document.getElementById('selectAllRows');
const tbody = document.querySelector('#grid-@cfg.Grid.Id tbody');

const getRows = () => [...tbody.querySelectorAll('tr')];

const updateIndexes = () => {
    getRows().forEach((row, index) => {
        row.querySelectorAll('input[name], select[name]').forEach(control => {
            control.name = control.name.replace(
                /SectorDefinitions\[\d+\]/g,
                `SectorDefinitions[${index}]`
            );
        });
    });
};

const updateSelectAll = () => {
    const checkboxes = [...tbody.querySelectorAll('.row-select')];

    all.checked = checkboxes.length > 0 &&
        checkboxes.every(x => x.checked);

    all.indeterminate = checkboxes.some(x => x.checked) &&
        !all.checked;
};

const createBlankRow = () => {
    const sourceRow = getRows()[0];
    const newRow = sourceRow.cloneNode(true);

    newRow.querySelector('.row-select').checked = false;

    newRow.querySelectorAll('input:not(.row-select)').forEach(input => {
        input.value = '';
    });

    newRow.querySelectorAll('select').forEach(select => {
        select.selectedIndex = 0;
    });

    return newRow;
};

// ADD ROW - Adds a blank row at the bottom
document.getElementById('btnAddRow')?.addEventListener('click', () => {
    const newRow = createBlankRow();

    tbody.appendChild(newRow);

    updateIndexes();
    updateSelectAll();
});

// INSERT ROW - Inserts a blank row above selected row
document.getElementById('btnInsertRow')?.addEventListener('click', () => {
    const selectedRows = getRows().filter(row =>
        row.querySelector('.row-select').checked
    );

    if (selectedRows.length !== 1) {
        alert('Please select exactly one row to insert above.');
        return;
    }

    const selectedRow = selectedRows[0];
    const newRow = createBlankRow();

    tbody.insertBefore(newRow, selectedRow);

    updateIndexes();
    updateSelectAll();
});

// DELETE ROW - Deletes selected rows
document.getElementById('btnDeleteRow')?.addEventListener('click', () => {
    const selectedRows = getRows().filter(row =>
        row.querySelector('.row-select').checked
    );

    if (selectedRows.length === 0) {
        alert('Please select at least one row to delete.');
        return;
    }

    if (!confirm(`Are you sure you want to delete ${selectedRows.length} selected row(s)?`)) {
        return;
    }

    selectedRows.forEach(row => row.remove());

    updateIndexes();
    updateSelectAll();
});

// SELECT ALL
all?.addEventListener('change', () => {
    tbody.querySelectorAll('.row-select').forEach(checkbox => {
        checkbox.checked = all.checked;
    });

    all.indeterminate = false;
});

// Individual row selection
tbody.querySelectorAll('.row-select').forEach(checkbox => {
    checkbox.addEventListener('change', updateSelectAll);
});
})();
</script>
