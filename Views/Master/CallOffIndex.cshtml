@using System.Text.Json.Nodes
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var config = ViewData["Config"] as JsonObject ?? new JsonObject();
    var rows = ViewData["Rows"] as JsonArray ?? new JsonArray();

    var page = config["page"];
    var tableConfig = config["table"];
    var columns = tableConfig?["columns"] as JsonArray ?? new JsonArray();
    var buttons = config["buttons"]?["index"] as JsonArray ?? new JsonArray();

    var pageTitle = page?["title"]?.ToString() ?? "Call Off";
    ViewData["Title"] = pageTitle;
}

<div class="container-fluid candidate-index">

    <!-- TOOLBAR -->
    <div class="card ci-card ci-toolbar-card">
        <div class="card-header ci-toolbar">
            <h6 class="ci-title">
                <i class="fas @(page?["icon"]?.ToString())"></i>
                @pageTitle
                <span class="ci-module-badge">CALL OFF</span>
            </h6>

            <div class="ci-buttons">
                @foreach (var button in buttons)
                {
                    if (button?["visible"]?.GetValue<bool>() != true)
                    {
                        continue;
                    }

                    var action = button?["action"]?.ToString()?.ToLowerInvariant() ?? "";
                    var disabled = action != "new" && action != "print" && action != "close";

                    <button type="button"
                            class="btn btn-@(button?["style"]?.ToString() ?? "secondary") btn-sm shadow-sm"
                            data-action="@action"
                            disabled="@(disabled ? "disabled" : null)">
                        <i class="fas @(button?["icon"]?.ToString())"></i>
                        @button?["label"]
                    </button>
                }
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">@TempData["Error"]</div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row ci-summary">
        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-primary">
                <div class="card-body">
                    <div class="ci-summary-label">Total Records</div>
                    <div class="ci-summary-value">@rows.Count</div>
                    <i class="fas fa-file-alt ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-info">
                <div class="card-body">
                    <div class="ci-summary-label">Displayed Records</div>
                    <div class="ci-summary-value" id="ciDisplayed">@rows.Count</div>
                    <i class="fas fa-list ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-success">
                <div class="card-body">
                    <div class="ci-summary-label">Selected Record</div>
                    <div class="ci-summary-value" id="ciSelected">None</div>
                    <i class="fas fa-check-square ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-warning">
                <div class="card-body">
                    <div class="ci-summary-label">Module</div>
                    <div class="ci-summary-module">@pageTitle</div>
                    <i class="fas fa-sitemap ci-summary-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- RECORDS CARD -->
    <div class="card ci-card ci-records-card">
        <div class="card-header ci-records-header">
            <h6>
                <i class="fas fa-table"></i>
                @(tableConfig?["heading"]?.ToString() ?? "Call Off List")
            </h6>

            <span class="badge badge-primary" id="ciRecordCount">
                @rows.Count Records
            </span>
        </div>

        <div class="card-body">

            <!-- TABLE TOOLS -->
            <div class="ci-table-tools">
                <div class="ci-page-size">
                    <span>Show</span>
                    <select id="ciPageSize" class="form-control form-control-sm">
                        <option value="20">20</option>
                        <option value="35">35</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>entries</span>
                </div>

                <input type="text"
                       id="ciSearch"
                       class="form-control form-control-sm ci-search"
                       placeholder="Search call offs..." />
            </div>

            <!-- TABLE -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover"
                       id="ciTable">
                    <thead>
                        <tr>
                            <th class="ci-control-column">
                                <div class="ci-select-header">
                                    <span>Select</span>
                                    <input type="checkbox" id="ciSelectAll" title="Select All" />
                                </div>
                            </th>

                            <th class="ci-action-column">Action</th>

                            @foreach (var column in columns)
                            {
                                <th title="@column?["tooltip"]">
                                    @column?["header"]

                                    @if (!string.IsNullOrWhiteSpace(column?["tooltip"]?.ToString()))
                                    {
                                        <i class="fas fa-info-circle ml-1 text-white"
                                           title="@column?["tooltip"]"
                                           data-toggle="tooltip"
                                           data-placement="top"
                                           style="cursor:help"></i>
                                    }
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody id="ciTableBody">
                        @if (rows.Count > 0)
                        {
                            foreach (var row in rows)
                            {
                                var rowId = row?["ID"]?.ToString()
                                    ?? row?["Id"]?.ToString()
                                    ?? "";

                                <tr data-id="@rowId">
                                    <td class="text-center ci-control-column">
                                        <input type="checkbox"
                                               class="ci-checkbox"
                                               value="@rowId" />
                                    </td>

                                    <td class="text-center ci-action-column">
                                        <button type="button" class="ci-row-edit" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="ci-row-delete" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>

                                    @foreach (var column in columns)
                                    {
                                        var field = column?["field"]?.ToString() ?? "";
                                        var value = row?[field]?.ToString() ?? "";

                                        if (string.Equals(field, "ID", StringComparison.OrdinalIgnoreCase)
                                            && string.IsNullOrWhiteSpace(value))
                                        {
                                            value = row?["Id"]?.ToString() ?? "";
                                        }

                                        <td title="@value">@value</td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="ci-no-data">
                                <td colspan="@(columns.Count + 2)" class="ci-empty">
                                    No call off records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION -->
            <div class="ci-table-footer">
                <span id="ciShowing">Showing 0 records</span>

                <div class="ci-pagination">
                    <button class="btn btn-light btn-sm" id="ciPrevious" type="button">
                        Previous
                    </button>

                    <span id="ciPageInfo">0 / 0</span>

                    <button class="btn btn-light btn-sm" id="ciNext" type="button">
                        Next
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<form id="ciAntiForgery" hidden>
    @Html.AntiForgeryToken()
</form>

<style>
