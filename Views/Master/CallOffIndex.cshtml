    }

    .ci-border-primary .ci-summary-label { color: #4e73df; }
    .ci-border-info .ci-summary-label { color: #36b9cc; }
    .ci-border-success .ci-summary-label { color: #1cc88a; }
    .ci-border-warning .ci-summary-label { color: #f6c23e; }

    .ci-summary-value,
    .ci-summary-module {
        color: #5a5c69;
        font-size: 1.05rem;
        font-weight: 800;
    }

    #ciSelected {
        font-size: .9rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ci-summary-icon {
        position: absolute;
        top: 22px;
        right: 16px;
        color: #dddfeb;
        font-size: 1.5rem;
    }

    .ci-border-primary { border-left: 4px solid #4e73df !important; }
    .ci-border-warning { border-left: 4px solid #f6c23e !important; }
    .ci-border-success { border-left: 4px solid #1cc88a !important; }
    .ci-border-info { border-left: 4px solid #36b9cc !important; }

    .ci-records-card {
        margin-bottom: 20px;
    }

    .ci-records-header h6 {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: #4e73df;
        font-size: .9rem;
        font-weight: 800;
    }

    .ci-records-header .badge {
        padding: 5px 8px;
        font-size: .7rem;
        background: #4e73df;
    }

    .ci-records-card .card-body {
        padding: 16px;
    }

    .ci-table-tools {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }

    .ci-page-size {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-page-size select {
        width: 60px;
    }

    .ci-search {
        width: 320px;
        max-width: 100%;
    }

    .candidate-index .form-control {
        min-height: 32px;
        border: 1px solid #d2d0cb;
        border-radius: 5px;
        color: #5a5c69;
        font-family: inherit;
        font-size: .83rem;
        box-shadow: none;
    }

    .candidate-index .form-control:focus {
        border-color: #7d9fe5;
        box-shadow: 0 0 0 .18rem rgba(78,115,223,.14);
    }

   #ciTable {
    width: 100%;
    min-width: 100%;
    table-layout: fixed;
    margin-bottom: 0;
    white-space: nowrap;
}

#ciTable th,
#ciTable td {
    box-sizing: border-box;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 8px 6px;
}

#ciTable thead th {
    padding: 10px 6px;
    background: #4e73df;
    color: #fff;
    border-color: #3d5cbe;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .02em;
    vertical-align: middle;
}

#ciTable tbody td {
    padding: 8px 6px;
    color: #5a5c69;
    font-size: .8rem;
    vertical-align: middle;
}

/* Compact column widths */
#ciTable th:nth-child(1),
#ciTable td:nth-child(1) { width: 4%; }

#ciTable th:nth-child(2),
#ciTable td:nth-child(2) { width: 6%; }

#ciTable th:nth-child(3),
#ciTable td:nth-child(3) { width: 7%; }

#ciTable th:nth-child(4),
#ciTable td:nth-child(4) { width: 5%; }

#ciTable th:nth-child(5),
#ciTable td:nth-child(5) { width: 14%; }

#ciTable th:nth-child(6),
#ciTable td:nth-child(6) { width: 7%; }

#ciTable th:nth-child(7),
#ciTable td:nth-child(7) { width: 6%; }

#ciTable th:nth-child(8),
#ciTable td:nth-child(8) {
    width: 4%;
    min-width: 48px;
    max-width: 48px;
    text-align: center;
}

#ciTable th:nth-child(9),
#ciTable td:nth-child(9) {
    width: 5%;
    min-width: 58px;
    max-width: 58px;
    text-align: center;
}

#ciTable th:nth-child(10),
#ciTable td:nth-child(10) {
    width: 3%;
    min-width: 42px;
    max-width: 42px;
    text-align: center;
}

#ciTable th:nth-child(11),
#ciTable td:nth-child(11) { width: 7%; }

#ciTable th:nth-child(12),
#ciTable td:nth-child(12) { width: 8%; }

#ciTable th:nth-child(13),
#ciTable td:nth-child(13) { width: 7%; }

#ciTable th:nth-child(14),
#ciTable td:nth-child(14) { width: 8%; }

#ciTable tbody tr:hover {
    background-color: #f3f6ff;
}

#ciTable tbody tr.selected {
    background-color: #eaecf4;
}

.ci-control-column {
    text-align: center !important;
}

.ci-select-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
}

.ci-action-column {
    text-align: center !important;
}

.ci-row-edit,
.ci-row-delete {
    border: none;
    background: transparent;
    padding: 4px 5px;
    cursor: pointer;
    font-size: .9rem;
}

.ci-row-edit { color: #4e73df; }
.ci-row-delete { color: #e74a3b; }

    .ci-checkbox,
    #ciSelectAll {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .ci-empty {
        padding: 24px !important;
        color: #858796;
        text-align: center !important;
    }

    .ci-table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 14px;
        color: #858796;
        font-size: .8rem;
    }

    .ci-pagination {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-pagination .btn {
        border: 1px solid #e3e6f0;
        background: #fff;
        color: #5a5c69;
    }

    .ci-pagination .btn:disabled {
        opacity: .45;
        cursor: not-allowed;
    }

    @@media (max-width: 768px) {
        .ci-toolbar {
            align-items: flex-start;
        }

        .ci-buttons,
        .ci-search {
            width: 100%;
        }

        .ci-search {
            width: 100%;
        }
    }

    @@media print {
        .ci-buttons,
        .ci-table-tools,
        .ci-table-footer,
        .ci-control-column,
        .ci-action-column {
            display: none !important;
        }

        .candidate-index .ci-card {
            box-shadow: none !important;
        }
    }
</style>

<script>
    (() => {
        const body = document.getElementById("ciTableBody");
        const searchInput = document.getElementById("ciSearch");
        const pageSizeInput = document.getElementById("ciPageSize");
        const selectAllCheckbox = document.getElementById("ciSelectAll");

        if (!body || !searchInput || !pageSizeInput || !selectAllCheckbox) return;

        const rows = Array.from(body.querySelectorAll("tr[data-id]"));
        let filteredRows = rows.slice();
        let currentPage = 1;

        const selectedDisplay = document.getElementById("ciSelected");
        const displayedDisplay = document.getElementById("ciDisplayed");
        const recordCount = document.getElementById("ciRecordCount");
        const showing = document.getElementById("ciShowing");
        const pageInfo = document.getElementById("ciPageInfo");
        const previous = document.getElementById("ciPrevious");
        const next = document.getElementById("ciNext");

        function getSelected() {
            return rows.filter(row => row.querySelector(".ci-checkbox")?.checked);
        }

        function updateSelection() {
            const selected = getSelected();

            rows.forEach(row => {
                row.classList.toggle(
                    "selected",
                    row.querySelector(".ci-checkbox")?.checked === true
                );
            });

            const visibleSelected = filteredRows.filter(row =>
                row.querySelector(".ci-checkbox")?.checked
            ).length;

            selectAllCheckbox.checked =
                filteredRows.length > 0 && visibleSelected === filteredRows.length;

            selectAllCheckbox.indeterminate =
                visibleSelected > 0 && visibleSelected < filteredRows.length;

            const names = selected.map(row =>
                row.cells[2]?.textContent.trim() || row.dataset.id
            );

            selectedDisplay.textContent = names.length ? names.join(", ") : "None";

            document.querySelector('[data-action="edit"]')
                ?.toggleAttribute("disabled", selected.length !== 1);

            document.querySelector('[data-action="clone"]')
                ?.toggleAttribute("disabled", selected.length !== 1);

            document.querySelector('[data-action="delete"]')
                ?.toggleAttribute("disabled", selected.length === 0);
        }

        function renderRows() {
            const pageSize = Number(pageSizeInput.value);
            const totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));

            currentPage = Math.min(Math.max(currentPage, 1), totalPages);

            rows.forEach(row => row.hidden = true);

            const start = (currentPage - 1) * pageSize;
            const visibleRows = filteredRows.slice(start, start + pageSize);

            visibleRows.forEach(row => row.hidden = false);

            displayedDisplay.textContent = filteredRows.length;
            recordCount.textContent = `${filteredRows.length} Records`;

            showing.textContent = filteredRows.length
                ? `Showing ${start + 1} to ${start + visibleRows.length} of ${filteredRows.length} records`
                : "Showing 0 records";

            pageInfo.textContent = filteredRows.length
                ? `${currentPage} / ${totalPages}`
                : "0 / 0";

            previous.disabled = currentPage <= 1;
            next.disabled = currentPage >= totalPages;

            updateSelection();
        }

        function filterRows() {
            const query = searchInput.value.trim().toLowerCase();

            filteredRows = rows.filter(row =>
                row.innerText.toLowerCase().includes(query)
            );

            currentPage = 1;
            renderRows();
        }

        function editRecord(id) {
            if (!id) return;
            window.location.href = "/Master/CallOff?id=" + encodeURIComponent(id);
        }

        function deleteRecord(id) {
            if (!id) return;

            if (!confirm("Are you sure you want to delete this Call Off record?")) {
                return;
            }

            alert("Connect this button to your CallOffController Delete action.");
        }

        selectAllCheckbox.addEventListener("change", function () {
            filteredRows.forEach(row => {
                const checkbox = row.querySelector(".ci-checkbox");
                if (checkbox) checkbox.checked = this.checked;
            });

            updateSelection();
        });

        rows.forEach(row => {
            row.querySelector(".ci-checkbox")?.addEventListener("change", updateSelection);

            row.addEventListener("click", event => {
                if (event.target.closest(".ci-row-edit, .ci-row-delete, .ci-checkbox")) return;

                const checkbox = row.querySelector(".ci-checkbox");
                checkbox.checked = !checkbox.checked;
                updateSelection();
            });
        });

        body.addEventListener("click", event => {
            const edit = event.target.closest(".ci-row-edit");
            const del = event.target.closest(".ci-row-delete");

            if (!edit && !del) return;

            const row = event.target.closest("tr[data-id]");
            if (!row) return;

            if (edit) editRecord(row.dataset.id);
            if (del) deleteRecord(row.dataset.id);
        });

        document.querySelector(".ci-buttons")?.addEventListener("click", event => {
            const button = event.target.closest("[data-action]");
            if (!button || button.disabled) return;

            const action = button.dataset.action;
            const selected = getSelected();

            switch (action) {
                case "new":
                    window.location.href = "/Master/CallOff";
                    break;

                case "edit":
                    if (selected.length === 1) editRecord(selected[0].dataset.id);
                    break;

                case "clone":
                    if (selected.length === 1) {
                        window.location.href =
                            "/Master/CallOff?id=" +
                            encodeURIComponent(selected[0].dataset.id) + "&clone=true";
                    }
                    break;

                case "delete":
                    if (selected.length === 1) {
                        deleteRecord(selected[0].dataset.id);
                    } else if (selected.length > 1) {
                        alert("Multiple selection requires a DeleteSelected action.");
                    }
                    break;

                case "print":
                    window.print();
                    break;

                case "close":
                    window.location.href = "/Home/Index";
                    break;

                default:
                    alert("This action is not connected to the backend yet.");
                    break;
            }
        });

        searchInput.addEventListener("input", filterRows);

        pageSizeInput.addEventListener("change", () => {
            currentPage = 1;
            renderRows();
        });

        previous.addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage--;
                renderRows();
            }
        });

        next.addEventListener("click", () => {
            const totalPages = Math.max(
                1,
                Math.ceil(filteredRows.length / Number(pageSizeInput.value))
            );

            if (currentPage < totalPages) {
                currentPage++;
                renderRows();
            }
        });

        renderRows();
    })();
</script>