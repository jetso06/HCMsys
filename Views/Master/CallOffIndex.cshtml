    }

    .ci-summary > div {
        margin-bottom: 16px;
    }

    .ci-summary-card {
        min-height: 78px;
    }

    .ci-summary-card .card-body {
        position: relative;
        padding: 15px 16px;
    }

    .ci-summary-label {
        margin-bottom: 4px;
        font-size: .7rem;
        font-weight: 800;
