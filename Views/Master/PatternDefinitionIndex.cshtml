
@{
    ViewData["Title"] = "Pattern Definition Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    html {
        font-size: 14px;
    }

    .pd-page {
        width: 100%;
        padding: 0 15px 24px;
        color: #5a5c69;
        box-sizing: border-box;
    }

    .pd-page *,
    .pd-page *::before,
    .pd-page *::after {
        box-sizing: border-box;
    }

    .pd-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px 18px;
        margin-bottom: 16px;
        background: #fff;
        border: 1px solid #e3e6f0;
        border-radius: .35rem;
        box-shadow: 0 .15rem 1rem rgba(58,59,69,.12);
    }

    .pd-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: #5a5c69;
        font-size: .85rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .pd-title i {
        color: #4e73df;
    }

    .pd-toolbar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 6px;
    }

    .pd-toolbar .btn {
        white-space: nowrap;
    }

    .pd-card {
        margin-bottom: 16px;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e3e6f0;
        border-radius: .35rem;
        box-shadow: 0 .15rem 1rem rgba(58,59,69,.10);
    }

    .pd-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        padding: 14px 18px;
        background: #fff;
        border-bottom: 1px solid #e3e6f0;
        font-weight: 700;
    }

    .pd-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .pd-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

    .pd-table th {
        padding: 11px 12px;
        background: #4e73df;
        border: 1px solid #e3e6f0;
        color: #fff;
        text-align: left;
        font-size: 11px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .pd-table td {
        padding: 10px 12px;
        border: 1px solid #e3e6f0;
        vertical-align: middle;
    }

    .pd-table tbody tr:nth-child(even) {
        background: #f8f9fc;
    }

    .pd-empty {
        padding: 25px !important;
        color: #858796;
        text-align: center;
    }

    .pd-message {
        display: none;
        margin: 14px 18px;
        font-size: 13px;
    }

    .pd-message.success {
        display: block;
        color: #1cc88a;
    }

    .pd-message.error {
        display: block;
        color: #e74a3b;
    }

    @@media (max-width: 700px) {
        .pd-toolbar {
            justify-content: flex-start;
        }
    }
</style>

<div class="pd-page">

    <!-- Same master header styling -->
    <div class="pd-header">
        <h5 class="pd-title">
            <i class="fas fa-project-diagram"></i>
            Pattern Definition Master
        </h5>

        <div class="pd-toolbar">
            <a href="@Url.Content("~/PatternDefinition/PatternDefinition")"
               class="btn btn-success btn-sm shadow-sm">
                <i class="fas fa-plus mr-1"></i> New
            </a>

            <button type="button"
                    class="btn btn-primary btn-sm shadow-sm"
                    id="pdEditSelected">
                <i class="fas fa-edit mr-1"></i> Edit
            </button>

            <button type="button"
                    class="btn btn-secondary btn-sm shadow-sm"
                    id="pdPrintIndex">
                <i class="fas fa-print mr-1"></i> Print
            </button>

            <button type="button"
                    class="btn btn-danger btn-sm shadow-sm"
                    id="pdDeleteSelected">
                <i class="fas fa-trash mr-1"></i> Delete
            </button>

            <button type="button"
                    class="btn btn-info btn-sm shadow-sm"
                    id="pdCloseIndex">
                <i class="fas fa-times-circle mr-1"></i> Close
            </button>
        </div>
    </div>

    <!-- Same Saved Patterns card and table styling -->
    <div class="pd-card">
        <div class="pd-card-header">
            <span>
                <i class="fas fa-list text-primary mr-2"></i>
                Saved Patterns
            </span>

            <button type="button"
                    class="btn btn-outline-primary btn-sm"
                    id="pdRefreshIndex">
                <i class="fas fa-sync-alt mr-1"></i> Refresh
            </button>
        </div>

        <div id="pdIndexMessage" class="pd-message" role="status"></div>

        <div class="pd-table-wrap">
            <table class="pd-table">
                <thead>
                    <tr>
                        <th>Name No.</th>
                        <th>Pattern Name</th>
                        <th>Code</th>
                        <th>Days in Cycle</th>
                        <th>Duty Days</th>
                        <th>Off Days</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="pdIndexRows">
                    <tr>
                        <td colspan="7" class="pd-empty">
                            Loading patterns...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function () {
    "use strict";

    const apiUrl = '@Url.Content("~/PatternDefinition/api/patterns")';
    const editorUrl = '@Url.Content("~/PatternDefinition/PatternDefinition")';
    const $ = id => document.getElementById(id);

    let patterns = [];

    function escapeHtml(value) {
        return String(value ?? "").replace(/[&<>"']/g, ch => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        })[ch]);
    }

    async function responseJson(response) {
        let data = {};

        try {
            data = await response.json();
        } catch { }

        if (!response.ok) {
            throw new Error(data.message || `Request failed (${response.status}).`);
        }

        return data;
    }

    function showMessage(text, type = "success") {
        const element = $("pdIndexMessage");
        element.textContent = text || "";
        element.className = "pd-message" + (text ? " " + type : "");
    }

    function renderRows() {
        const tbody = $("pdIndexRows");

        if (!patterns.length) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="pd-empty">
                        No saved patterns yet. Click New to create your first pattern.
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = patterns.map(pattern => {
            const days = Array.isArray(pattern.days) ? pattern.days : [];
            const duty = days.filter(day => day === "DD").length;
            const off = days.filter(day => day === "OFF").length;

            return `
                <tr>
                    <td>${escapeHtml(pattern.nameNo)}</td>
                    <td>${escapeHtml(pattern.name)}</td>
                    <td>${escapeHtml(pattern.code)}</td>
                    <td>${escapeHtml(pattern.daysInCycle)}</td>
                    <td>${duty}</td>
                    <td>${off}</td>
                    <td>
                        <div class="d-flex flex-wrap" style="gap:5px">
                            <a class="btn btn-outline-primary btn-sm"
                               href="${editorUrl}?id=${encodeURIComponent(pattern.id)}">
                                <i class="fas fa-edit"></i> Edit
                            </a>

                            <button type="button"
                                    class="btn btn-outline-danger btn-sm"
                                    data-action="delete"
                                    data-id="${escapeHtml(pattern.id)}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;
        }).join("");
    }

    async function refreshPatterns() {
        try {
            const response = await fetch(apiUrl, {
                headers: { "Accept": "application/json" },
                cache: "no-store"
            });

            patterns = await responseJson(response);

            if (!Array.isArray(patterns)) {
                patterns = [];
            }

            renderRows();
            showMessage("");
        } catch (error) {
            $("pdIndexRows").innerHTML = `
                <tr>
                    <td colspan="7" class="pd-empty">
                        Could not load patterns from the server.
                    </td>
                </tr>`;

            showMessage(error.message, "error");
        }
    }

    async function deletePattern(id) {
        const pattern = patterns.find(item => item.id === id);
        if (!pattern) return;

        if (!confirm(`Delete pattern "${pattern.name}" (${pattern.code})?`)) {
            return;
        }

        try {
            const response = await fetch(
                `${apiUrl}/${encodeURIComponent(id)}`,
                {
                    method: "DELETE",
                    headers: { "Accept": "application/json" }
                }
            );

            const result = await responseJson(response);

            showMessage(result.message || "Pattern deleted successfully.");
            await refreshPatterns();
        } catch (error) {
            showMessage(error.message, "error");
        }
    }

    $("pdIndexRows").addEventListener("click", event => {
        const button = event.target.closest('button[data-action="delete"]');
        if (!button) return;

        deletePattern(button.dataset.id);
    });

    $("pdEditSelected").addEventListener("click", () => {
        const selected = document.querySelector("#pdIndexRows tr.selected");
        const id = selected?.dataset.id;

        if (!id) {
            alert("Please use the Edit button in the row of the pattern you want to edit.");
            return;
        }

        window.location.href = `${editorUrl}?id=${encodeURIComponent(id)}`;
    });

    // Clicking a row selects it for the top Edit/Delete buttons.
    $("pdIndexRows").addEventListener("click", event => {
        const row = event.target.closest("tr");
        if (!row || !row.querySelector('button[data-action="delete"]')) return;

        $("pdIndexRows").querySelectorAll("tr").forEach(item => {
            item.classList.remove("selected");
        });

        row.classList.add("selected");
        row.dataset.id = row.querySelector('button[data-action="delete"]').dataset.id;
    });

    $("pdDeleteSelected").addEventListener("click", () => {
        const selected = $("pdIndexRows").querySelector("tr.selected");
        if (!selected?.dataset.id) {
            alert("Please select a pattern row first.");
            return;
        }

        deletePattern(selected.dataset.id);
    });

    $("pdRefreshIndex").addEventListener("click", refreshPatterns);
    $("pdPrintIndex").addEventListener("click", () => window.print());

    $("pdCloseIndex").addEventListener("click", () => {
        window.location.href = '@Url.Content("~/")';
    });

    refreshPatterns();
})();
</script>
