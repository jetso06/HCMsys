
@{
    ViewData["Title"] = "Pattern Definition Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page-specific stylesheets -->
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" />

<link rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

<link rel="stylesheet"
      href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css" />

<style>
    html {
    font-size: 14px;
}

body,
.container-fluid,
.card,
.card-header,
.card-body,
.btn,
button,
input,
select,
table,
.dataTables_wrapper {
    font-family: 'Nunito', sans-serif !important;
}

body {
    background-color: #f8f9fc;
    color: #5a5c69;
}

.card {
    border: 1px solid #e3e6f0;
    border-radius: .35rem;
}

.card-header {
    background-color: #f8f9fc;
    border-bottom: 1px solid #e3e6f0;
}

.btn {
    font-weight: 600;
}

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }

    .page-title-text {
        font-size: .85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: .08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .page-title-text i {
        color: #4e73df;
    }

    .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    #tblPatterns thead th {
        background-color: #4e73df;
        color: #fff;
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        border-color: #3d5cbe;
        vertical-align: middle;
        white-space: nowrap;
    }

    #tblPatterns tbody tr:hover {
        background-color: #f0f3ff;
    }

    #tblPatterns tbody tr.selected {
        background-color: #e2e9ff !important;
    }

    #tblPatterns td {
        font-size: .82rem;
        color: #5a5c69;
        vertical-align: middle;
    }

    .action-btns a {
        margin: 0 3px;
        transition: opacity .15s;
    }

    .action-btns a:hover {
        opacity: .7;
    }

    .action-btns .fa-edit {
        color: #4e73df;
    }

    .action-btns .fa-trash-alt {
        color: #e74a3b;
    }

    .border-left-primary {
        border-left: .25rem solid #4e73df !important;
    }

    .border-left-success {
        border-left: .25rem solid #1cc88a !important;
    }

    .border-left-info {
        border-left: .25rem solid #36b9cc !important;
    }

    .border-left-warning {
        border-left: .25rem solid #f6c23e !important;
    }

    .badge-primary {
        background-color: #4e73df;
    }

    .text-gray-800 {
        color: #5a5c69 !important;
    }

    .text-gray-300 {
        color: #dddfeb !important;
    }

    .form-control {
        font-size: .85rem;
        border-color: #d1d3e2;
        color: #6e707e;
        border-radius: .35rem;
    }

    .form-control:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 .2rem rgba(78,115,223,.2);
    }

    .dataTables_wrapper {
        color: #5a5c69;
        font-size: .82rem;
    }

    .dataTables_wrapper .dataTables_filter input {
        font-size: .85rem;
        border: 1px solid #d1d3e2;
        border-radius: .25rem;
        padding: 5px 8px;
        margin-left: 6px;
    }

    .dataTables_wrapper .dataTables_length select {
        font-size: .85rem;
        border: 1px solid #d1d3e2;
        border-radius: .25rem;
        padding: 4px;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: #4e73df !important;
        color: #fff !important;
        border: 1px solid #4e73df !important;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: #e8edff !important;
        color: #4e73df !important;
        border: 1px solid #bac8f3 !important;
    }

    #patternMessage {
        display: none;
        margin-bottom: 15px;
        font-size: .85rem;
    }

    #patternMessage.success {
        display: block;
        color: #1cc88a;
    }

    #patternMessage.error {
        display: block;
        color: #e74a3b;
    }

    @@media print {
        .page-title-bar .btn-group-actions,
        #tblPatterns_wrapper .dataTables_length,
        #tblPatterns_wrapper .dataTables_filter,
        #tblPatterns_wrapper .dataTables_paginate {
            display: none !important;
        }
    }
</style>

<div class="container-fluid py-3">

    <!-- PAGE HEADER CARD -->
    <div class="card shadow mb-3">
        <div class="card-header py-3">
            <div class="page-title-bar">
                <div class="page-title-text">
                    <i class="fas fa-project-diagram fa-sm"></i>
                    Pattern Definition Master
                </div>

                <div class="btn-group-actions">
                    <a href="@Url.Content("~/PatternDefinition/PatternDefinition")"
                       class="btn btn-success btn-sm shadow-sm">
                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i>
                        New
                    </a>

                    <button type="button"
                            class="btn btn-primary btn-sm shadow-sm"
                            id="btnEdit">
                        <i class="fas fa-edit fa-sm text-white-50 mr-1"></i>
                        Edit
                    </button>

                    <button type="button"
                            class="btn btn-secondary btn-sm shadow-sm"
                            id="btnPrint">
                        <i class="fas fa-print fa-sm text-white-50 mr-1"></i>
                        Print
                    </button>

                    <button type="button"
                            class="btn btn-danger btn-sm shadow-sm"
                            id="btnDelete">
                        <i class="fas fa-trash fa-sm text-white-50 mr-1"></i>
                        Delete
                    </button>

                    <button type="button"
                            class="btn btn-info btn-sm shadow-sm"
                            id="btnClose">
                        <i class="fas fa-times-circle fa-sm text-white-50 mr-1"></i>
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row mb-3">

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Patterns
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"
                                 id="stat-total">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-layer-group fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Total Duty Days
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"
                                 id="stat-duty">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Total Off Days
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800"
                                 id="stat-off">--</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-minus fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body py-2">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Module
                            </div>
                            <div class="h6 mb-0 font-weight-bold text-gray-800">
                                Pattern Definition
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-project-diagram fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- PATTERN TABLE CARD -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-table mr-2"></i>
                Saved Patterns
            </h6>

            <div class="d-flex align-items-center">
                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        id="btnRefresh">
                    <i class="fas fa-sync-alt mr-1"></i>
                    Refresh
                </button>

                <span class="badge badge-primary ml-2"
                      id="record-count-badge">0 Records</span>
            </div>
        </div>

        <div class="card-body">
            <div id="patternMessage" role="status"></div>

            <div class="table-responsive">
                <table id="tblPatterns"
                       class="table table-bordered table-striped table-hover"
                       style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:90px;text-align:center;">Action</th>
                            <th style="width:70px;">Name No.</th>
                            <th>Pattern Name</th>
                            <th style="width:120px;">Code</th>
                            <th style="width:120px;">Days in Cycle</th>
                            <th style="width:100px;">Duty Days</th>
                            <th style="width:100px;">Off Days</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>

<script>
(function () {
    "use strict";

    const apiUrl = '@Url.Content("~/PatternDefinition/api/patterns")';
    const editorUrl = '@Url.Content("~/PatternDefinition/PatternDefinition")';

    let patterns = [];
    let table = null;
    let selectedId = null;

    function escapeHtml(value) {
        return String(value ?? "").replace(/[&<>"']/g, ch => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        })[ch]);
    }

    function showMessage(text, type = "success") {
        const element = document.getElementById("patternMessage");
        element.textContent = text || "";
        element.className = text ? type : "";
    }

    async function parseResponse(response) {
        let data = {};

        try {
            data = await response.json();
        } catch (_) { }

        if (!response.ok) {
            throw new Error(data.message || `Request failed (${response.status}).`);
        }

        return data;
    }

    function getDayCounts(pattern) {
        const days = Array.isArray(pattern.days) ? pattern.days : [];

        return {
            duty: days.filter(day => day === "DD").length,
            off: days.filter(day => day === "OFF").length
        };
    }

    function updateCards() {
        let totalDuty = 0;
        let totalOff = 0;

        patterns.forEach(pattern => {
            const counts = getDayCounts(pattern);
            totalDuty += counts.duty;
            totalOff += counts.off;
        });

        document.getElementById("stat-total").textContent = patterns.length;
        document.getElementById("stat-duty").textContent = totalDuty;
        document.getElementById("stat-off").textContent = totalOff;

        document.getElementById("record-count-badge").textContent =
            `${patterns.length} Records`;
    }

    function initTable() {
        if (table) {
            table.destroy();
            table = null;
        }

        const rows = patterns.map(pattern => {
            const counts = getDayCounts(pattern);

            return {
                id: pattern.id,
                nameNo: pattern.nameNo,
                name: pattern.name,
                code: pattern.code,
                daysInCycle: pattern.daysInCycle,
                duty: counts.duty,
                off: counts.off
            };
        });

        table = $("#tblPatterns").DataTable({
            data: rows,

            columns: [
                {
                    data: null,
                    render: function (data, type, row) {
                        if (type !== "display") return row.id;

                        return `
                            <div class="action-btns" style="text-align:center;">
                                <a href="${editorUrl}?id=${encodeURIComponent(row.id)}"
                                   class="edit-item-btn"
                                   title="Edit pattern">
                                    <i class="fas fa-edit fa-sm fa-fw"></i>
                                </a>

                                <a href="#"
                                   class="remove-item-btn"
                                   data-id="${escapeHtml(row.id)}"
                                   title="Delete pattern">
                                    <i class="fas fa-trash-alt fa-sm fa-fw"></i>
                                </a>
                            </div>`;
                    }
                },
                { data: "nameNo" },
                { data: "name" },
                { data: "code" },
                { data: "daysInCycle" },
                { data: "duty" },
                { data: "off" }
            ],

            order: [[1, "asc"]],
            pageLength: 15,
            autoWidth: false,

            language: {
                search: "",
                searchPlaceholder: "Search patterns...",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ patterns",
                infoEmpty: "Showing 0 to 0 of 0 patterns",
                emptyTable: "No saved patterns found",
                zeroRecords: "No matching patterns found",
                paginate: {
                    previous: "Previous",
                    next: "Next"
                }
            },

            columnDefs: [
                {
                    orderable: false,
                    searchable: false,
                    targets: 0
                }
            ]
        });

        $("#tblPatterns tbody").off("click.patternSelect")
            .on("click.patternSelect", "tr", function (event) {
                if ($(event.target).closest("a").length) return;

                $("#tblPatterns tbody tr").removeClass("selected");
                $(this).addClass("selected");

                const rowData = table.row(this).data();
                selectedId = rowData ? rowData.id : null;
            });

        $("#tblPatterns tbody").off("click.patternDelete")
            .on("click.patternDelete", ".remove-item-btn", function (event) {
                event.preventDefault();
                event.stopPropagation();

                deletePattern($(this).data("id"));
            });
    }

    async function refreshPatterns() {
        try {
            const response = await fetch(apiUrl, {
                headers: { "Accept": "application/json" },
                cache: "no-store"
            });

            patterns = await parseResponse(response);

            if (!Array.isArray(patterns)) {
                patterns = [];
            }

            selectedId = null;
            updateCards();
            initTable();
            showMessage("");
        } catch (error) {
            console.error("Pattern Definition Index error:", error);

            document.getElementById("stat-total").textContent = "0";
            document.getElementById("stat-duty").textContent = "0";
            document.getElementById("stat-off").textContent = "0";
            document.getElementById("record-count-badge").textContent = "0 Records";

            showMessage(error.message, "error");
        }
    }

    async function deletePattern(id) {
        const pattern = patterns.find(item => item.id === id);
        if (!pattern) return;

        if (!confirm(`Delete pattern "${pattern.name}" (${pattern.code})?`)) {
            return;
        }

        try {
            const response = await fetch(
                `${apiUrl}/${encodeURIComponent(id)}`,
                {
                    method: "DELETE",
                    headers: { "Accept": "application/json" }
                }
            );

            const result = await parseResponse(response);
            showMessage(result.message || "Pattern deleted successfully.");

            await refreshPatterns();
        } catch (error) {
            showMessage(error.message, "error");
        }
    }

    document.getElementById("btnRefresh")
        .addEventListener("click", refreshPatterns);

    document.getElementById("btnEdit").addEventListener("click", function () {
        if (!selectedId) {
            alert("Please select a pattern row first.");
            return;
        }

        window.location.href =
            `${editorUrl}?id=${encodeURIComponent(selectedId)}`;
    });

    document.getElementById("btnDelete").addEventListener("click", function () {
        if (!selectedId) {
            alert("Please select a pattern row first.");
            return;
        }

        deletePattern(selectedId);
    });

    document.getElementById("btnPrint")
        .addEventListener("click", () => window.print());

    document.getElementById("btnClose").addEventListener("click", function () {
        window.location.href = '@Url.Content("~/")';
    });

    $(document).ready(function () {
        refreshPatterns();
    });
})();

</script>
