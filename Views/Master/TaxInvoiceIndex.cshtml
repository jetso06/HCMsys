<script>
(() => {
    const body = document.getElementById("ciTableBody");
    const searchInput = document.getElementById("ciSearch");
    const pageSizeInput = document.getElementById("ciPageSize");
    const selectAllCheckbox = document.getElementById("ciSelectAll");

    const rows = Array.from(body.querySelectorAll("tr[data-id]"));

    let filteredRows = rows.slice();
    let currentPage = 1;

    function getSelected() {
        return Array.from(body.querySelectorAll(".ci-checkbox:checked"));
    }

    function updateSelection() {
        const selected = getSelected();

        const selectedInFiltered = filteredRows.filter(row =>
            row.querySelector(".ci-checkbox")?.checked
        ).length;

        selectAllCheckbox.checked =
            filteredRows.length > 0 &&
            selectedInFiltered === filteredRows.length;

        selectAllCheckbox.indeterminate =
            selectedInFiltered > 0 &&
            selectedInFiltered < filteredRows.length;

        rows.forEach(row => {
            row.classList.toggle(
                "selected",
                row.querySelector(".ci-checkbox")?.checked === true
            );
        });

        const names = selected.map(checkbox => {
    const row = checkbox.closest("tr");
    return row.cells[4]?.textContent.trim() || checkbox.value;
});

        document.getElementById("ciSelected").textContent =
            names.length ? names.join(", ") : "None";

        document.querySelector('[data-action="edit"]')?.toggleAttribute(
            "disabled", selected.length !== 1
        );

        document.querySelector('[data-action="clone"]')?.toggleAttribute(
            "disabled", selected.length !== 1
        );

        document.querySelector('[data-action="delete"]')?.toggleAttribute(
            "disabled", selected.length === 0
        );
    }

    function renderRows() {
        const pageSize = Number(pageSizeInput.value);

        const totalPages = Math.max(
            1,
            Math.ceil(filteredRows.length / pageSize)
        );

        currentPage = Math.min(currentPage, totalPages);

        rows.forEach(row => row.hidden = true);

        const start = (currentPage - 1) * pageSize;
        const visibleRows = filteredRows.slice(start, start + pageSize);

        visibleRows.forEach(row => row.hidden = false);

        document.getElementById("ciDisplayed").textContent =
            filteredRows.length;

        document.getElementById("ciRecordCount").textContent =
            `${filteredRows.length} Records`;

        document.getElementById("ciShowing").textContent =
            filteredRows.length
                ? `Showing ${start + 1} to ${start + visibleRows.length} of ${filteredRows.length} records`
                : "Showing 0 records";

        document.getElementById("ciPageInfo").textContent =
            filteredRows.length
                ? `${currentPage} / ${totalPages}`
                : "0 / 0";

        document.getElementById("ciPrevious").disabled =
            currentPage <= 1;

        document.getElementById("ciNext").disabled =
            currentPage >= totalPages;

        updateSelection();
    }

    function filterRows() {
        const query = searchInput.value.trim().toLowerCase();

        filteredRows = rows.filter(row =>
            row.innerText.toLowerCase().includes(query)
        );

        currentPage = 1;
        renderRows();
    }

    function editRecord(id) {
        if (!id) {
            alert("Please select a Tax Invoice.");
            return;
        }

        window.location.href =
            "/Master/TaxInvoice?id=" + encodeURIComponent(id);
    }

    async function deleteRecord(id) {
        if (!id) {
            alert("Please select a Tax Invoice.");
            return;
        }

        if (!confirm("Are you sure you want to delete this Tax Invoice?"))
            return;

        const token = document.querySelector(
            'input[name="__RequestVerificationToken"]'
        )?.value || "";

        const response = await fetch(
            "/Master/TaxInvoice/Delete/" + encodeURIComponent(id),
            {
                method: "POST",
                headers: {
                    "RequestVerificationToken": token
                }
            }
        );

        if (!response.ok) {
            alert("Could not delete Tax Invoice ID " + id);
            return;
        }

        location.reload();
    }

    selectAllCheckbox.addEventListener("change", function () {
        filteredRows.forEach(row => {
            const checkbox = row.querySelector(".ci-checkbox");

            if (checkbox)
                checkbox.checked = this.checked;
        });

        updateSelection();
    });

    rows.forEach(row => {
        row.querySelector(".ci-checkbox")?.addEventListener(
            "change", updateSelection
        );

        row.addEventListener("click", event => {
            if (event.target.closest(
                ".ci-row-edit, .ci-row-delete, .ci-checkbox"
            )) return;

            const checkbox = row.querySelector(".ci-checkbox");
            checkbox.checked = !checkbox.checked;
            updateSelection();
        });
    });

    body.addEventListener("click", event => {
        const edit = event.target.closest(".ci-row-edit");
        const del = event.target.closest(".ci-row-delete");

        if (!edit && !del) return;

        const row = event.target.closest("tr[data-id]");
        if (!row) return;

        if (edit)
            editRecord(row.dataset.id);

        if (del)
            deleteRecord(row.dataset.id);
    });

    document.querySelector(".ci-buttons")?.addEventListener(
        "click", event => {

            const button = event.target.closest("[data-action]");

            if (!button || button.disabled)
                return;

            const action = button.dataset.action;
            const selected = getSelected();

            switch (action) {

                case "new":
                    window.location.href = "/Master/TaxInvoice";
                    break;

                case "edit":
                    if (selected.length === 1)
                        editRecord(selected[0].value);
                    else
                        alert("Select one Tax Invoice to edit.");
                    break;

                case "clone":
                    if (selected.length !== 1) {
                        alert("Select one Tax Invoice to clone.");
                        return;
                    }

                    window.location.href =
                        "/Master/TaxInvoice?id=" +
                        encodeURIComponent(selected[0].value) +
                        "&clone=true";
                    break;

                case "delete":
                    if (!selected.length) {
                        alert("Select at least one Tax Invoice.");
                        return;
                    }

                    if (selected.length > 1) {
                        alert("Please delete one Tax Invoice at a time.");
                        return;
                    }

                    deleteRecord(selected[0].value);
                    break;

                case "print":
                    window.print();
                    break;

                case "close":
                    history.back();
                    break;

                case "home":
                    window.location.href = "/Home/Index";
                    break;

                default:
                    alert("The " + action + " action is not connected yet.");
                    break;
            }
        }
    );

    searchInput.addEventListener("input", filterRows);

    pageSizeInput.addEventListener("change", () => {
        currentPage = 1;
        renderRows();
    });

    document.getElementById("ciPrevious").addEventListener("click", () => {
        if (currentPage > 1) {
            currentPage--;
            renderRows();
        }
    });

    document.getElementById("ciNext").addEventListener("click", () => {
        const totalPages = Math.max(
            1,
            Math.ceil(filteredRows.length / Number(pageSizeInput.value))
        );

        if (currentPage < totalPages) {
            currentPage++;
            renderRows();
        }
    });

    renderRows();
})();
</script>

