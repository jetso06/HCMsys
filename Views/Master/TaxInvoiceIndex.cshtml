@using System.Text.Json.Nodes
@model List<JsonNode>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Tax Invoice";
    var config = ViewData["Config"] as JsonObject ?? new();
}
<div class="container-fluid txi-page">
 @Html.AntiForgeryToken()
 <div class="card shadow mb-3"><div class="card-header txi-toolbar"><h6 class="txi-title"><i class="fas fa-file-invoice mr-2"></i>TAX INVOICE</h6><div class="txi-buttons" id="txiButtons"></div></div></div>
 <div class="card shadow mb-3"><div class="card-body">
  <div class="row align-items-end mb-3"><div class="col-md-4"><label class="txi-label" for="txiSearch">Advanced Filter</label><input id="txiSearch" class="form-control form-control-sm" placeholder="Search invoice no, client, batch..." /></div><div class="col-md-2"><label class="txi-label" for="txiPageSize">Rows per page</label><select id="txiPageSize" class="form-control form-control-sm"><option>10</option><option>25</option><option>50</option><option>100</option></select></div><div class="col-md-6 text-md-right mt-2"><span id="txiCount" class="txi-count"></span></div></div>
  <div class="table-responsive"><table class="table table-bordered table-hover txi-table"><thead><tr><th><input type="checkbox" id="txiSelectAll" /></th><th>ID</th><th>Invoice No</th><th>Invoice Date</th><th>PostDate</th><th>Client</th><th>Main Frame Agreement</th><th>PayMonth</th><th>Currency</th><th>Print Template</th><th>Invoice Type</th><th>TimeSheet Type</th><th>Comments</th></tr></thead><tbody id="txiBody"></tbody></table></div>
  <div class="d-flex justify-content-between align-items-center mt-3"><span id="txiPageInfo" class="txi-count"></span><div><button class="btn btn-outline-primary btn-sm" id="txiPrev">Previous</button> <button class="btn btn-outline-primary btn-sm" id="txiNext">Next</button></div></div>
 </div></div>
</div>
<style>
.txi-page{padding:18px 0 25px;color:#5a5c69;font-size:13px}.txi-page>.card{border:1px solid #e1e6ed;border-radius:6px;box-shadow:0 4px 14px rgba(58,59,69,.14);overflow:hidden}.txi-toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;padding:14px 18px;background:#eef0f3}.txi-title{margin:0;color:#5a5c69;font-size:.85rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.txi-buttons{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end}.txi-buttons .btn{font-size:.75rem;font-weight:700;box-shadow:0 2px 5px rgba(0,0,0,.08)}.txi-page .card-body{padding:20px 16px}.txi-label{display:block;margin-bottom:5px;color:#596579;font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.055em}.txi-count{color:#858796;font-size:.78rem}.txi-table{width:100%;margin:0;color:#5a5c69;font-size:.76rem;white-space:nowrap}.txi-table thead th{padding:9px 8px;background:#4e73df;color:#fff;border-color:#3d5cbe;font-size:.7rem;font-weight:800;text-align:center;text-transform:uppercase}.txi-table tbody td{padding:7px 8px;border-color:#e3e6f0;vertical-align:middle}.txi-table tbody tr.selected{background:#eef3ff}
</style>
@section Scripts {
<script>
const txiConfig=@Html.Raw(config.ToJsonString());
const txiRows=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
let txiPage=1,txiFiltered=[...txiRows],txiSelected=new Set();
const txiEl=id=>document.getElementById(id);
function txiButtons(){(txiConfig.buttons?.index||[]).forEach(b=>{let x=document.createElement('button');x.type='button';x.id='txi'+b.id.replace(/^btn/,'');x.className='btn btn-'+(b.style||'secondary')+' btn-sm';x.innerHTML='<i class="fas '+b.icon+' mr-1"></i>'+b.text;x.addEventListener('click',()=>txiAction(b.id));txiEl('txiButtons').append(x);});}
function txiAction(id){let chosen=[...txiSelected];switch(id){case'btnHome':location.href='/';break;case'btnNew':location.href='/Master/TaxInvoice';break;case'btnEdit':if(chosen.length!==1){alert('Select one Tax Invoice to edit.');return;}location.href='/Master/TaxInvoice?id='+chosen[0];break;case'btnDelete':if(!chosen.length){alert('Select at least one Tax Invoice.');return;}if(confirm('Delete '+chosen.length+' selected invoice(s)?'))txiDelete(chosen);break;case'btnPrint':window.print();break;case'btnClose':history.back();break;case'btnSave':alert('Open a Tax Invoice to save changes.');break;case'btnClone':if(chosen.length!==1){alert('Select one Tax Invoice to clone.');return;}location.href='/Master/TaxInvoice?id='+chosen[0];break;default:alert(id.replace('btn','')+' is not connected yet.');}}
function txiRender(){let q=txiEl('txiSearch').value.toLowerCase();txiFiltered=txiRows.filter(x=>JSON.stringify(x).toLowerCase().includes(q));let size=Number(txiEl('txiPageSize').value),pages=Math.max(1,Math.ceil(txiFiltered.length/size));txiPage=Math.min(txiPage,pages);let start=(txiPage-1)*size;let body=txiEl('txiBody');body.innerHTML='';txiFiltered.slice(start,start+size).forEach(x=>{let tr=document.createElement('tr');let cb=document.createElement('input');cb.type='checkbox';cb.checked=txiSelected.has(Number(x.id));cb.addEventListener('change',()=>{cb.checked?txiSelected.add(Number(x.id)):txiSelected.delete(Number(x.id));tr.classList.toggle('selected',cb.checked);});let vals=[null,x.id,x.invoiceNo,x.invoiceDate,x.postDate,x.clientName||x.client,x.mainFrameAgreementName||x.mainFrameAgreement,x.payMonth,x.currency,x.printTemplateText||x.printTemplate,x.invoiceTypeText||x.invoiceType,x.timeSheetTypeText||x.timeSheetType,x.comments];vals.forEach((v,i)=>{let td=document.createElement('td');if(i===0)td.append(cb);else td.textContent=v??'';tr.append(td);});if(txiSelected.has(Number(x.id)))tr.classList.add('selected');body.append(tr);});txiEl('txiCount').textContent=txiFiltered.length+' records';txiEl('txiPageInfo').textContent='Page '+txiPage+' of '+pages;txiEl('txiPrev').disabled=txiPage<=1;txiEl('txiNext').disabled=txiPage>=pages;}
async function txiDelete(ids){for(const id of ids){let token=document.querySelector('input[name="__RequestVerificationToken"]')?.value||'';let r=await fetch('/Master/TaxInvoice/Delete/'+id,{method:'POST',headers:{'RequestVerificationToken':token}});if(!r.ok){alert('Could not delete invoice ID '+id);return;}}location.reload();}
document.addEventListener('DOMContentLoaded',()=>{txiButtons();txiRender();txiEl('txiSearch').addEventListener('input',()=>{txiPage=1;txiRender();});txiEl('txiPageSize').addEventListener('change',()=>{txiPage=1;txiRender();});txiEl('txiPrev').addEventListener('click',()=>{txiPage--;txiRender();});txiEl('txiNext').addEventListener('click',()=>{txiPage++;txiRender();});txiEl('txiSelectAll').addEventListener('change',e=>{let size=Number(txiEl('txiPageSize').value),start=(txiPage-1)*size;txiFiltered.slice(start,start+size).forEach(x=>e.target.checked?txiSelected.add(Number(x.id)):txiSelected.delete(Number(x.id)));txiRender();});});
</script>
}
