
@using System.Text.Json
@using System.Text.Json.Nodes
@using System.Globalization
@model List<JsonNode>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var config = ViewData["Config"] as JsonObject ?? new JsonObject();
    var page = config["page"] as JsonObject;

    var buttons = config["buttons"]?["index"] as JsonArray
                  ?? new JsonArray();

    var rows = Model ?? new List<JsonNode>();

    var columns = config["index"]?["columns"] as JsonArray
              ?? new JsonArray();

    var visibleColumns = columns
        .OfType<JsonObject>()
        .Where(c => c["visible"]?.GetValue<bool>() != false)
        .ToList();

    ViewData["Title"] = page?["title"]?.ToString() ?? "Tax Invoice";

    string GetValue(JsonNode? row, string field)
    {
        if (row is not JsonObject obj)
            return "";

        // Try the configured field first.
        var property = obj.FirstOrDefault(p =>
            string.Equals(p.Key, field, StringComparison.OrdinalIgnoreCase));

        if (property.Value != null)
            return property.Value.ToString();

        // Support alternative display properties.
        var alternative = field switch
        {
            "clientName" => "client",
            "mainFrameAgreementName" => "mainFrameAgreement",
            "printTemplateText" => "printTemplate",
            "invoiceTypeText" => "invoiceType",
            "timeSheetTypeText" => "timeSheetType",
            _ => ""
        };

        if (!string.IsNullOrEmpty(alternative))
        {
            property = obj.FirstOrDefault(p =>
                string.Equals(p.Key, alternative, StringComparison.OrdinalIgnoreCase));

            if (property.Value != null)
                return property.Value.ToString();
        }

        return "";
    }

    string FormatValue(string field, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";

        var normalized = field.ToLowerInvariant();

        if (normalized.Contains("date") &&
            DateTime.TryParse(value, CultureInfo.InvariantCulture,
                DateTimeStyles.None, out var date))
        {
            return normalized.Contains("time")
                ? date.ToString("dd-MM-yyyy HH:mm")
                : date.ToString("dd-MM-yyyy");
        }

        return value;
    }
}

<div class="container-fluid candidate-index">

    <!-- MASTER TOOLBAR -->
    <div class="card ci-card ci-toolbar-card">
        <div class="card-header ci-toolbar">

            <h6 class="ci-title">
                <i class="fas @(page?["icon"]?.ToString() ?? "fa-file-invoice")"></i>
                @(page?["title"]?.ToString() ?? "Tax Invoice")
                <span class="ci-module-badge">TAX INVOICE</span>
            </h6>

            <div class="ci-buttons">
                @foreach (var button in buttons)
                {
                    if (button?["visible"]?.GetValue<bool>() == false)
                        continue;

                    var id = button?["id"]?.ToString() ?? "";
                    var label = button?["label"]?.ToString()
                                ?? button?["text"]?.ToString() ?? id;

                    var icon = button?["icon"]?.ToString() ?? "";
                    var style = button?["style"]?.ToString() ?? "secondary";
                    var action = id.Replace("btn", "").ToLowerInvariant();

                    <button type="button"
                            class="btn btn-@style btn-sm shadow-sm"
                            data-action="@action">
                        <i class="fas @icon"></i>
                        @label
                    </button>
                }
            </div>

        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row ci-summary">

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-primary">
                <div class="card-body">
                    <div class="ci-summary-label">Total Records</div>
                    <div class="ci-summary-value">@rows.Count</div>
                    <i class="fas fa-layer-group ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-info">
                <div class="card-body">
                    <div class="ci-summary-label">Displayed Records</div>
                    <div class="ci-summary-value" id="ciDisplayed">@rows.Count</div>
                    <i class="fas fa-list ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-success">
                <div class="card-body">
                    <div class="ci-summary-label">Selected Record</div>
                    <div class="ci-summary-value" id="ciSelected">None</div>
                    <i class="fas fa-file-alt ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-warning">
                <div class="card-body">
                    <div class="ci-summary-label">Module</div>
                    <div class="ci-summary-module">Tax Invoice</div>
                    <i class="fas fa-file-invoice ci-summary-icon"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- RECORDS CARD -->
    <div class="card ci-card ci-records-card">

        <div class="card-header ci-records-header">
    <h6>
        <i class="fas fa-table"></i>
        @(config["index"]?["heading"]?.ToString() ?? page?["title"]?.ToString())
    </h6>

    <span class="badge badge-primary" id="ciRecordCount">
        @rows.Count Records
    </span>
</div>

        <div class="card-body">

            <!-- TABLE TOOLS -->
            <div class="ci-table-tools">

                <div class="ci-page-size">
                    <span>Show</span>

                    <select id="ciPageSize" class="form-control form-control-sm">
                        <option value="20">20</option>
                        <option value="35">35</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>

                    <span>entries</span>
                </div>

                <input type="text"
                       id="ciSearch"
                       class="form-control form-control-sm ci-search"
                       placeholder="Search tax invoice records..." />

            </div>

            <!-- RECORD TABLE -->
            <div class="table-responsive">

                <table class="table table-bordered table-striped table-hover"
                       id="ciTable">

                    <thead>
                        <tr>
                            <th class="ci-control-column">
                                <div class="ci-select-header">
                                    <span>Select</span>
                                    <input type="checkbox" id="ciSelectAll" />
                                </div>
                            </th>

                            <th class="ci-action-column">Action</th>

                            @foreach (var column in visibleColumns)
{
    var field = column["field"]?.ToString() ?? "";
    var label = column["label"]?.ToString() ?? "";

    <th>
        @label

        @if (field.Equals("ave", StringComparison.OrdinalIgnoreCase))
        {
            <i class="fas fa-info-circle ci-tooltip"
               title="Y = Approved | N = Rejected | P = Pending"></i>
        }
        else if (field.Equals("appSt", StringComparison.OrdinalIgnoreCase))
        {
            <i class="fas fa-info-circle ci-tooltip"
               title="P = Pending / Posted | A = Approved | R = Rejected | U = Under Review"></i>
        }
    </th>
}
                        </tr>
                    </thead>

                    <tbody id="ciTableBody">

                        @if (rows.Count > 0)
                        {
                            foreach (var row in rows)
                            {
                                var id = GetValue(row, "id");
                                var invoiceNo = GetValue(row, "invoiceNo");

                                <tr data-id="@id">

                                    <td class="text-center ci-control-column">
                                        <input type="checkbox"
                                               class="ci-checkbox"
                                               value="@id" />
                                    </td>

                                    <td class="text-center ci-action-column">

                                        <button type="button"
                                                class="ci-row-edit"
                                                title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="ci-row-delete"
                                                title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>

                                    </td>

                                    @foreach (var column in visibleColumns)
                                    {
                                        var field = column["field"]?.ToString() ?? "";
                                        var value = FormatValue(field, GetValue(row, field));

                                        <td title="@value">@value</td>
                                    }

                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="ci-no-data">
                                <td colspan="@(visibleColumns.Count + 2)" class="ci-empty">
                                    No Tax Invoice records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- PAGINATION -->
            <div class="ci-table-footer">

                <span id="ciShowing">Showing 0 records</span>

                <div class="ci-pagination">

                    <button class="btn btn-light btn-sm"
                            id="ciPrevious" type="button">
                        Previous
                    </button>

                    <span id="ciPageInfo">0 / 0</span>

                    <button class="btn btn-light btn-sm"
                            id="ciNext" type="button">
                        Next
                    </button>

                </div>

            </div>

        </div>
    </div>

</div>

