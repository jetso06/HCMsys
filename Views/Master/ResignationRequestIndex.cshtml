
@model List<HCMSys.Controllers.ResignationRecord>
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var config = (HCMSys.Controllers.ResignationConfig)ViewBag.ResignationConfig;
    var records = Model ?? new List<HCMSys.Controllers.ResignationRecord>();

    var configJson = JsonSerializer.Serialize(
        config,
        new JsonSerializerOptions(JsonSerializerDefaults.Web));

    var total = records.Count;
    var pending = records.Count(r =>
        string.Equals(r.ApprovalStatus, "Pending", StringComparison.OrdinalIgnoreCase));
    var approved = records.Count(r =>
        string.Equals(r.ApprovalStatus, "Approved", StringComparison.OrdinalIgnoreCase));
    var rejected = records.Count(r =>
        string.Equals(r.ApprovalStatus, "Rejected", StringComparison.OrdinalIgnoreCase));
}

<div class="container-fluid rr-index">

    <!-- MASTER TOOLBAR -->
    <div class="card rr-card rr-toolbar-card">
        <div class="card-header rr-toolbar">
            <h6 class="rr-title">
                <i class="fas fa-file-signature"></i>
                <span id="rrIndexTitle"></span>
                <span class="rr-module-badge">@config.ModuleId</span>
            </h6>

            <div class="rr-buttons">
                <a class="btn btn-success btn-sm"
                   href="@Url.Content("~/Master/ResignationRequest")">
                    <i class="fas fa-plus"></i>
                    <span data-button="new"></span>
                </a>

                <button class="btn btn-primary btn-sm" id="rrEdit" type="button">
                    <i class="fas fa-edit"></i>
                    <span data-button="edit"></span>
                </button>

                <a class="btn btn-primary btn-sm"
                   href="@Url.Content("~/Master/ResignationRequest")">
                    <i class="fas fa-save"></i>
                    <span data-button="save"></span>
                </a>

                <button class="btn btn-info btn-sm" id="rrClone" type="button">
                    <i class="fas fa-copy"></i>
                    <span data-button="clone"></span>
                </button>

                <button class="btn btn-warning btn-sm" id="rrUnPost" type="button">
                    <i class="fas fa-undo"></i>
                    <span data-button="unPost"></span>
                </button>

                <button class="btn btn-secondary btn-sm" type="button"
                        onclick="window.print()">
                    <i class="fas fa-print"></i>
                    <span data-button="print"></span>
                </button>

                <button class="btn btn-danger btn-sm" id="rrDelete" type="button">
                    <i class="fas fa-trash"></i>
                    <span data-button="delete"></span>
                </button>

                <button class="btn btn-success btn-sm" id="rrApprove" type="button">
                    <i class="fas fa-check"></i>
                    <span data-button="approve"></span>
                </button>

                <button class="btn btn-danger btn-sm" id="rrReject" type="button">
                    <i class="fas fa-times"></i>
                    <span data-button="reject"></span>
                </button>

                <button class="btn btn-info btn-sm" id="rrAuthTracker" type="button">
                    <i class="fas fa-route"></i>
                    <span data-button="authTracker"></span>
                </button>

                <a class="btn btn-secondary btn-sm"
                   href="@Url.Content("~/Master/ResignationRequest")">
                    <i class="fas fa-times-circle"></i>
                    <span data-button="close"></span>
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success mt-3">@success</div>
    }

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger mt-3">@error</div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row rr-summary">
        <div class="col-xl-3 col-md-6">
            <div class="card rr-card rr-summary-card rr-border-primary">
                <div class="card-body">
                    <div class="rr-summary-label" id="rrTotalLabel"></div>
                    <div class="rr-summary-value">@total</div>
                    <i class="fas fa-layer-group rr-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card rr-card rr-summary-card rr-border-warning">
                <div class="card-body">
                    <div class="rr-summary-label" id="rrPendingLabel"></div>
                    <div class="rr-summary-value">@pending</div>
                    <i class="fas fa-clock rr-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card rr-card rr-summary-card rr-border-success">
                <div class="card-body">
                    <div class="rr-summary-label" id="rrApprovedLabel"></div>
                    <div class="rr-summary-value">@approved</div>
                    <i class="fas fa-check-circle rr-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card rr-card rr-summary-card rr-border-info">
                <div class="card-body">
                    <div class="rr-summary-label" id="rrModuleLabel"></div>
                    <div class="rr-summary-module">@config.ModuleName</div>
                    <i class="fas fa-sitemap rr-summary-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- RECORDS CARD -->
    <div class="card rr-card rr-records-card">
        <div class="card-header rr-records-header">
            <h6>
                <i class="fas fa-table"></i>
                <span id="rrRecordsTitle"></span>
            </h6>
            <span class="badge badge-primary" id="rrRecordCount"></span>
        </div>

        <div class="card-body">

            <div class="rr-table-tools">
                <div class="rr-page-size">
                    <span id="rrShowText"></span>
                    <select id="rrPageSize" class="form-control form-control-sm">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span id="rrEntriesText"></span>
                </div>

                <input id="rrSearch"
                       class="form-control form-control-sm rr-search"
                       placeholder="" />
            </div>

            <div class="row rr-filters">
                <div class="col-md-4 form-group">
                    <label id="rrStatusLabel" for="rrStatusFilter"></label>
                    <select id="rrStatusFilter" class="form-control form-control-sm">
                        <option value="">All Statuses</option>
                        @foreach (var status in config.Options["approvalStatus"])
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

                <div class="col-md-3 form-group">
                    <label id="rrFromLabel" for="rrFrom"></label>
                    <input type="date" id="rrFrom"
                           class="form-control form-control-sm" />
                </div>

                <div class="col-md-3 form-group">
                    <label id="rrToLabel" for="rrTo"></label>
                    <input type="date" id="rrTo"
                           class="form-control form-control-sm" />
                </div>

                <div class="col-md-2 form-group d-flex align-items-end">
                    <button class="btn btn-light btn-sm border" id="rrClear" type="button">
                        <i class="fas fa-eraser"></i>
                        <span id="rrClearText"></span>
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover" id="rrTable">
                    <thead>
                        <tr>
                            <th class="rr-select-column">
                                <input type="checkbox" id="rrSelectAll" />
                            </th>
                            <th>#</th>
                            @foreach (var column in config.Index.Columns)
                            {
                                <th data-column="@column.Key">@column.Label</th>
                            }
                        </tr>
                    </thead>
                    <tbody id="rrTableBody">
                        @foreach (var record in records)
                        {
                            <tr data-document="@record.DocumentNo"
                                data-date="@record.Date.ToString("yyyy-MM-dd")"
                                data-status="@(record.ApprovalStatus ?? "Pending")"
                                data-search="@($"{record.DocumentNo} {record.EmployeeCode} {record.EmployeeName} {record.Department} {record.NoticePeriod} {record.Comments}")">

                                <td class="text-center">
                                    <input type="checkbox" class="rr-select" />
                                </td>
                                <td class="rr-serial"></td>
                                <td data-key="documentNo">@record.DocumentNo</td>
                                <td data-key="date">@record.Date.ToString("dd-MM-yyyy")</td>
                                <td data-key="employeeCode">@record.EmployeeCode</td>
                                <td data-key="employeeName">@record.EmployeeName</td>
                                <td data-key="department">@record.Department</td>
                                <td data-key="noticePeriod">@record.NoticePeriod</td>
                                <td data-key="lastWorkingDay">
                                    @(record.LastWorkingDay?.ToString("dd-MM-yyyy") ?? "")
                                </td>
                                <td data-key="approvalStatus">
                                    <span class="rr-status-badge"
                                          data-status="@(record.ApprovalStatus ?? "Pending")">
                                        @(record.ApprovalStatus ?? "Pending")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="rr-empty" id="rrEmpty" hidden></div>

            <div class="rr-table-footer">
                <span id="rrShowing"></span>
                <div class="rr-pagination">
                    <button class="btn btn-light btn-sm" id="rrPrevious" type="button"></button>
                    <span id="rrPageInfo"></span>
                    <button class="btn btn-light btn-sm" id="rrNext" type="button"></button>
                </div>
            </div>
        </div>
    </div>

    <form id="rrDeleteForm" method="post"
          action="@Url.Content("~/Master/ResignationRequest/Delete")" hidden>
        @Html.AntiForgeryToken()
        <input name="documentNo" id="rrDeleteDocumentNo" />
    </form>
</div>

