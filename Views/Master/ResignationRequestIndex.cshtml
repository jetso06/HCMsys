@section Scripts {
<script>
    const rrIndexConfig = @Html.Raw(configJson);

    // Apply toolbar captions and index text from JSON.
    document.getElementById("rrIndexTitle").textContent =
        rrIndexConfig.index.title;

    document.getElementById("rrRecordsTitle").textContent =
        rrIndexConfig.index.recordsTitle || rrIndexConfig.index.title;

    document.getElementById("rrTotalLabel").textContent =
        rrIndexConfig.index.summaryLabels?.total || "Total Requests";

    document.getElementById("rrPendingLabel").textContent =
        rrIndexConfig.index.summaryLabels?.pending || "Pending Approval";

    document.getElementById("rrApprovedLabel").textContent =
        rrIndexConfig.index.summaryLabels?.approved || "Approved Requests";

    document.getElementById("rrModuleLabel").textContent =
        rrIndexConfig.index.summaryLabels?.module || "Module";

    document.getElementById("rrShowText").textContent =
        rrIndexConfig.index.filters?.show || "Show";

    document.getElementById("rrEntriesText").textContent =
        rrIndexConfig.index.filters?.entries || "entries";

    document.getElementById("rrStatusLabel").textContent =
        rrIndexConfig.index.filters?.approvalStatus || "Approval Status";

    document.getElementById("rrFromLabel").textContent =
        rrIndexConfig.index.filters?.fromDate || "From Date";

    document.getElementById("rrToLabel").textContent =
        rrIndexConfig.index.filters?.toDate || "To Date";

    document.getElementById("rrClearText").textContent =
        rrIndexConfig.index.filters?.clear || "Clear";

    document.getElementById("rrPrevious").textContent =
        rrIndexConfig.index.filters?.previous || "Previous";

    document.getElementById("rrNext").textContent =
        rrIndexConfig.index.filters?.next || "Next";

    document.getElementById("rrSearch").placeholder =
        rrIndexConfig.index.searchPlaceholder;

    document.getElementById("rrEmpty").textContent =
        rrIndexConfig.index.emptyMessage;

    document.querySelectorAll("[data-button]").forEach(element => {
        const key = element.dataset.button;
        element.append(document.createTextNode(
            rrIndexConfig.buttons[key] || key
        ));
    });

    const rrBody = document.getElementById("rrTableBody");
    const rrRows = Array.from(rrBody.querySelectorAll("tr"));
    const rrSearch = document.getElementById("rrSearch");
    const rrStatus = document.getElementById("rrStatusFilter");
    const rrFrom = document.getElementById("rrFrom");
    const rrTo = document.getElementById("rrTo");
    const rrPageSize = document.getElementById("rrPageSize");

    let rrFilteredRows = [];
    let rrCurrentPage = 1;

    function rrFilterRows() {
        const query = rrSearch.value.trim().toLowerCase();

        rrFilteredRows = rrRows.filter(row => {
            const textMatch =
                !query || (row.dataset.search || "").toLowerCase().includes(query);

            const statusMatch =
                !rrStatus.value ||
                (row.dataset.status || "").toLowerCase() ===
                    rrStatus.value.toLowerCase();

            const date = row.dataset.date || "";
            const dateMatch =
                (!rrFrom.value || date >= rrFrom.value) &&
                (!rrTo.value || date <= rrTo.value);

            return textMatch && statusMatch && dateMatch;
        });

        rrCurrentPage = 1;
        rrRenderRows();
    }

    function rrRenderRows() {
        const pageSize = Number(rrPageSize.value);
        const totalPages = Math.max(1, Math.ceil(rrFilteredRows.length / pageSize));
        rrCurrentPage = Math.min(rrCurrentPage, totalPages);

        rrRows.forEach(row => row.hidden = true);

        const start = (rrCurrentPage - 1) * pageSize;
        const visibleRows = rrFilteredRows.slice(start, start + pageSize);

        visibleRows.forEach((row, index) => {
            row.hidden = false;
            row.querySelector(".rr-serial").textContent = start + index + 1;
        });

        document.getElementById("rrRecordCount").textContent =
            `${rrFilteredRows.length} ${rrFilteredRows.length === 1 ? "Record" : "Records"}`;

        document.getElementById("rrShowing").textContent =
            rrFilteredRows.length
                ? `Showing ${start + 1} to ${start + visibleRows.length} of ${rrFilteredRows.length} requests`
                : "Showing 0 requests";

        document.getElementById("rrPageInfo").textContent =
            rrFilteredRows.length ? `${rrCurrentPage} / ${totalPages}` : "0 / 0";

        document.getElementById("rrEmpty").hidden =
            rrFilteredRows.length !== 0;

        document.getElementById("rrPrevious").disabled =
            rrCurrentPage <= 1;

        document.getElementById("rrNext").disabled =
            rrCurrentPage >= totalPages;
    }

    [rrSearch, rrStatus, rrFrom, rrTo].forEach(element => {
        element.addEventListener("input", rrFilterRows);
        element.addEventListener("change", rrFilterRows);
    });

    rrPageSize.addEventListener("change", rrFilterRows);

    document.getElementById("rrClear").addEventListener("click", () => {
        rrSearch.value = "";
        rrStatus.value = "";
        rrFrom.value = "";
        rrTo.value = "";
        rrFilterRows();
    });

    document.getElementById("rrPrevious").addEventListener("click", () => {
        if (rrCurrentPage > 1) {
            rrCurrentPage--;
            rrRenderRows();
        }
    });

    document.getElementById("rrNext").addEventListener("click", () => {
        const totalPages = Math.max(
            1, Math.ceil(rrFilteredRows.length / Number(rrPageSize.value)));

        if (rrCurrentPage < totalPages) {
            rrCurrentPage++;
            rrRenderRows();
        }
    });

    function rrSelectedRow() {
        const selected = rrRows.filter(row =>
            row.querySelector(".rr-select").checked);

        if (selected.length !== 1) {
            alert("Please select exactly one resignation request.");
            return null;
        }

        return selected[0];
    }

    document.getElementById("rrSelectAll").addEventListener("change", event => {
        rrRows.filter(row => !row.hidden).forEach(row => {
            row.querySelector(".rr-select").checked = event.target.checked;
        });
    });

    document.getElementById("rrEdit").addEventListener("click", () => {
        const row = rrSelectedRow();
        if (!row) return;

        window.location.href =
            '@Url.Content("~/Master/ResignationRequest")' +
            '?documentNo=' + encodeURIComponent(row.dataset.document);
    });

    document.getElementById("rrClone").addEventListener("click", () => {
        const row = rrSelectedRow();
        if (!row) return;

        window.location.href =
            '@Url.Content("~/Master/ResignationRequest")' +
            '?documentNo=' + encodeURIComponent(row.dataset.document);
    });

    document.getElementById("rrDelete").addEventListener("click", () => {
        const row = rrSelectedRow();
        if (!row) return;

        if (confirm(rrIndexConfig.messages.confirmDelete)) {
            document.getElementById("rrDeleteDocumentNo").value =
                row.dataset.document;
            document.getElementById("rrDeleteForm").submit();
        }
    });

    document.getElementById("rrApprove").addEventListener("click", () => {
        if (rrSelectedRow()) {
            alert("Approval status updates need to be implemented in the controller.");
        }
    });

    document.getElementById("rrReject").addEventListener("click", () => {
        if (rrSelectedRow()) {
            alert("Rejection status updates need to be implemented in the controller.");
        }
    });

    document.getElementById("rrUnPost").addEventListener("click", () => {
        if (rrSelectedRow()) {
            alert("UnPost functionality is not implemented yet.");
        }
    });

    document.getElementById("rrAuthTracker").addEventListener("click", () => {
        if (rrSelectedRow()) {
            alert("Auth Tracker functionality is not implemented yet.");
        }
    });

    rrFilterRows();
</script>
}
