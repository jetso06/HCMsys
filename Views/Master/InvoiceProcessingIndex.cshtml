@using System.Text.Json.Nodes
@model List<JsonNode>

@{
    ViewData["Title"] = "Invoice Processing";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var invoices = Model ?? new List<JsonNode>();
    var total = invoices.Count;

    var columns = new[]
    {
        new { Field = "id", Header = "ID" },
        new { Field = "batchNo", Header = "Batch No" },
        new { Field = "date", Header = "Date" },
        new { Field = "postDate", Header = "Post Date" },
        new { Field = "client", Header = "Client" },
        new { Field = "mainFrameAgreement", Header = "Main Frame Agreement" },
        new { Field = "payMonth", Header = "PayMonth" },
        new { Field = "invoiceType", Header = "Invoice Type" },
        new { Field = "timeSheetType", Header = "TimeSheet Type" },
        new { Field = "comments", Header = "Comments" }
    };
}

<div class="container-fluid candidate-index">

    <!-- MASTER TOOLBAR -->
    <div class="card ci-card ci-toolbar-card">
        <div class="card-header ci-toolbar">

            <h6 class="ci-title">
                <i class="fas fa-file-invoice"></i>
                Invoice Processing
                <span class="ci-module-badge">INVOICE PROCESSING</span>
            </h6>

            <div class="ci-buttons">

                <a href="/Master/InvoiceProcessing"
                   class="btn btn-success btn-sm shadow-sm">
                    <i class="fas fa-plus"></i> New
                </a>

                <button type="button" id="ciEdit"
                        class="btn btn-primary btn-sm shadow-sm">
                    <i class="fas fa-edit"></i> Edit
                </button>

                <button type="button" id="ciSave"
                        class="btn btn-primary btn-sm shadow-sm" disabled>
                    <i class="fas fa-save"></i> Save
                </button>

                <button type="button" id="ciClone"
                        class="btn btn-info btn-sm shadow-sm" disabled>
                    <i class="fas fa-copy"></i> Clone
                </button>

                <button type="button" id="ciUnPost"
                        class="btn btn-secondary btn-sm shadow-sm" disabled>
                    <i class="fas fa-undo"></i> UnPost
                </button>

                <button type="button" id="ciPrint"
                        class="btn btn-light btn-sm shadow-sm">
                    <i class="fas fa-print"></i> Print
                </button>

                <button type="button" id="ciDelete"
                        class="btn btn-danger btn-sm shadow-sm">
                    <i class="fas fa-trash"></i> Delete
                </button>

                <button type="button" id="ciApprove"
                        class="btn btn-success btn-sm shadow-sm" disabled>
                    <i class="fas fa-check"></i> Approve
                </button>

                <button type="button" id="ciReject"
                        class="btn btn-danger btn-sm shadow-sm" disabled>
                    <i class="fas fa-times"></i> Reject
                </button>

                <button type="button" id="ciAuthTracker"
                        class="btn btn-info btn-sm shadow-sm" disabled>
                    <i class="fas fa-history"></i> Auth Tracker
                </button>

                <button type="button" id="ciClose"
                        class="btn btn-light btn-sm shadow-sm">
                    <i class="fas fa-times-circle"></i> Close
                </button>

            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row ci-summary">

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-primary">
                <div class="card-body">
                    <div class="ci-summary-label">Total Invoices</div>
                    <div class="ci-summary-value" id="ciTotal">@total</div>
                    <i class="fas fa-file-invoice ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-info">
                <div class="card-body">
                    <div class="ci-summary-label">Displayed Records</div>
                    <div class="ci-summary-value" id="ciDisplayed">@total</div>
                    <i class="fas fa-list ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-success">
                <div class="card-body">
                    <div class="ci-summary-label">Selected Invoice</div>
                    <div class="ci-summary-value" id="ciSelected">None</div>
                    <i class="fas fa-file-alt ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-warning">
                <div class="card-body">
                    <div class="ci-summary-label">Module</div>
                    <div class="ci-summary-module">Invoice Processing</div>
                    <i class="fas fa-sitemap ci-summary-icon"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- RECORDS CARD -->
    <div class="card ci-card ci-records-card">

        <div class="card-header ci-records-header">

            <h6>
                <i class="fas fa-table"></i>
                Invoice Records
            </h6>

            <span class="badge badge-primary" id="ciRecordCount">
                @total Records
            </span>

        </div>

        <div class="card-body">

            <div class="ci-table-tools">

                <div class="ci-page-size">
                    <span>Show</span>

                    <select id="ciPageSize"
                            class="form-control form-control-sm">
                        <option value="20">20</option>
                        <option value="35">35</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>

                    <span>entries</span>
                </div>

                <input type="text"
                       id="ciSearch"
                       class="form-control form-control-sm ci-search"
                       placeholder="Search invoices..." />

            </div>

            <div class="table-responsive">

                <table class="table table-bordered table-striped table-hover"
                       id="ciTable">

                    <thead>
                        <tr>
                            <th class="ci-control-column">Select</th>
                            <th class="ci-action-column">Action</th>

                            @foreach (var column in columns)
                            {
                                <th>@column.Header</th>
                            }
                        </tr>
                    </thead>

                    <tbody id="ciTableBody">

                        @if (invoices.Count > 0)
                        {
                            foreach (var item in invoices)
                            {
                                var id = item["id"]?.ToString() ?? "";

                                <tr data-id="@id">

                                    <td class="text-center ci-control-column">
                                        <input type="checkbox"
                                               class="ci-checkbox"
                                               value="@id" />
                                    </td>

                                    <td class="text-center ci-action-column">

                                        <button type="button"
                                                class="ci-row-edit"
                                                title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <button type="button"
                                                class="ci-row-delete"
                                                title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>

                                    </td>

                                    @foreach (var column in columns)
                                    {
                                        var value = item[column.Field]?.ToString() ?? "";

                                        if (column.Field == "invoiceType")
                                        {
                                            value = value switch
                                            {
                                                "0" => "Single Emp Invoice",
                                                "1" => "Multiple Emp Invoice",
                                                _ => value
                                            };
                                        }

                                        if (column.Field == "timeSheetType")
                                        {
                                            value = value switch
                                            {
                                                "0" => "Attendance & OT",
                                                "1" => "OT Only",
                                                _ => value
                                            };
                                        }

                                        <td>@value</td>
                                    }

                                </tr>
                            }
                        }
                        else
                        {
                            <tr class="ci-no-data">
                                <td colspan="@(columns.Length + 2)"
                                    class="ci-empty">
                                    No invoice records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="ci-empty ci-filter-empty" id="ciFilterEmpty" hidden>
                No matching invoice records found.
            </div>

            <div class="ci-table-footer">

                <span id="ciShowing">Showing 0 records</span>

                <div class="ci-pagination">

                    <button class="btn btn-light btn-sm"
                            id="ciPrevious" type="button">
                        Previous
                    </button>

                    <span id="ciPageInfo">0 / 0</span>

                    <button class="btn btn-light btn-sm"
                            id="ciNext" type="button">
                        Next
                    </button>

                </div>

            </div>

        </div>
    </div>

</div>

<style>
    html {
        font-size: 14px;
    }

    .candidate-index {
        width: 100%;
        padding: 18px 0 25px;
        color: #5a5c69;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 13px;
    }

    .candidate-index .ci-card {
        border: 1px solid #e1e6ed;
        border-radius: 6px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(58,59,69,.14) !important;
        overflow: hidden;
    }

    .ci-toolbar-card {
        margin-bottom: 20px;
    }

    .ci-toolbar,
    .ci-records-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        padding: 14px 18px;
        background: #eef0f3;
        border: 0;
        border-bottom: 1px solid #e1e6ed;
    }

    .ci-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: #5a5c69;
        font-size: .85rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .ci-title i,
    .ci-records-header i {
        color: #4e73df;
    }

    .ci-module-badge {
        padding: 3px 7px;
        border: 1px solid #ccd3db;
        border-radius: 4px;
        background: #e5e9ee;
        color: #4b5563;
        font-size: .68rem;
        letter-spacing: normal;
    }

    .ci-buttons {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    .ci-buttons .btn {
        padding: 5px 9px;
        border-radius: 4px;
        font-size: .8rem;
        font-weight: 700;
        box-shadow: 0 .1rem .3rem rgba(0,0,0,.08);
    }

    .ci-buttons .btn i {
        margin-right: 4px;
    }

    .ci-summary {
        margin-bottom: 8px;
    }

    .ci-summary > div {
        margin-bottom: 16px;
    }

    .ci-summary-card {
        min-height: 78px;
    }

    .ci-summary-card .card-body {
        position: relative;
        padding: 15px 16px;
    }

    .ci-summary-label {
        margin-bottom: 4px;
        color: #4e73df;
        font-size: .7rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .ci-summary-value,
    .ci-summary-module {
        color: #5a5c69;
        font-size: 1.05rem;
        font-weight: 800;
    }

    #ciSelected {
        font-size: .9rem;
    }

    .ci-summary-icon {
        position: absolute;
        top: 22px;
        right: 16px;
        color: #dddfeb;
        font-size: 1.5rem;
    }

    .ci-border-primary {
        border-left: 4px solid #4e73df !important;
    }

    .ci-border-warning {
        border-left: 4px solid #f6c23e !important;
    }

    .ci-border-success {
        border-left: 4px solid #1cc88a !important;
    }

    .ci-border-info {
        border-left: 4px solid #36b9cc !important;
    }

    .ci-summary .ci-border-primary .ci-summary-label {
        color: #4e73df !important;
    }

    .ci-summary .ci-border-warning .ci-summary-label {
        color: #f6c23e !important;
    }

    .ci-summary .ci-border-success .ci-summary-label {
        color: #1cc88a !important;
    }

    .ci-summary .ci-border-info .ci-summary-label {
        color: #36b9cc !important;
    }

    .ci-records-card {
        margin-bottom: 20px;
    }

    .ci-records-header h6 {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: #4e73df;
        font-size: .9rem;
        font-weight: 800;
    }

    .ci-records-header .badge {
        padding: 5px 8px;
        font-size: .7rem;
    }

    .ci-records-card .card-body {
        padding: 16px;
    }

    .ci-table-tools {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }

    .ci-page-size {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-page-size select {
        width: 60px;
    }

    .ci-search {
        width: 320px;
        max-width: 100%;
    }

    .candidate-index .form-control {
        min-height: 32px;
        border: 1px solid #d2d0cb;
        border-radius: 5px;
        color: #5a5c69;
        font-family: inherit;
        font-size: .83rem;
        box-shadow: none;
    }

    .candidate-index .form-control:focus {
        border-color: #7d9fe5;
        box-shadow: 0 0 0 .18rem rgba(78,115,223,.14);
    }

    #ciTable {
        width: 100%;
        margin-bottom: 0;
        white-space: nowrap;
    }

    #ciTable thead th {
        padding: 10px 8px;
        background: #4e73df;
        color: #fff;
        border-color: #3d5cbe;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        vertical-align: middle;
    }

    #ciTable tbody td {
        padding: 8px;
        color: #5a5c69;
        font-size: .8rem;
        vertical-align: middle;
    }

    #ciTable tbody tr:hover {
        background-color: #f3f6ff;
    }

    .ci-row-edit,
    .ci-row-delete {
        border: none;
        background: transparent;
        padding: 4px 7px;
        cursor: pointer;
        font-size: .9rem;
    }

    .ci-row-edit {
        color: #4e73df;
    }

    .ci-row-delete {
        color: #e74a3b;
    }

    .ci-row-edit:hover,
    .ci-row-delete:hover {
        opacity: .7;
    }

    .ci-checkbox {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .ci-action-column {
        text-align: center;
        min-width: 85px;
    }

    #ciTable tbody tr.selected {
        background-color: #eaecf4;
    }

    .ci-empty {
        padding: 24px !important;
        color: #858796;
        text-align: center !important;
    }

    .ci-table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 14px;
        color: #858796;
        font-size: .8rem;
    }

    .ci-pagination {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-pagination .btn {
        border: 1px solid #e3e6f0;
        background: #fff;
        color: #5a5c69;
    }

    .ci-pagination .btn:disabled {
        opacity: .45;
        cursor: not-allowed;
    }

    @@media (max-width: 768px) {
        .ci-toolbar {
            align-items: flex-start;
        }

        .ci-buttons {
            width: 100%;
        }

        .ci-search {
            width: 100%;
        }
    }

    @@media print {
        .ci-buttons,
        .ci-table-tools,
        .ci-table-footer,
        .ci-control-column,
        .ci-action-column {
            display: none !important;
        }

        .candidate-index .ci-card {
            box-shadow: none !important;
        }
    }
</style>

<script>
    (() => {
        const body = document.getElementById("ciTableBody");
        const searchInput = document.getElementById("ciSearch");
        const pageSizeInput = document.getElementById("ciPageSize");

        const rows = Array.from(
            body.querySelectorAll("tr[data-id]")
        );

        let selectedInvoiceId = null;
        let filteredRows = rows.slice();
        let currentPage = 1;

        function updateSelectedInvoices() {
            const selectedCheckboxes = body.querySelectorAll(
                ".ci-checkbox:checked"
            );

            const names = Array.from(selectedCheckboxes).map(checkbox =>
                checkbox.closest("tr").cells[3]?.textContent.trim()
            );

            body.querySelectorAll("tr[data-id]").forEach(row => {
                const checkbox = row.querySelector(".ci-checkbox");
                row.classList.toggle("selected", checkbox?.checked);
            });

            selectedInvoiceId = selectedCheckboxes.length === 1
                ? selectedCheckboxes[0].value
                : null;

            document.getElementById("ciSelected").textContent =
                names.length ? names.join(", ") : "None";
        }

        function renderRows() {
            const pageSize = Number(pageSizeInput.value);

            const totalPages = Math.max(
                1,
                Math.ceil(filteredRows.length / pageSize)
            );

            currentPage = Math.min(currentPage, totalPages);

            rows.forEach(row => row.hidden = true);

            const start = (currentPage - 1) * pageSize;

            const visibleRows = filteredRows.slice(
                start,
                start + pageSize
            );

            visibleRows.forEach(row => {
                row.hidden = false;
            });

            document.getElementById("ciDisplayed").textContent =
                filteredRows.length;

            document.getElementById("ciRecordCount").textContent =
                `${filteredRows.length} ${filteredRows.length === 1 ? "Record" : "Records"}`;

            document.getElementById("ciShowing").textContent =
                filteredRows.length
                    ? `Showing ${start + 1} to ${start + visibleRows.length} of ${filteredRows.length} invoices`
                    : "Showing 0 invoices";

            document.getElementById("ciPageInfo").textContent =
                filteredRows.length
                    ? `${currentPage} / ${totalPages}`
                    : "0 / 0";

            document.getElementById("ciFilterEmpty").hidden =
                filteredRows.length !== 0;

            document.getElementById("ciPrevious").disabled =
                currentPage <= 1;

            document.getElementById("ciNext").disabled =
                currentPage >= totalPages;
        }

        function filterRows() {
            const query = searchInput.value.trim().toLowerCase();

            filteredRows = rows.filter(row =>
                row.innerText.toLowerCase().includes(query)
            );

            updateSelectedInvoices();

            currentPage = 1;

            renderRows();
        }

        rows.forEach(row => {
            row.addEventListener("click", event => {
                if (event.target.closest(
                    ".ci-row-edit, .ci-row-delete, .ci-checkbox"
                )) {
                    return;
                }

                const checkbox = row.querySelector(".ci-checkbox");

                if (checkbox) {
                    checkbox.checked = !checkbox.checked;
                    updateSelectedInvoices();
                }
            });

            const checkbox = row.querySelector(".ci-checkbox");

            checkbox?.addEventListener("change", () => {
                updateSelectedInvoices();
            });
        });

        // Edit selected invoice
        function editInvoice(id) {
            if (!id) {
                alert("Please select an invoice.");
                return;
            }

            window.location.href =
                "/Master/InvoiceProcessing?id=" +
                encodeURIComponent(id);
        }

        // Delete selected invoice
        async function deleteInvoice(id) {
            if (!id) {
                alert("Please select an invoice.");
                return;
            }

            if (!confirm("Are you sure you want to delete this invoice?")) {
                return;
            }

            try {
                const token = document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value || "";

                const response = await fetch(
                    "/Master/InvoiceProcessing/Delete/" +
                    encodeURIComponent(id),
                    {
                        method: "POST",
                        headers: {
                            "RequestVerificationToken": token
                        }
                    }
                );

                if (!response.ok) {
                    throw new Error("Delete request failed.");
                }

                window.location.reload();
            }
            catch (error) {
                alert(
                    "Unable to delete the invoice. Please check the Delete action in InvoiceProcessingController."
                );

                console.error(error);
            }
        }

        // Toolbar Edit
        document.getElementById("ciEdit").addEventListener("click", () => {
            editInvoice(selectedInvoiceId);
        });

        // Toolbar Delete
        document.getElementById("ciDelete").addEventListener("click", () => {
            deleteInvoice(selectedInvoiceId);
        });

        // Individual row Edit and Delete
        body.addEventListener("click", event => {
            const editButton = event.target.closest(".ci-row-edit");
            const deleteButton = event.target.closest(".ci-row-delete");

            if (!editButton && !deleteButton) {
                return;
            }

            const row = event.target.closest("tr[data-id]");

            if (!row) {
                return;
            }

            if (editButton) {
                editInvoice(row.dataset.id);
            }

            if (deleteButton) {
                deleteInvoice(row.dataset.id);
            }
        });

        // Search
        searchInput.addEventListener("input", filterRows);

        // Page size
        pageSizeInput.addEventListener("change", () => {
            currentPage = 1;
            renderRows();
        });

        // Previous page
        document.getElementById("ciPrevious").addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage--;
                renderRows();
            }
        });

        // Next page
        document.getElementById("ciNext").addEventListener("click", () => {
            const totalPages = Math.max(
                1,
                Math.ceil(filteredRows.length / Number(pageSizeInput.value))
            );

            if (currentPage < totalPages) {
                currentPage++;
                renderRows();
            }
        });

        // Print
        document.getElementById("ciPrint").addEventListener("click", () => {
            window.print();
        });

        // Close
        document.getElementById("ciClose").addEventListener("click", () => {
            window.location.href = "/Home/Index";
        });

        // Other toolbar actions
        document.getElementById("ciSave").addEventListener("click", () => {
            alert("Save is available from the Invoice Processing form.");
        });

        document.getElementById("ciClone").addEventListener("click", () => {
            if (!selectedInvoiceId) {
                alert("Please select an invoice.");
                return;
            }

            window.location.href =
                "/Master/InvoiceProcessing?id=" +
                encodeURIComponent(selectedInvoiceId);
        });

        document.getElementById("ciUnPost").addEventListener("click", () => {
            alert("UnPost action is not connected yet.");
        });

        document.getElementById("ciApprove").addEventListener("click", () => {
            alert("Approve action is not connected yet.");
        });

        document.getElementById("ciReject").addEventListener("click", () => {
            alert("Reject action is not connected yet.");
        });

        document.getElementById("ciAuthTracker").addEventListener("click", () => {
            alert("Auth Tracker action is not connected yet.");
        });

        renderRows();
    })();
</script>