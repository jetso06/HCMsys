@using System.Text.Json
@using System.Text.Json.Nodes
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Tax Invoice";
    var config = ViewData["Config"] as JsonObject ?? new();
    var invoice = ViewData["Invoice"] as JsonObject ?? new();
    var lookups = ViewData["Lookups"] as JsonObject ?? new();
}
<div class="container-fluid ti-page">
    <div class="card shadow mb-3"><div class="card-header ti-toolbar"><h6 class="ti-title"><i class="fas fa-file-invoice mr-2"></i>TAX INVOICE</h6><div id="tiButtons" class="ti-buttons"></div></div></div>
    <form id="tiForm">@Html.AntiForgeryToken()
        <div class="card shadow mb-3"><div class="card-header ti-section-title"><i class="fas fa-file-alt mr-2"></i>INVOICE DETAILS</div><div class="card-body"><div class="row" id="tiHeaderFields"></div><div class="ti-message" id="tiMessage"></div></div></div>
        <div class="card shadow mb-3"><div class="card-header ti-section-title ti-grid-heading"><span><i class="fas fa-table mr-2"></i>ATTENDANCE / BILLING DETAILS</span><div class="ti-grid-actions"><button type="button" id="tiAddRow" class="btn btn-success btn-sm"><i class="fas fa-plus mr-1"></i>Add Row</button><button type="button" id="tiInsertRow" class="btn btn-info btn-sm"><i class="fas fa-level-up-alt mr-1"></i>Insert Row</button><button type="button" id="tiDeleteRow" class="btn btn-danger btn-sm"><i class="fas fa-trash mr-1"></i>Delete Row</button><button type="button" id="tiLoadTimesheet" class="btn btn-primary btn-sm"><i class="fas fa-download mr-1"></i>Load TimeSheet</button></div></div><div class="card-body ti-grid-body"><div class="table-responsive"><table class="table table-bordered table-hover ti-table"><thead id="tiGridHead"></thead><tbody id="tiGridBody"></tbody></table></div><div class="ti-grid-footer" id="tiGridCount">0 records</div></div></div>
    </form>
</div>
<div class="modal fade" id="tiSaveModal" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Confirm Save</h5><button type="button" class="close" data-dismiss="modal"><span>&times;</span></button></div><div class="modal-body">Are you sure you want to save this Tax Invoice?</div><div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary btn-sm" id="tiConfirmSave">Yes, Save</button></div></div></div></div>
<style>
html{font-size:14px}.ti-page{width:100%;max-width:none;padding:18px 0 25px;color:#5a5c69;font-size:13px}.ti-page>.card{border:1px solid #e1e6ed;border-radius:6px;box-shadow:0 4px 14px rgba(58,59,69,.14);overflow:hidden}.ti-toolbar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;padding:14px 18px;background:#eef0f3}.ti-title{margin:0;color:#5a5c69;font-size:.85rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.ti-buttons{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end}.ti-buttons .btn,.ti-grid-actions .btn{font-size:.75rem;font-weight:700;box-shadow:0 2px 5px rgba(0,0,0,.08)}.ti-section-title{padding:12px 16px;background:#eef0f3;color:#4e73df;border-bottom:1px solid #e1e6ed;font-size:.82rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}.ti-page .card-body{padding:20px 16px;background:#fff}.ti-field{margin-bottom:16px}.ti-field label{display:block;margin-bottom:5px;color:#596579;font-size:.76rem;font-weight:700;text-transform:uppercase;letter-spacing:.055em}.ti-field .form-control{width:100%;min-height:36px;padding:6px 10px;border:1px solid #d2d0cb;border-radius:5px;background:#fff;color:#4d596b;font-size:.83rem;box-shadow:none}.ti-field textarea.form-control{height:auto;min-height:70px}.ti-field .form-control[readonly]{background:#e9ecef}.ti-grid-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.ti-grid-actions{display:flex;flex-wrap:wrap;gap:6px}.ti-grid-body{padding:14px!important}.ti-table{width:100%;margin:0;color:#5a5c69;font-size:.76rem;white-space:nowrap}.ti-table thead th{padding:9px 8px;background:#4e73df;color:#fff;border-color:#3d5cbe;font-size:.7rem;font-weight:800;text-align:center;text-transform:uppercase;vertical-align:middle}.ti-table tbody td{padding:5px;border-color:#e3e6f0;vertical-align:middle}.ti-grid-input{min-width:100px;width:100%;height:30px;padding:4px 7px;border:1px solid #d1d3e2;border-radius:4px;font-size:.76rem;color:#5a5c69}.ti-grid-input[readonly]{background:#f1f3f6}.ti-grid-footer{text-align:right;padding-top:10px;color:#858796;font-size:.75rem}.ti-message{font-size:.8rem;margin-top:6px}.ti-buttons .btn:disabled{opacity:.45}@@media(max-width:768px){.ti-toolbar{align-items:flex-start}.ti-buttons{width:100%;justify-content:flex-start}.ti-grid-heading{align-items:flex-start}}@@media print{.ti-buttons,.ti-grid-actions{display:none!important}}
</style>
@section Scripts {
<script>
const tiConfig=@Html.Raw(config.ToJsonString());
const tiInvoice=@Html.Raw(invoice.ToJsonString());
const tiLookups=@Html.Raw(lookups.ToJsonString());
let tiRows=Array.isArray(tiInvoice.attendanceRows)?tiInvoice.attendanceRows:[];
let tiCurrentId=tiInvoice.id||null;
const tiEl=id=>document.getElementById(id);
const tiToken=()=>document.querySelector('#tiForm input[name="__RequestVerificationToken"]')?.value||'';
const tiText=v=>v==null?'':String(v);
function tiMsg(s,error=false){tiEl('tiMessage').textContent=s;tiEl('tiMessage').style.color=error?'#e74a3b':'#1cc88a';}
function tiOptions(source){let a=tiLookups[source]||[];return a.map(x=>typeof x==='object'?{value:x.value??x.id??'',text:x.text??x.name??x.value??x.id??''}:{value:x,text:x});}
function tiRenderHeader(){const host=tiEl('tiHeaderFields');host.innerHTML='';(tiConfig.headerFields||[]).forEach(f=>{let col=document.createElement('div');col.className=(f.id==='comments'?'col-xl-6 col-lg-6 col-md-6 col-12':'col-xl-3 col-lg-4 col-md-6 col-12')+' ti-field';let label=document.createElement('label');label.htmlFor=f.id;label.textContent=f.label+(f.required?' *':'');col.append(label);let c;if(f.type==='textarea'){c=document.createElement('textarea');c.rows=2;}else if(f.type==='select'){c=document.createElement('select');c.add(new Option('-- Select '+f.label+' --',''));tiOptions(f.source).forEach(o=>c.add(new Option(o.text,o.value)));}else{c=document.createElement('input');c.type=f.type||'text';if(f.step)c.step=f.step;if(f.maxLength)c.maxLength=f.maxLength;}c.id=f.id;c.className='form-control';c.required=!!f.required;c.readOnly=!!f.readonly;if(f.defaultValue==='currentDateTime')c.value=new Date().toISOString().slice(0,16);else if(f.defaultValue)c.value=f.defaultValue;if(tiInvoice[f.id]!=null)c.value=tiInvoice[f.id];col.append(c);host.append(col);});
 const client=tiEl('clientId'),agreement=tiEl('mainFrameAgreementId');if(client&&agreement){client.addEventListener('change',async()=>{agreement.innerHTML='<option value="">-- Select Main Frame Agreement --</option>';if(!client.value)return;try{let r=await fetch('/Master/TaxInvoice/GetAgreements?clientId='+encodeURIComponent(client.value));let a=await r.json();a.forEach(x=>agreement.add(new Option(x.text||x.name||x.contractNo,x.value||x.id)));}catch(e){tiMsg('Unable to load agreements.',true);}});if(tiInvoice.clientId)client.dispatchEvent(new Event('change'));}}
function tiRenderButtons(){(tiConfig.buttons?.form||[]).forEach(b=>{let x=document.createElement('button');x.type='button';x.id='ti'+b.id.replace(/^btn/,'');x.className='btn btn-'+(b.style||'secondary')+' btn-sm';x.innerHTML='<i class="fas '+b.icon+' mr-1"></i>'+b.text;x.addEventListener('click',()=>tiButton(b.id));tiEl('tiButtons').append(x);});}
function tiButton(id){switch(id){case'btnHome':location.href='/Master/TaxInvoiceIndex';break;case'btnNew':tiNew();break;case'btnSave':if(tiEl('tiForm').reportValidity())$('#tiSaveModal').modal('show');break;case'btnPrint':window.print();break;case'btnClose':history.back();break;case'btnDelete':if(tiCurrentId&&confirm('Delete this Tax Invoice?'))tiDelete();else if(!tiCurrentId)alert('Save the invoice before deleting.');break;case'btnEdit':alert('You are already on the edit form.');break;case'btnClone':tiClone();break;default:alert(id.replace('btn','')+' is not connected yet.');}}
const tiCols=tiConfig.grid.columns;
function tiCell(row,col,i){let td=document.createElement('td');if(col.field==='__select'){let cb=document.createElement('input');cb.type='checkbox';cb.className='ti-row-check';cb.dataset.index=i;td.append(cb);return td;}let c;if(col.type==='select'){c=document.createElement('select');c.add(new Option('-- Select --',''));tiOptions(col.source).forEach(o=>c.add(new Option(o.text,o.value)));}else{c=document.createElement('input');c.type=col.type==='number'?'number':col.type==='date'?'date':'text';if(col.step)c.step=col.step;}c.className='ti-grid-input';c.dataset.index=i;c.dataset.field=col.field;c.value=tiText(row[col.field]);c.readOnly=!!col.readOnly;c.addEventListener('input',()=>{row[col.field]=c.value;if(['qty','rate','serviceFeeValue','taxPercent'].includes(col.field)){tiCalculate(row);tiRenderGrid();}});c.addEventListener('change',()=>{row[col.field]=c.value;if(['qty','rate','serviceFeeValue','taxPercent'].includes(col.field)){tiCalculate(row);tiRenderGrid();}});td.append(c);return td;}
function tiCalculate(r){let amount=(Number(r.qty)||0)*(Number(r.rate)||0);let service=Number(r.serviceFeeValue)||0;let taxable=amount+service;let tax=taxable*(Number(r.taxPercent)||0)/100;r.amount=amount.toFixed(3);r.taxAmount=tax.toFixed(3);r.netAmount=(taxable+tax).toFixed(3);}
function tiRenderGrid(){let h=tiEl('tiGridHead'),b=tiEl('tiGridBody');h.innerHTML='';b.innerHTML='';let tr=document.createElement('tr');let th=document.createElement('th');let all=document.createElement('input');all.type='checkbox';all.id='tiSelectAll';all.addEventListener('change',()=>document.querySelectorAll('.ti-row-check').forEach(c=>c.checked=all.checked));th.append(all);tr.append(th);tiCols.forEach(c=>{let x=document.createElement('th');x.textContent=c.header;tr.append(x);});h.append(tr);if(!tiRows.length){let r=document.createElement('tr'),d=document.createElement('td');d.colSpan=tiCols.length+1;d.className='text-center text-muted';d.textContent='No billing rows. Load a Time Sheet or click Add Row.';r.append(d);b.append(r);}tiRows.forEach((row,i)=>{let r=document.createElement('tr'),d=document.createElement('td'),cb=document.createElement('input');cb.type='checkbox';cb.className='ti-row-check';cb.dataset.index=i;d.append(cb);r.append(d);tiCols.forEach(c=>r.append(tiCell(row,c,i)));b.append(r);});tiEl('tiGridCount').textContent=tiRows.length+' records';}
function tiBlank(){let r={};tiCols.forEach(c=>r[c.field]=c.type==='number'?'0':'');r.payMonth=tiEl('payMonth')?.value||'';r.qty='0';r.rate='0';r.taxPercent='0';tiCalculate(r);return r;}
function tiAdd(){tiRows.push(tiBlank());tiRenderGrid();}
function tiInsert(){let selected=[...document.querySelectorAll('.ti-row-check:checked')].map(x=>Number(x.dataset.index)).sort((a,b)=>a-b);let at=selected.length?selected[0]:0;tiRows.splice(at,0,tiBlank());tiRenderGrid();}
function tiDeleteRows(){let selected=new Set([...document.querySelectorAll('.ti-row-check:checked')].map(x=>Number(x.dataset.index)));if(!selected.size){alert('Select at least one row to delete.');return;}tiRows=tiRows.filter((_,i)=>!selected.has(i));tiRenderGrid();}
async function tiLoadTimesheet(){let id=tiEl('invBatchNo')?.value;if(!id){alert('Select a Time Sheet batch in InvBatchno first.');return;}try{let r=await fetch('/Master/TaxInvoice/LoadTimesheet/'+encodeURIComponent(id));let data=await r.json();if(!r.ok)throw Error(data.message||'Unable to load Time Sheet.');tiRows=(data.attendanceRows||[]).map(x=>({...tiBlank(),...x}));tiRenderGrid();tiMsg('Time Sheet loaded. Review Billing Heads, rates, fees and tax before saving.');}catch(e){tiMsg(e.message,true);}}
function tiHeader(){let o={};(tiConfig.headerFields||[]).forEach(f=>{let el=tiEl(f.id);o[f.id]=el?.value??'';});return o;}
async function tiSave(){let payload={...tiHeader(),id:tiCurrentId||0,attendanceRows:tiRows};try{let r=await fetch('/Master/TaxInvoice/Save',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':tiToken()},body:JSON.stringify(payload)});let d=await r.json();if(!r.ok)throw Error(d.message||'Unable to save.');tiCurrentId=d.id;$('#tiSaveModal').modal('hide');tiMsg('Tax Invoice saved successfully.');alert('Tax Invoice saved successfully.');}catch(e){$('#tiSaveModal').modal('hide');alert(e.message);}}
async function tiDelete(){try{let r=await fetch('/Master/TaxInvoice/Delete/'+tiCurrentId,{method:'POST',headers:{'RequestVerificationToken':tiToken()}});let d=await r.json();if(!r.ok)throw Error(d.message||'Delete failed.');location.href='/Master/TaxInvoiceIndex';}catch(e){alert(e.message);}}
function tiNew(){tiCurrentId=null;tiEl('tiForm').reset();tiRows=[];tiRenderHeader();tiRenderGrid();tiMsg('New Tax Invoice.');}
function tiClone(){tiCurrentId=null;let no=tiEl('invoiceNo');if(no)no.value='';tiMsg('Cloned values. Change Invoice No and save as a new record.');}
document.addEventListener('DOMContentLoaded',()=>{tiRenderButtons();tiRenderHeader();tiRenderGrid();tiEl('tiAddRow').addEventListener('click',tiAdd);tiEl('tiInsertRow').addEventListener('click',tiInsert);tiEl('tiDeleteRow').addEventListener('click',tiDeleteRows);tiEl('tiLoadTimesheet').addEventListener('click',tiLoadTimesheet);tiEl('tiConfirmSave').addEventListener('click',tiSave);});
</script>
}
