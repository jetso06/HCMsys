@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .approval-page {
        width: 100%;
        padding: 18px 0 25px;
        box-sizing: border-box;
    }

    .approval-page > .card {
        width: 100%;
        margin-bottom: 18px;
        border: 1px solid #e3e6f0;
        border-radius: .35rem;
        box-shadow: 0 4px 14px rgba(58, 59, 69, .14);
    }

    /* =========================
       HEADER
       ========================= */

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }

    .page-title-text {
        margin: 0;
        font-size: .85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: .08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .page-title-text i {
        color: #4e73df;
    }

    .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-group-actions .btn {
        font-size: .75rem;
    }

    /* =========================
       CONTENT
       ========================= */

    .approval-content {
        padding: 16px;
    }

    .section-title {
        margin: -16px -16px 16px;
        padding: 14px 18px;
        background: #eef0f3;
        border-bottom: 1px solid #e1e6ed;
        font-size: .8rem;
        font-weight: 800;
        color: #4e73df;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    /* =========================
       FORM
       ========================= */

    .approval-form-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px 18px;
        margin-bottom: 22px;
    }

    .form-label {
        display: block;
        font-size: .75rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 4px;
    }

    .mandatory {
        color: #e74a3b;
        margin-left: 3px;
    }

    .form-control,
    .form-select {
        width: 100%;
        font-size: .82rem;
        border: 1px solid #d1d3e2;
        border-radius: .35rem;
        padding: 7px 9px;
        color: #6e707e;
        background: #fff;
        outline: none;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 .2rem rgba(78, 115, 223, .2);
    }

    .is-invalid {
        border-color: #e74a3b !important;
    }

    /* =========================
       GRID
       ========================= */

    .grid-heading {
        font-size: .8rem;
        font-weight: 800;
        color: #4e73df;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 8px;
    }

    .grid-toolbar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 8px;
    }

    .grid-toolbar .btn {
        font-size: .72rem;
        font-weight: 700;
    }

    .approval-grid-wrapper {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #e3e6f0;
        border-radius: .35rem;
    }

    .approval-grid {
        width: 100%;
        border-collapse: collapse;
        min-width: 700px;
    }

    .approval-grid th {
        background: #4e73df;
        color: #fff;
        font-size: .70rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: 8px;
        border: 1px solid #3d5cbe;
        white-space: nowrap;
    }

    .approval-grid td {
        padding: 6px;
        border: 1px solid #e3e6f0;
        background: #fff;
    }

    .approval-grid td .form-control {
        padding: 5px 7px;
        font-size: .76rem;
    }

    .grid-row-delete {
        border: none;
        background: transparent;
        color: #e74a3b;
        cursor: pointer;
        font-size: .8rem;
    }

    .grid-row-delete:hover {
        color: #b02a37;
    }

    /* =========================
       STATUS
       ========================= */

    .status-message {
        display: none;
        margin-top: 10px;
        padding: 8px 10px;
        border-radius: .35rem;
        font-size: .75rem;
    }

    .status-message.show {
        display: block;
    }

    .status-message.success {
        background: #eaf7ee;
        color: #1e7e34;
    }

    .status-message.error {
        background: #fdeeee;
        color: #b02a37;
    }

    /* =========================
       ACTION BUTTONS
       ========================= */

    .approval-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .approval-actions .btn {
        font-size: .75rem;
        font-weight: 700;
    }

    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 768px) {

        .approval-form-grid {
            grid-template-columns: 1fr;
        }

        .approval-page {
            padding: 12px 0;
        }

        .approval-content {
            padding: 12px;
        }

        .section-title {
            margin: -12px -12px 12px;
        }

    }

</style>


<div class="approval-page">

    <!-- =========================
         PAGE HEADER
         ========================= -->

    <div class="card shadow mb-3">

        <div class="card-header py-3">

            <div class="page-title-bar">

                <div class="page-title-text">

                    <i class="fas fa-check-double fa-sm"></i>

                    Approval

                </div>


                <div class="btn-group-actions">

                    <!-- APPROVAL ACTIONS -->

                    <button type="button"
                            class="btn btn-danger btn-sm shadow-sm"
                            id="btnReject">

                        <i class="fas fa-times fa-sm text-white-50 mr-1"></i>

                        Reject

                    </button>


                    <button type="button"
                            class="btn btn-info btn-sm shadow-sm"
                            id="btnAuthTracker">

                        <i class="fas fa-history fa-sm text-white-50 mr-1"></i>

                        Auth Tracker

                    </button>


                    <button type="button"
                            class="btn btn-success btn-sm shadow-sm"
                            id="btnApprove">

                        <i class="fas fa-check fa-sm text-white-50 mr-1"></i>

                        Approve

                    </button>


                    <!-- MASTER BUTTONS -->

                    <button type="button"
                            class="btn btn-primary btn-sm shadow-sm"
                            id="btnHome">

                        <i class="fas fa-home fa-sm text-white-50 mr-1"></i>

                        Home

                    </button>


                    <button type="button"
                            class="btn btn-success btn-sm shadow-sm"
                            id="btnNew">

                        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i>

                        New

                    </button>


                    <button type="button"
                            class="btn btn-primary btn-sm shadow-sm"
                            id="btnSave">

                        <i class="fas fa-save fa-sm text-white-50 mr-1"></i>

                        Save

                    </button>


                    <button type="button"
                            class="btn btn-info btn-sm shadow-sm"
                            id="btnClone">

                        <i class="fas fa-copy fa-sm text-white-50 mr-1"></i>

                        Clone

                    </button>


                    <button type="button"
                            class="btn btn-danger btn-sm shadow-sm"
                            id="btnDelete">

                        <i class="fas fa-trash fa-sm text-white-50 mr-1"></i>

                        Delete

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         APPROVAL CONTENT
         ========================= -->

    <div class="card shadow">

        <div class="approval-content">

            <div class="section-title">

                <i class="fas fa-file-signature mr-1"></i>

                Approval

            </div>


            <!-- HEADER -->

            <div class="approval-form-grid">

                <div>

                    <label class="form-label"
                           for="docNo">

                        Doc No
                        <span class="mandatory">*</span>

                    </label>

                    <select class="form-select"
                            id="docNo">

                        <option value="">
                            Select...
                        </option>

                    </select>

                </div>


                <div>

                    <label class="form-label"
                           for="docDate">

                        Doc Date
                        <span class="mandatory">*</span>

                    </label>

                    <input type="date"
                           class="form-control"
                           id="docDate" />

                </div>
                <div>

                    <label class="form-label"
                        for="postDate">

                        Post Date
                        <span class="mandatory">*</span>

                    </label>

                    <input type="date"
                            class="form-control"
                            id="postDate" />

                </div>

            </div>


            <!-- GRID -->

            <div class="grid-heading">

                Grid

            </div>


            <div class="grid-toolbar">

                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="btnAddRow">

                    <i class="fas fa-plus mr-1"></i>

                    Add Row

                </button>

            </div>


            <div class="approval-grid-wrapper">

                <table class="approval-grid">

                    <thead>

                        <tr>

                            <th>
                                Item
                            </th>

                            <th>
                                Qty
                            </th>

                            <th>
                                Rate
                            </th>

                            <th>
                                Gross
                            </th>

                            <th style="width:55px;">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody id="approvalGridBody">

                    </tbody>

                </table>

            </div>


            <div id="statusMessage"
                 class="status-message">
            </div>


        </div>

    </div>

</div>


<script>

    let approvalConfig = null;
    let approvalRows = [{}, {}];


    $(document).ready(function () {

        loadApprovalConfig();


        /* =========================
           HOME
           ========================= */

        $('#btnHome').on('click', function () {

            window.location.href =
                '@Url.Action("ProjectIndex", "Master")';

        });


        /* =========================
           NEW
           ========================= */

        $('#btnNew').on('click', function () {

            clearApproval();

            showStatus(
                'New approval form is ready.',
                'success'
            );

        });


        /* =========================
           SAVE
           ========================= */

        $('#btnSave').on('click', function () {

            if (!validateApproval()) {
                return;
            }

            console.log(
                'Approval Data:',
                collectApprovalData()
            );

            showStatus(
                'Approval saved successfully.',
                'success'
            );

        });


        /* =========================
           CLONE
           ========================= */

        $('#btnClone').on('click', function () {

            console.log(
                'Approval cloned:',
                collectApprovalData()
            );

            showStatus(
                'Approval data prepared for cloning.',
                'success'
            );

        });


        /* =========================
           DELETE
           ========================= */

        $('#btnDelete').on('click', function () {

            if (
                confirm(
                    'Are you sure you want to delete this approval?'
                )
            ) {

                clearApproval();

                showStatus(
                    'Approval deleted successfully.',
                    'success'
                );

            }

        });


        /* =========================
           APPROVE
           ========================= */

        $('#btnApprove').on('click', function () {

            if (!validateApproval()) {
                return;
            }

            showStatus(
                'Approval approved successfully.',
                'success'
            );

        });


        /* =========================
           REJECT
           ========================= */

        $('#btnReject').on('click', function () {

            if (!validateApproval()) {
                return;
            }

            showStatus(
                'Approval rejected.',
                'error'
            );

        });


        /* =========================
           AUTH TRACKER
           ========================= */

        $('#btnAuthTracker').on('click', function () {

            showStatus(
                'Auth Tracker opened.',
                'success'
            );

        });


        /* =========================
           ADD ROW
           ========================= */

        $('#btnAddRow').on('click', function () {

            collectGridRows();

            approvalRows.push({});

            renderGrid();

        });

    });


    /* =========================
       LOAD JSON
       ========================= */

    function loadApprovalConfig() {

        fetch(
            '/data/Approvals/approval.json',
            {
                cache: 'no-store'
            }
        )

        .then(function (response) {

            if (!response.ok) {

                throw new Error(
                    'Unable to load approval.json'
                );

            }

            return response.json();

        })

        .then(function (data) {

            approvalConfig = data;

            renderDocumentDropdown();

            renderGrid();

        })

        .catch(function (error) {

            console.error(
                'Approval JSON error:',
                error
            );

            showStatus(
                'Unable to load Approval configuration.',
                'error'
            );

        });

    }


    /* =========================
       DOCUMENT DROPDOWN
       ========================= */

    function renderDocumentDropdown() {

        const dropdown =
            $('#docNo');

        dropdown.empty();

        dropdown.append(
            '<option value="">Select...</option>'
        );

        /*
         * Placeholder values for now.
         * These can later come from
         * the Document master JSON.
         */

        dropdown.append(
            '<option value="DOC-0001">DOC-0001</option>'
        );

        dropdown.append(
            '<option value="DOC-0002">DOC-0002</option>'
        );

        dropdown.append(
            '<option value="DOC-0003">DOC-0003</option>'
        );

    }


    /* =========================
       RENDER GRID
       ========================= */

    function renderGrid() {

        const tbody =
            $('#approvalGridBody');

        tbody.empty();


        approvalRows.forEach(
            function (row, index) {

                tbody.append(
                    buildGridRow(
                        row,
                        index
                    )
                );

            }
        );


        bindGridEvents();

    }


    /* =========================
       BUILD GRID ROW
       ========================= */

    function buildGridRow(
        row,
        index
    ) {

        return `
            <tr data-row-index="${index}">

                <td>

                    <input type="text"
                           class="form-control grid-field"
                           data-field="item"
                           value="${escapeHtml(row.item || '')}" />

                </td>

                <td>

                    <input type="number"
                           class="form-control grid-field"
                           data-field="qty"
                           value="${escapeHtml(row.qty || '')}" />

                </td>

                <td>

                    <input type="number"
                           class="form-control grid-field"
                           data-field="rate"
                           value="${escapeHtml(row.rate || '')}" />

                </td>

                <td>

                    <input type="number"
                           class="form-control grid-field"
                           data-field="gross"
                           value="${escapeHtml(row.gross || '')}" />

                </td>

                <td class="text-center">

                    <button type="button"
                            class="grid-row-delete"
                            title="Delete row">

                        <i class="fas fa-trash"></i>

                    </button>

                </td>

            </tr>
        `;

    }


    /* =========================
       GRID EVENTS
       ========================= */

    function bindGridEvents() {

        $('.grid-row-delete')
            .off('click')
            .on('click', function () {

                collectGridRows();

                const rowIndex =
                    Number(
                        $(this)
                            .closest('tr')
                            .attr('data-row-index')
                    );

                approvalRows.splice(
                    rowIndex,
                    1
                );


                if (approvalRows.length === 0) {

                    approvalRows.push({});

                }


                renderGrid();

            });

    }


    /* =========================
       COLLECT GRID
       ========================= */

    function collectGridRows() {

        const rows = [];


        $('#approvalGridBody tr')
            .each(function () {

                const row = {};


                $(this)
                    .find('.grid-field')
                    .each(function () {

                        const field =
                            $(this)
                                .attr('data-field');

                        row[field] =
                            $(this).val();

                    });


                rows.push(row);

            });


        approvalRows = rows;

    }


    /* =========================
       COLLECT APPROVAL
       ========================= */

    function collectApprovalData() {

        collectGridRows();


        return {

            docNo: $('#docNo').val(),

            docDate: $('#docDate').val(),

            items: approvalRows

        };

    }


    /* =========================
       VALIDATION
       ========================= */

    function validateApproval() {

        let valid = true;


        $('#docNo')
            .removeClass('is-invalid');

        $('#docDate')
            .removeClass('is-invalid');


        if (!$('#docNo').val()) {

            $('#docNo')
                .addClass('is-invalid');

            valid = false;

        }


        if (!$('#docDate').val()) {

            $('#docDate')
                .addClass('is-invalid');

            valid = false;

        }


        if (!valid) {

            showStatus(
                'Please fill all mandatory fields.',
                'error'
            );

        }


        return valid;

    }


    /* =========================
       CLEAR
       ========================= */

    function clearApproval() {

        $('#docNo')
            .val('')
            .removeClass('is-invalid');

        $('#docDate')
            .val('')
            .removeClass('is-invalid');


        approvalRows = [{}];

        renderGrid();

    }


    /* =========================
       STATUS
       ========================= */

    function showStatus(
        message,
        type
    ) {

        const box =
            $('#statusMessage');


        box
            .removeClass(
                'success error show'
            )
            .addClass(
                type + ' show'
            )
            .text(message);


        setTimeout(
            function () {

                box.removeClass('show');

            },
            3000
        );

    }


    /* =========================
       ESCAPE HTML
       ========================= */

    function escapeHtml(value) {

        return String(value ?? '')
            .replace(
                /&/g,
                '&amp;'
            )
            .replace(
                /</g,
                '&lt;'
            )
            .replace(
                />/g,
                '&gt;'
            )
            .replace(
                /"/g,
                '&quot;'
            )
            .replace(
                /'/g,
                '&#039;'
            );

    }

</script>