
@using System.Text.Json.Nodes
@model List<JsonNode>

@{
    ViewData["Title"] = "Timesheet List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var timesheets = Model ?? new List<JsonNode>();
    var total = timesheets.Count;
    var listConfig = ViewData["TimesheetListConfig"] as JsonObject
                 ?? new JsonObject();

var columns = listConfig["columns"] as JsonArray
              ?? new JsonArray();

var listHeading = listConfig["heading"]?.ToString()
                  ?? "Timesheet Records";

var searchPlaceholder = listConfig["searchPlaceholder"]?.ToString()
                        ?? "Search timesheets...";
}

<div class="container-fluid candidate-index">

    <!-- MASTER TOOLBAR -->
    <div class="card ci-card ci-toolbar-card">
        <div class="card-header ci-toolbar">
            <h6 class="ci-title">
                <i class="fas fa-file-invoice"></i>
                Timesheet List
                <span class="ci-module-badge">TIMESHEET</span>
            </h6>

            <div class="ci-buttons">
                <a href="/Master/Timesheet"
                   class="btn btn-success btn-sm shadow-sm">
                    <i class="fas fa-plus"></i> New
                </a>

                <button type="button" id="ciEdit"
                        class="btn btn-primary btn-sm shadow-sm">
                    <i class="fas fa-edit"></i> Edit
                </button>

                <button type="button" id="ciSave"
                        class="btn btn-primary btn-sm shadow-sm" disabled>
                    <i class="fas fa-save"></i> Save
                </button>

                <button type="button" id="ciClone"
                        class="btn btn-info btn-sm shadow-sm" disabled>
                    <i class="fas fa-copy"></i> Clone
                </button>

                <button type="button" id="ciUnPost"
                        class="btn btn-secondary btn-sm shadow-sm" disabled>
                    <i class="fas fa-undo"></i> UnPost
                </button>

                <button type="button" id="ciPrint"
                        class="btn btn-light btn-sm shadow-sm">
                    <i class="fas fa-print"></i> Print
                </button>

                <button type="button" id="ciDelete"
                        class="btn btn-danger btn-sm shadow-sm">
                    <i class="fas fa-trash"></i> Delete
                </button>

                <button type="button" id="ciApprove"
                        class="btn btn-success btn-sm shadow-sm" disabled>
                    <i class="fas fa-check"></i> Approve
                </button>

                <button type="button" id="ciReject"
                        class="btn btn-danger btn-sm shadow-sm" disabled>
                    <i class="fas fa-times"></i> Reject
                </button>

                <button type="button" id="ciAuthTracker"
                        class="btn btn-info btn-sm shadow-sm" disabled>
                    <i class="fas fa-history"></i> Auth Tracker
                </button>

                <button type="button" id="ciClose"
                        class="btn btn-light btn-sm shadow-sm">
                    <i class="fas fa-times-circle"></i> Close
                </button>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- SUMMARY CARDS -->
    <div class="row ci-summary">
        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-primary">
                <div class="card-body">
                    <div class="ci-summary-label">Total Timesheets</div>
                    <div class="ci-summary-value" id="ciTotal">@total</div>
                    <i class="fas fa-file-invoice ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-info">
                <div class="card-body">
                    <div class="ci-summary-label">Displayed Records</div>
                    <div class="ci-summary-value" id="ciDisplayed">@total</div>
                    <i class="fas fa-list ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-success">
                <div class="card-body">
                    <div class="ci-summary-label">Selected Timesheet</div>
                    <div class="ci-summary-value" id="ciSelected">None</div>
                    <i class="fas fa-file-alt ci-summary-icon"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card ci-card ci-summary-card ci-border-warning">
                <div class="card-body">
                    <div class="ci-summary-label">Module</div>
                    <div class="ci-summary-module">Timesheet Master</div>
                    <i class="fas fa-sitemap ci-summary-icon"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- RECORDS CARD -->
    <div class="card ci-card ci-records-card">
        <div class="card-header ci-records-header">
            <h6>
                <i class="fas fa-table"></i>
                @listHeading
            </h6>
            <span class="badge badge-primary" id="ciRecordCount">
                @total Records
            </span>
        </div>

        <div class="card-body">
            <div class="ci-table-tools">
                <div class="ci-page-size">
                    <span>Show</span>
                    <select id="ciPageSize" class="form-control form-control-sm">
                        <option value="20">20</option>
                        <option value="35">35</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>entries</span>
                </div>

                <input type="text"
                       id="ciSearch"
                       class="form-control form-control-sm ci-search"
                       placeholder="@searchPlaceholder" />
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover"
                       id="ciTable">
                    
<thead>
    <tr>
        <th class="ci-control-column">Select</th>
        <th class="ci-action-column">Action</th>

        @foreach (var column in columns)
        {
            var header = column?["header"]?.ToString() ?? "";
            var tooltip = column?["tooltip"]?.ToString();

            <th>
                @header

                @if (!string.IsNullOrWhiteSpace(tooltip))
                {
                    <i class="fas fa-info-circle ml-1 text-primary"
                       title="@tooltip"
                       style="cursor: help;"></i>
                }
            </th>
        }
    </tr>
</thead>

<tbody id="ciTableBody">
    @if (timesheets.Count > 0)
    {
        foreach (var item in timesheets)
        {
            var id = item["id"]?.ToString() ?? "";

            <tr data-id="@id">

                <!-- Select checkbox -->
                <td class="text-center ci-control-column">
                    <input type="checkbox"
                           class="ci-checkbox"
                           value="@id" />
                </td>

                <!-- Row actions -->
                <td class="text-center ci-action-column">
                    <button type="button"
                            class="ci-row-edit"
                            title="Edit">
                        <i class="fas fa-edit"></i>
                    </button>

                    <button type="button"
                            class="ci-row-delete"
                            title="Delete">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </td>

                <!-- Generate record values using JSON configuration -->
                @foreach (var column in columns)
                {
                    var fieldName = column?["field"]?.ToString() ?? "";

                    var fallbackField =
                        column?["fallbackField"]?.ToString();

                    var displayType =
                        column?["displayType"]?.ToString();

                    var value = item[fieldName]?.ToString() ?? "";

                    if (string.IsNullOrWhiteSpace(value) &&
                        !string.IsNullOrWhiteSpace(fallbackField))
                    {
                        value = item[fallbackField]?.ToString() ?? "";
                    }

                    <td>
                        @if (displayType == "active")
                        {
                            bool isActive =
                                value == "1" ||
                                value.Equals("true",
                                    StringComparison.OrdinalIgnoreCase) ||
                                value.Equals("active",
                                    StringComparison.OrdinalIgnoreCase);

                            if (isActive)
                            {
                                <span class="badge badge-success">Y</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">N</span>
                            }
                        }
                        else if (displayType == "approval")
                        {
                            var approvalLabel = value switch
                            {
                                "1" => "Y",
                                "2" => "N",
                                _ => "P"
                            };

                            if (approvalLabel == "Y")
                            {
                                <span class="badge badge-success">
                                    Y
                                </span>
                            }
                            else if (approvalLabel == "N")
                            {
                                <span class="badge badge-danger">
                                    N
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-warning">
                                    P
                                </span>
                            }
                        }
                        else
                        {
                            @value
                        }
                    </td>
                }
            </tr>
        }
    }
    else
    {
        <tr class="ci-no-data">
            <td colspan="@(columns.Count + 2)" class="ci-empty">
                No timesheet records found.
            </td>
        </tr>
    }
</tbody>

                </table>
            </div>

            <div class="ci-empty ci-filter-empty" id="ciFilterEmpty" hidden>
                No matching timesheet records found.
            </div>

            <div class="ci-table-footer">
                <span id="ciShowing">Showing 0 records</span>

                <div class="ci-pagination">
                    <button class="btn btn-light btn-sm"
                            id="ciPrevious" type="button">
                        Previous
                    </button>

                    <span id="ciPageInfo">0 / 0</span>

                    <button class="btn btn-light btn-sm"
                            id="ciNext" type="button">
                        Next
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    html {
        font-size: 14px;
    }

    .candidate-index {
        width: 100%;
        padding: 18px 0 25px;
        color: #5a5c69;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 13px;
    }

    .candidate-index .ci-card {
        border: 1px solid #e1e6ed;
        border-radius: 6px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(58,59,69,.14) !important;
        overflow: hidden;
    }

    .ci-toolbar-card {
        margin-bottom: 20px;
    }

    .ci-toolbar,
    .ci-records-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        padding: 14px 18px;
        background: #eef0f3;
        border: 0;
        border-bottom: 1px solid #e1e6ed;
    }

    .ci-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: #5a5c69;
        font-size: .85rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .ci-title i,
    .ci-records-header i {
        color: #4e73df;
    }

    .ci-module-badge {
        padding: 3px 7px;
        border: 1px solid #ccd3db;
        border-radius: 4px;
        background: #e5e9ee;
        color: #4b5563;
        font-size: .68rem;
        letter-spacing: normal;
    }

    .ci-buttons {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

    .ci-buttons .btn {
        padding: 5px 9px;
        border-radius: 4px;
        font-size: .8rem;
        font-weight: 700;
        box-shadow: 0 .1rem .3rem rgba(0,0,0,.08);
    }

    .ci-buttons .btn i {
        margin-right: 4px;
    }

    .ci-summary {
        margin-bottom: 8px;
    }

    .ci-summary > div {
        margin-bottom: 16px;
    }

    .ci-summary-card {
        min-height: 78px;
    }

    .ci-summary-card .card-body {
        position: relative;
        padding: 15px 16px;
    }

    .ci-summary-label {
        margin-bottom: 4px;
        color: #4e73df;
        font-size: .7rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .ci-summary-value,
    .ci-summary-module {
        color: #5a5c69;
        font-size: 1.05rem;
        font-weight: 800;
    }

    #ciSelected {
        font-size: .9rem;
    }

    .ci-summary-icon {
        position: absolute;
        top: 22px;
        right: 16px;
        color: #dddfeb;
        font-size: 1.5rem;
    }

    .ci-border-primary {
        border-left: 4px solid #4e73df !important;
    }

    .ci-border-warning {
        border-left: 4px solid #f6c23e !important;
    }

    .ci-border-success {
        border-left: 4px solid #1cc88a !important;
    }

    .ci-border-info {
        border-left: 4px solid #36b9cc !important;
    }

    .ci-summary .ci-border-primary .ci-summary-label {
        color: #4e73df !important;
    }

    .ci-summary .ci-border-warning .ci-summary-label {
        color: #f6c23e !important;
    }

    .ci-summary .ci-border-success .ci-summary-label {
        color: #1cc88a !important;
    }

    .ci-summary .ci-border-info .ci-summary-label {
        color: #36b9cc !important;
    }

    .ci-records-card {
        margin-bottom: 20px;
    }

    .ci-records-header h6 {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: #4e73df;
        font-size: .9rem;
        font-weight: 800;
    }

    .ci-records-header .badge {
        padding: 5px 8px;
        font-size: .7rem;
    }

    .ci-records-card .card-body {
        padding: 16px;
    }

    .ci-table-tools {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 14px;
    }

    .ci-page-size {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-page-size select {
        width: 60px;
    }

    .ci-search {
        width: 320px;
        max-width: 100%;
    }

    .candidate-index .form-control {
        min-height: 32px;
        border: 1px solid #d2d0cb;
        border-radius: 5px;
        color: #5a5c69;
        font-family: inherit;
        font-size: .83rem;
        box-shadow: none;
    }

    .candidate-index .form-control:focus {
        border-color: #7d9fe5;
        box-shadow: 0 0 0 .18rem rgba(78,115,223,.14);
    }

    #ciTable {
        width: 100%;
        margin-bottom: 0;
        white-space: nowrap;
    }

    #ciTable thead th {
        padding: 10px 8px;
        background: #4e73df;
        color: #fff;
        border-color: #3d5cbe;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        vertical-align: middle;
    }

    #ciTable tbody td {
        padding: 8px;
        color: #5a5c69;
        font-size: .8rem;
        vertical-align: middle;
    }

    #ciTable tbody tr:hover {
        background-color: #f3f6ff;
    }

    .ci-row-edit,
    .ci-row-delete {
        border: none;
        background: transparent;
        padding: 4px 7px;
        cursor: pointer;
        font-size: .9rem;
    }

    .ci-row-edit {
        color: #4e73df;
    }

    .ci-row-delete {
        color: #e74a3b;
    }

    .ci-row-edit:hover,
    .ci-row-delete:hover {
        opacity: .7;
    }

    .ci-checkbox {
        width: 16px;
        height: 16px;
        cursor: pointer;
    }

    .ci-action-column {
        text-align: center;
        min-width: 85px;
    }

    #ciTable tbody tr.selected {
        background-color: #eaecf4;
    }

    .ci-empty {
        padding: 24px !important;
        color: #858796;
        text-align: center !important;
    }

    .ci-table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding-top: 14px;
        color: #858796;
        font-size: .8rem;
    }

    .ci-pagination {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ci-pagination .btn {
        border: 1px solid #e3e6f0;
        background: #fff;
        color: #5a5c69;
    }

    .ci-pagination .btn:disabled {
        opacity: .45;
        cursor: not-allowed;
    }

    @@media (max-width: 768px) {
        .ci-toolbar {
            align-items: flex-start;
        }

        .ci-buttons {
            width: 100%;
        }

        .ci-search {
            width: 100%;
        }
    }

    @@media print {
        .ci-buttons,
        .ci-table-tools,
        .ci-table-footer,
        .ci-control-column,
        .ci-action-column {
            display: none !important;
        }

        .candidate-index .ci-card {
            box-shadow: none !important;
        }
    }
</style>

<script>
    (() => {
        const body = document.getElementById("ciTableBody");
        const searchInput = document.getElementById("ciSearch");
        const pageSizeInput = document.getElementById("ciPageSize");

        const rows = Array.from(
            body.querySelectorAll("tr[data-id]")
        );

        let selectedTimesheetId = null;
        let filteredRows = rows.slice();
        let currentPage = 1;

        function updateSelectedTimesheets() {
            const selectedCheckboxes = body.querySelectorAll(
                ".ci-checkbox:checked"
            );

            const names = Array.from(selectedCheckboxes).map(checkbox =>
                checkbox.closest("tr").cells[2]?.textContent.trim()
            );

            body.querySelectorAll("tr[data-id]").forEach(row => {
                const checkbox = row.querySelector(".ci-checkbox");
                row.classList.toggle("selected", checkbox?.checked);
            });

            selectedTimesheetId = selectedCheckboxes.length === 1
                ? selectedCheckboxes[0].value
                : null;

            document.getElementById("ciSelected").textContent =
                names.length ? names.join(", ") : "None";
        }

        function renderRows() {
            const pageSize = Number(pageSizeInput.value);
            const totalPages = Math.max(
                1,
                Math.ceil(filteredRows.length / pageSize)
            );

            currentPage = Math.min(currentPage, totalPages);

            rows.forEach(row => row.hidden = true);

            const start = (currentPage - 1) * pageSize;
            const visibleRows = filteredRows.slice(start, start + pageSize);

            visibleRows.forEach(row => {
                row.hidden = false;
            });

            document.getElementById("ciDisplayed").textContent =
                filteredRows.length;

            document.getElementById("ciRecordCount").textContent =
                `${filteredRows.length} ${filteredRows.length === 1 ? "Record" : "Records"}`;

            document.getElementById("ciShowing").textContent =
                filteredRows.length
                    ? `Showing ${start + 1} to ${start + visibleRows.length} of ${filteredRows.length} timesheets`
                    : "Showing 0 timesheets";

            document.getElementById("ciPageInfo").textContent =
                filteredRows.length
                    ? `${currentPage} / ${totalPages}`
                    : "0 / 0";

            document.getElementById("ciFilterEmpty").hidden =
                filteredRows.length !== 0;

            document.getElementById("ciPrevious").disabled =
                currentPage <= 1;

            document.getElementById("ciNext").disabled =
                currentPage >= totalPages;
        }

        function filterRows() {
            const query = searchInput.value.trim().toLowerCase();

            filteredRows = rows.filter(row =>
                (row.dataset.search || row.innerText)
                    .toLowerCase()
                    .includes(query)
            );

            updateSelectedTimesheets();
            currentPage = 1;
            renderRows();
        }

        rows.forEach(row => {
            row.addEventListener("click", event => {
                if (event.target.closest(
                    ".ci-row-edit, .ci-row-delete, .ci-checkbox"
                )) {
                    return;
                }

                const checkbox = row.querySelector(".ci-checkbox");

                if (checkbox) {
                    checkbox.checked = !checkbox.checked;
                    updateSelectedTimesheets();
                }
            });

            const checkbox = row.querySelector(".ci-checkbox");

            checkbox?.addEventListener("change", () => {
                updateSelectedTimesheets();
            });
        });

        // Edit selected timesheet
        function editTimesheet(id) {
            if (!id) {
                alert("Please select a timesheet.");
                return;
            }

            window.location.href =
                "/Master/Timesheet?id=" + encodeURIComponent(id);
        }

        // Delete selected timesheet
        async function deleteTimesheet(id) {
            if (!id) {
                alert("Please select a timesheet.");
                return;
            }

            if (!confirm("Are you sure you want to delete this timesheet?")) {
                return;
            }

            try {
                const response = await fetch(
                    "/Master/Timesheet/Delete/" + encodeURIComponent(id),
                    {
                        method: "GET"
                    }
                );

                if (!response.ok) {
                    throw new Error("Delete request failed.");
                }

                window.location.reload();
            }
            catch (error) {
                alert("Unable to delete the timesheet. Please check the Delete action in TimesheetController.");
                console.error(error);
            }
        }

        // Toolbar Edit
        document.getElementById("ciEdit").addEventListener("click", () => {
            editTimesheet(selectedTimesheetId);
        });

        // Toolbar Delete
        document.getElementById("ciDelete").addEventListener("click", () => {
            deleteTimesheet(selectedTimesheetId);
        });

        // Individual row Edit and Delete
        body.addEventListener("click", event => {
            const editButton = event.target.closest(".ci-row-edit");
            const deleteButton = event.target.closest(".ci-row-delete");

            if (!editButton && !deleteButton) {
                return;
            }

            const row = event.target.closest("tr[data-id]");

            if (!row) {
                return;
            }

            if (editButton) {
                editTimesheet(row.dataset.id);
            }

            if (deleteButton) {
                deleteTimesheet(row.dataset.id);
            }
        });

        // Search
        searchInput.addEventListener("input", filterRows);

        // Page size
        pageSizeInput.addEventListener("change", () => {
            currentPage = 1;
            renderRows();
        });

        // Previous page
        document.getElementById("ciPrevious").addEventListener("click", () => {
            if (currentPage > 1) {
                currentPage--;
                renderRows();
            }
        });

        // Next page
        document.getElementById("ciNext").addEventListener("click", () => {
            const totalPages = Math.max(
                1,
                Math.ceil(filteredRows.length / Number(pageSizeInput.value))
            );

            if (currentPage < totalPages) {
                currentPage++;
                renderRows();
            }
        });

        // Print
        document.getElementById("ciPrint").addEventListener("click", () => {
            window.print();
        });

        // Close
        document.getElementById("ciClose").addEventListener("click", () => {
            window.location.href = "/Home/Index";
        });

        // Other toolbar actions are not connected to backend actions yet.
        document.getElementById("ciSave").addEventListener("click", () => {
            alert("Save action is not connected yet.");
        });

        document.getElementById("ciClone").addEventListener("click", () => {
            alert("Clone action is not connected yet.");
        });

        document.getElementById("ciUnPost").addEventListener("click", () => {
            alert("UnPost action is not connected yet.");
        });

        document.getElementById("ciApprove").addEventListener("click", () => {
            alert("Approve action is not connected yet.");
        });

        document.getElementById("ciReject").addEventListener("click", () => {
            alert("Reject action is not connected yet.");
        });

        document.getElementById("ciAuthTracker").addEventListener("click", () => {
            alert("Auth Tracker action is not connected yet.");
        });

        renderRows();
    })();
</script>
