<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Project Master</title>

    <!-- Bootstrap 4 -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.12.0/css/jquery.dataTables.min.css"/>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"/>

    <style>
        html { font-size: 14px; }

        /* ── Loading Overlay ── */
        #loading {
            display: none;
            position: fixed;
            left: 0; top: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.08);
            z-index: 9999;
        }
        #loadingcontent {
            display: table;
            position: fixed;
            left: 0; top: 0;
            width: 100%; height: 100%;
        }
        #loadingspinner {
            display: table-cell;
            vertical-align: middle;
            text-align: center;
            font-size: 1.1rem;
        }
        #loadingspinner::after {
            content: '';
            display: inline-block;
            width: 48px; height: 48px;
            border: 5px solid #e3e6f0;
            border-top-color: #4e73df;
            border-radius: 50%;
            animation: spin 0.75s linear infinite;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* ── Page Title Bar ── */
        .page-title-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
        }
        .page-title-bar .page-title-text {
            font-size: 0.85rem;
            font-weight: 800;
            color: #5a5c69;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .page-title-bar .page-title-text i { color: #4e73df; }
        .page-title-bar .btn-group-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        /* ── Table Enhancements ── */
        #tblProject thead th {
            background-color: #4e73df;
            color: #fff;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            border-color: #3d5cbe;
            vertical-align: middle;
        }
        #tblProject tbody tr:hover { background-color: #f0f3ff; }
        #tblProject td {
            font-size: 0.82rem;
            color: #5a5c69;
            vertical-align: middle;
        }
        .action-btns a { margin: 0 3px; transition: opacity 0.15s; }
        .action-btns a:hover { opacity: 0.7; }
        .action-btns .fa-edit      { color: #4e73df; }
        .action-btns .fa-trash-alt { color: #e74a3b; }

        /* ── Modal Header ── */
        .modal-header-primary {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            border-bottom: none;
            padding: 14px 20px;
        }
        .modal-header-primary .modal-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .modal-header-primary .close-modal-btn {
            color: rgba(255,255,255,0.8);
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            line-height: 1;
            transition: color 0.15s;
        }
        .modal-header-primary .close-modal-btn:hover { color: #fff; }
        .modal-footer-primary {
            background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
            padding: 8px 20px;
            border-top: none;
        }

        /* ── Form Labels ── */
        .form-label {
            font-size: 0.78rem;
            font-weight: 700;
            color: #5a5c69;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 4px;
        }
        .form-control {
            font-size: 0.85rem;
            border-color: #d1d3e2;
            color: #6e707e;
            border-radius: 0.35rem;
        }
        .form-control:focus {
            border-color: #bac8f3;
            box-shadow: 0 0 0 0.2rem rgba(78,115,223,0.2);
        }

        /* ── Stat Cards ── */
        .border-left-primary { border-left: 0.25rem solid #4e73df !important; }
        .border-left-success { border-left: 0.25rem solid #1cc88a !important; }
        .border-left-info    { border-left: 0.25rem solid #36b9cc !important; }
        .border-left-warning { border-left: 0.25rem solid #f6c23e !important; }

        /* ── Badge fix ── */
        .badge-primary { background-color: #4e73df; }
        .text-gray-800 { color: #5a5c69 !important; }
        .text-gray-300 { color: #dddfeb !important; }
    </style>
</head>
