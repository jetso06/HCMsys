<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.12.0/js/jquery.dataTables.min.js"></script>

<script>
    var LoginId = "1";  // Dummy login user ID

    // ── Dummy auto-code counter (simulates server getCode) ──
    var dummyCodeCounter = 8;
    function generateCode() {
        return 'PRJ-' + String(dummyCodeCounter).padStart(4, '0');
    }

    $(document).ready(function () {

        LoginId = $("#userid").val();

        // ── Init DataTable ──
        var table = $('#tblProject').DataTable({
            order: [[1, 'desc']],
            pageLength: 15,
            language: {
                search: "",
                searchPlaceholder: "Search projects...",
                lengthMenu: "Show _MENU_ entries",
                info: "Showing _START_ to _END_ of _TOTAL_ projects",
                emptyTable: "No project records found"
            },
            columnDefs: [
                { orderable: false, targets: 0 }
            ]
        });

        // ── Update stat cards ──
        var totalRows = table.rows().count();
        $('#stat-total').text(totalRows);
        $('#stat-active').text(totalRows);
        $('#record-count-badge').text(totalRows + ' Records');

        // Last modified from first visible row
        var firstNode = table.row(0).node();
        if (firstNode) {
            var lastMod = $(firstNode).find('td').eq(7).text().trim();
            $('#stat-modified').text(lastMod || 'N/A');
        }

        // ── Generate first code on load ──
        getNo();
    });

    /* ── Generate dummy code ── */
    function getNo() {
        $('#loading').fadeIn();
        setTimeout(function () {
            $('#code-field').val(generateCode());
            $('#loading').fadeOut();
        }, 300);
    }

    /* ── Clear form fields ── */
    function clearFields() {
        $('#code-field').val('');
        $('#name-field').val('');
        $('#arabic-field').val('');
        $('#id-field').val(0);
        $('#add-btn').html('<i class="fas fa-plus mr-1"></i> Add');
        $('#Project-modal-label').html('<i class="fas fa-project-diagram mr-2"></i>Add New Project');
        $('#code-field').prop('disabled', false);
    }

    function clearFieldsWithModal() {
        clearFields();
        getNo();
    }

    /* ── Edit row ── */
    $(document).on('click', 'a.edit-item-btn', function (e) {
        e.preventDefault();
        var row = $(this).closest('tr');
        clearFields();

        $('#add-btn').html('<i class="fas fa-sync-alt mr-1"></i> Update');
        $('#Project-modal-label').html('<i class="fas fa-edit mr-2"></i>Update Project');

        var id     = row.find('td').eq(1).text().trim();
        var code   = row.find('td').eq(2).text().trim();
        var name   = row.find('td').eq(3).text().trim();
        var arabic = row.find('td').eq(8).text().trim();

        $('#id-field').val(id);
        $('#code-field').val(code).prop('disabled', true);
        $('#name-field').val(name);
        $('#arabic-field').val(arabic);

        return false;
    });

    /* ── Add / Update ── */
    $('#add-btn').click(function () {
        var code   = $('#code-field').val();
        var name   = $('#name-field').val().trim();
        var arabic = $('#arabic-field').val().trim();
        var id     = $('#id-field').val();
        var btnTxt = $(this).text().trim();

        if (!code) { showAlert('Code cannot be blank.', 'danger'); return false; }
        if (!name) { showAlert('Name cannot be blank.', 'danger'); return false; }

        $('#loading').fadeIn();

        setTimeout(function () {
            var table = $('#tblProject').DataTable();

            if (btnTxt === 'Update') {
                // ── Update existing row ──
                table.rows().every(function () {
                    var rowNode = this.node();
                    if ($(rowNode).find('td').eq(1).text().trim() === id) {
                        $(rowNode).find('td').eq(3).text(name);
                        $(rowNode).find('td').eq(8).text(arabic);
                        $(rowNode).find('td').eq(6).text('Admin');
                        $(rowNode).find('td').eq(7).text(getTodayStr());
                    }
                });
                table.draw();
                showAlert(code + ' - Project Updated Successfully', 'success');
            } else {
                // ── Add new row ──
                var today = getTodayStr();
                table.row.add([
                    '<td class="action-btns" style="text-align:center;">' +
                        '<a href="#" class="edit-item-btn" data-toggle="modal" data-target="#Project-modal" title="Edit"><i class="fas fa-edit fa-sm fa-fw"></i></a> ' +
                        '<a href="#" class="remove-item-btn" title="Delete"><i class="fas fa-trash-alt fa-sm fa-fw"></i></a>' +
                    '</td>',
                    dummyCodeCounter,
                    code,
                    name,
                    'Admin',
                    today,
                    '',
                    '',
                    arabic
                ]).draw();

                // Update stat cards
                var newTotal = table.rows().count();
                $('#stat-total').text(newTotal);
                $('#stat-active').text(newTotal);
                $('#record-count-badge').text(newTotal + ' Records');

                dummyCodeCounter++;
                showAlert(code + ' - Project Created Successfully', 'success');
            }

            $('#Project-modal').modal('hide');
            clearFields();
            getNo();
            $('#loading').fadeOut();
        }, 400);

        return false;
    });

    /* ── Delete row ── */
    $(document).on('click', 'a.remove-item-btn', function (e) {
        e.preventDefault();
        var row  = $(this).closest('tr');
        var code = row.find('td').eq(2).text().trim();

        if (!confirm('Are you sure you want to delete: ' + code + '?')) return false;

        $('#loading').fadeIn();
        setTimeout(function () {
            var table = $('#tblProject').DataTable();
            table.row(row).remove().draw();

            var newTotal = table.rows().count();
            $('#stat-total').text(newTotal);
            $('#stat-active').text(newTotal);
            $('#record-count-badge').text(newTotal + ' Records');

            showAlert(code + ' - Project Deleted Successfully', 'success');
            $('#loading').fadeOut();
        }, 300);

        return false;
    });

    /* ── Helpers ── */
    function getTodayStr() {
        var d = new Date();
        var dd = String(d.getDate()).padStart(2,'0');
        var mm = String(d.getMonth()+1).padStart(2,'0');
        var yyyy = d.getFullYear();
        return dd + '-' + mm + '-' + yyyy;
    }

    function showAlert(msg, type) {
        var colour = type === 'success' ? '#1cc88a' : '#e74a3b';
        var div = $('<div>')
            .css({
                position: 'fixed', bottom: '20px', right: '20px',
                background: colour, color: '#fff',
                padding: '10px 18px', borderRadius: '6px',
                fontWeight: '700', fontSize: '0.82rem',
                boxShadow: '0 4px 12px rgba(0,0,0,0.15)',
                zIndex: 9999, opacity: 0
            })
            .text(msg)
            .appendTo('body')
            .animate({ opacity: 1 }, 200)
            .delay(2200)
            .animate({ opacity: 0 }, 300, function () { $(this).remove(); });
    }
</script>
</body>
</html>