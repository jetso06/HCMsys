   USER INFO JSON CONFIGURATION
========================================================= */

function loadUserInfoConfig() {

    fetch('/data/Users/user-info.json')
        .then(response => {

            if (!response.ok) {
                throw new Error('Unable to load user-info.json');
            }

            return response.json();
        })
        .then(config => {

            var container = $('#panel-userinfo .card-body');

            container.empty();

            var row = $('<div class="row"></div>');

            config.fields.forEach(function (field) {

                var colClass = 'col-md-4 mb-3';

                // Address and Comments use full width
                if (field.name === 'address' || field.name === 'comments') {
                    colClass = 'col-md-12 mb-3';
                }

                var wrapper = $('<div class="' + colClass + '"></div>');

                /* ==========================
                   CHECKBOX
                ========================== */

                if (field.type === 'checkbox') {

                    wrapper.append(
                        $('<div class="active-check"></div>')
                            .append(
                                $('<input>', {
                                    type: 'checkbox',
                                    id: field.name,
                                    checked: true
                                })
                            )
                            .append(
                                $('<label>', {
                                    for: field.name,
                                    text: field.label
                                })
                            )
                    );

                }

                /* ==========================
                   DROPDOWN
                ========================== */

                else if (field.type === 'dropdown') {

                    var label = $('<label class="form-label"></label>')
                        .text(field.label);

                    var select = $('<select>', {
                        id: field.name,
                        class: 'custom-select'
                    });

                    select.append(
                        $('<option>', {
                            value: '',
                            text: 'Select ' + field.label
                        })
                    );

                    if (Array.isArray(field.options)) {

                        field.options.forEach(function (option) {

                            if (typeof option === 'object') {

                                select.append(
                                    $('<option>', {
                                        value: option.value,
                                        text: option.label
                                    })
                                );

                            } else {

                                select.append(
                                    $('<option>', {
                                        value: option,
                                        text: option
                                    })
                                );

                            }

                        });

                    }

                    wrapper.append(label);
                    wrapper.append(select);

                }

                /* ==========================
                   TEXTAREA
                ========================== */

                else if (
                    field.name === 'address' ||
                    field.name === 'comments'
                ) {

                    var label = $('<label class="form-label"></label>')
                        .text(field.label);

                    var textarea = $('<textarea>', {
                        id: field.name,
                        class: 'form-control',
                        placeholder: 'Enter ' + field.label.toLowerCase()
                    });

                    wrapper.append(label);
                    wrapper.append(textarea);

                }

                /* ==========================
                   NORMAL INPUT
                ========================== */

                else {

                    var label = $('<label class="form-label"></label>')
                        .text(field.label);

                    var inputType = 'text';

                    if (field.name === 'emailId') {
                        inputType = 'email';
                    }

                    if (
                        field.name === 'password' ||
                        field.name === 'confirmPassword'
                    ) {
                        inputType = 'password';
                    }

                    var input = $('<input>', {
                        type: inputType,
                        id: field.name,
                        class: 'form-control',
                        placeholder: 'Enter ' + field.label.toLowerCase()
                    });

                    // Numeric field
                    if (field.type === 'numeric' && field.digits) {

                        input.attr('maxlength', field.digits);
                        input.attr('inputmode', 'numeric');

                        input.on('input', function () {

                            this.value = this.value
                                .replace(/\D/g, '')
                                .slice(0, field.digits);

                        });

                    }

                    wrapper.append(label);
                    wrapper.append(input);

                }

                row.append(wrapper);

            });

            container.append(row);

            console.log(
                'User Info rendered from user-info.json'
            );

        })
        .catch(error => {

            console.error(
                'Error loading User Info configuration:',
                error
            );

        });
}


/* Load User Info configuration */
$(document).ready(function () {

    loadUserInfoConfig();

});
/* =========================================================
   ADDITIONAL INFO JSON CONFIGURATION
========================================================= */

function loadAdditionalInfoConfig() {

    fetch('/data/Users/additional-info.json')
        .then(response => {

            if (!response.ok) {
                throw new Error('Unable to load additional-info.json');
            }

            return response.json();
        })
        .then(config => {

            var container = $('#panel-additionalinfo .card-body');

            container.empty();

            var row = $('<div class="row"></div>');

            config.fields.forEach(function (field) {

                var wrapper = $('<div class="col-md-4 mb-3"></div>');


                /* ==========================
                   DROPDOWN
                ========================== */

                if (field.type === 'dropdown') {

                    var label = $('<label class="form-label"></label>')
                        .text(field.label);

                    var select = $('<select>', {
                        id: field.name,
                        class: 'custom-select'
                    });

                    select.append(
                        $('<option>', {
                            value: '',
                            text: 'Select ' + field.label
                        })
                    );

                    if (Array.isArray(field.options)) {

                        field.options.forEach(function (option) {

                            if (typeof option === 'object') {

                                select.append(
                                    $('<option>', {
                                        value: option.value,
                                        text: option.label
                                    })
                                );

                            } else {

                                select.append(
                                    $('<option>', {
                                        value: option,
                                        text: option
                                    })
                                );

                            }

                        });

                    }

                    wrapper.append(label);
                    wrapper.append(select);

                }


                /* ==========================
                   ATTACHMENT
                ========================== */

                else if (field.type === 'attachment') {

                    var label = $('<label class="form-label"></label>')
                        .text(field.label);

                    var uploadBox = $('<div class="upload-box"></div>');

                    var input = $('<input>', {
                        type: 'file',
                        id: field.name,
                        class: 'form-control-file'
                    });

                    if (field.accept) {
                        input.attr('accept', field.accept);
                    }

                    uploadBox.append(input);

                    wrapper.append(label);
                    wrapper.append(uploadBox);

                }

                row.append(wrapper);

            });

            container.append(row);

            console.log(
                'Additional Info rendered from additional-info.json'
            );

        })
        .catch(error => {

            console.error(
                'Error loading Additional Info configuration:',
                error
            );

        });
}


/* Load Additional Info configuration */
$(document).ready(function () {

    loadAdditionalInfoConfig();

});

</script>