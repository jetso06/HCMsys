@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    html {
        font-size: 14px;
    }

    /* =========================================================
       PAGE
    ========================================================= */

    .user-page {
        width: 100%;
        max-width: none;
        padding: 18px 0 25px;
        margin: 0;
        box-sizing: border-box;
    }

    .user-page * {
        box-sizing: border-box;
    }

    .user-page > .card {
        width: 100%;
        max-width: none;
        border-radius: 6px;
        overflow: hidden;
    }

    /* Space between sections */
    .user-page > .card:not(:last-child) {
        margin-bottom: 40px !important;
    }

    /* =========================================================
       PAGE TITLE
    ========================================================= */

    .page-title-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
    }

    .page-title-text {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        margin: 0;
        font-size: 0.85rem;
        font-weight: 800;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .page-title-text i {
        color: #4e73df;
    }

    .btn-group-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .btn-group-actions .btn {
        font-size: .75rem;
    }

    /* =========================================================
       CARDS / SECTION HEADERS
    ========================================================= */

    .user-page .card {
        border: 1px solid #e1e6ed;
        background: #ffffff;
        border-radius: 6px;
        box-shadow: 0 4px 14px rgba(58, 59, 69, 0.14);
        overflow: hidden;
    }

    .user-page .card-header {
        background: #eef0f3;
        border-bottom: 1px solid #e1e6ed;
        padding: 14px 18px;
    }

    .user-page .card-header h6 {
        margin: 0;
        font-size: .8rem;
        font-weight: 800;
        color: #4e73df !important;
        text-transform: uppercase;
        letter-spacing: .05em;
        display: flex;
        align-items: center;
    }

    .user-page .card-header h6 i {
        color: #4e73df;
    }

    .user-page .card-body {
        background: #fff;
        padding: 16px;
    }

    /* =========================================================
       USER MASTER HEADER
    ========================================================= */

    .user-master-card {
        width: 100%;
        background: #ffffff !important;
        border: 1px solid #e3e6f0 !important;
        border-radius: 0.35rem;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(58, 59, 69, 0.14) !important;
        margin-bottom: 40px !important;
    }

        .user-master-card .card-header {
            background: #eef0f3 !important;
            border: none !important;
            border-bottom: 1px solid #e3e6f0 !important;
            padding: 14px 18px !important;
        }

    /* =========================================================
       FORM
    ========================================================= */

    .form-label {
        font-size: .76rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 4px;
    }

    .user-page .form-control,
    .user-page .custom-select {
        font-size: .82rem;
        border-color: #d1d3e2;
        color: #6e707e;
        border-radius: .35rem;
        min-height: 34px;
    }

    .user-page .form-control:focus,
    .user-page .custom-select:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 .2rem rgba(78,115,223,.2);
    }

    .user-page textarea.form-control {
        min-height: 70px;
        resize: vertical;
    }

    /* =========================================================
       ACTIVE CHECKBOX
    ========================================================= */

    .active-check {
        display: flex;
        align-items: center;
        height: 100%;
        padding-top: 18px;
    }

    .active-check input {
        margin-right: 7px;
        accent-color: #4e73df;
    }

    .active-check label {
        margin: 0;
        font-size: .76rem;
        font-weight: 700;
        color: #5a5c69;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    /* =========================================================
       TAB BAR
    ========================================================= */

    .user-tabs {
        display: flex;
        width: 100%;
        overflow-x: auto;
        border-bottom: 1px solid #dfe3eb;
        background: #fff;
        scrollbar-width: thin;
    }

    .user-tab {
        flex: 1 0 auto;
        min-width: 180px;
        padding: 11px 16px;
        border: 0;
        border-right: 1px solid #edf0f5;
        background: #f8f9fc;
        color: #858796;
        font-size: .76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        cursor: pointer;
        text-align: center;
        transition: all .15s ease;
    }

    .user-tab:hover {
        background: #eef2ff;
        color: #4e73df;
    }

    .user-tab.active {
        background: #4e73df;
        color: #fff;
        box-shadow: inset 0 -3px 0 #224abe;
    }

    .user-tab i {
        margin-right: 5px;
    }

    .user-panel {
        display: none;
    }

    .user-panel.active {
        display: block;
    }

    /* =========================================================
       ADDITIONAL INFO
    ========================================================= */

    .upload-box {
        border: 1px dashed #cbd3e3;
        border-radius: .35rem;
        padding: 14px;
        background: #f8f9fc;
    }

    .upload-box label {
        margin-bottom: 5px;
    }

    /* =========================================================
       RESTRICTIONS
    ========================================================= */

    .restriction-area {
        display: grid;
        grid-template-columns: 30% 70%;
        width: 100%;
        border: 1px solid #dfe3eb;
        border-radius: .4rem;
        overflow: hidden;
    }

    .restriction-master {
        background: #eef5ff;
        border-right: 1px solid #dfe3eb;
        min-height: 330px;
    }

    .restriction-employee {
        background: #fff;
        min-height: 330px;
    }

    .restriction-header {
        padding: 10px 12px;
        background: #eef0f3;
        border-bottom: 1px solid #dfe3eb;
        color: #4e73df;
        font-size: .76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .master-list {
        padding: 8px 0;
    }

    .master-item {
        padding: 9px 12px;
        color: #5a5c69;
        font-size: .78rem;
        border-bottom: 1px solid #e8edf5;
    }

    .master-item:last-child {
        border-bottom: 0;
    }

    .master-item.active {
        background: #4e73df;
        color: #fff;
        font-weight: 700;
    }

    .restriction-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 220px;
        align-items: center;
        gap: 15px;
        padding: 9px 12px;
        border-bottom: 1px solid #e8edf5;
    }

    .restriction-row:last-child {
        border-bottom: 0;
    }

    .restriction-name {
        font-size: .78rem;
        color: #5a5c69;
        font-weight: 600;
    }

    .restriction-row .custom-select {
        width: 100%;
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 991px) {

        .restriction-area {
            grid-template-columns: 35% 65%;
        }

        .restriction-row {
            grid-template-columns: 1fr;
            gap: 6px;
        }

    }

    @@media (max-width: 767px) {

        .user-page {
            padding-top: 12px;
        }

        .btn-group-actions {
            width: 100%;
        }

        .btn-group-actions .btn {
            flex: 1 1 auto;
        }

        .user-tab {
            min-width: 140px;
        }

        .restriction-area {
            grid-template-columns: 1fr;
        }

        .restriction-master {
            border-right: 0;
            border-bottom: 1px solid #dfe3eb;
            min-height: auto;
        }

        .restriction-employee {
            min-height: auto;
        }

    }

    @@media (max-width: 480px) {

        .user-page .card-body {
            padding: 10px;
        }

        .user-tab {
            min-width: 120px;
            padding: 9px 10px;
            font-size: .66rem;
        }

    }
</style>


